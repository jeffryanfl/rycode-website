---
import Layout from '../../layouts/Layout.astro';
import glossaryData from '../../data/glossary.json';

const categories = ['All', 'Sampling & Tokenization', 'Model Architecture', 'Hardware & Infrastructure', 'Agentic Systems', 'Training & Alignment', 'Risk & Ethics'];
const alphabet = ['All', '#', 'A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'K', 'L', 'M', 'N', 'O', 'P', 'Q', 'R', 'S', 'T', 'U', 'V', 'Z'];

// Helper to check parameter badges
function getParamBadge(termName: string) {
  const t = termName.toLowerCase();
  if (t.includes('temperature')) return { range: '[0.0 – 2.0]', def: '0.7', rec: '0.0 for Code, 0.8 for Creative' };
  if (t.includes('top-p') || t.includes('nucleus')) return { range: '[0.0 – 1.0]', def: '0.9', rec: '0.95 for Code' };
  if (t.includes('min-p')) return { range: '[0.0 – 1.0]', def: '0.05', rec: '0.05 filters low probability noise' };
  if (t.includes('top-k')) return { range: '[1 – 100]', def: '40', rec: '40 limits long-tail tokens' };
  if (t.includes('presence penalty')) return { range: '[-2.0 – 2.0]', def: '0.0', rec: '0.5 encourages new topics' };
  if (t.includes('frequency penalty')) return { range: '[-2.0 – 2.0]', def: '0.0', rec: '0.5 penalizes exact word repeats' };
  return null;
}
---

<Layout title="Glossary & Sampling Parameters — AI Concepts & Infrastructure">
  <div class="glitch-overlay"></div>
  <div class="viewport-matrix-container">
    <canvas id="networkCanvas"></canvas>
  </div>

  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-header">
        <a href="/ai" class="back-link">← Back to AI Concepts and Infrastructure</a>
        <p class="hero-eyebrow">MODULE 01 · COMPREHENSIVE KNOWLEDGE DIRECTORY</p>
        <h1 class="hero-title">AI Concepts & Sampling Parameters Glossary</h1>
        <p class="hero-tagline">
          89 structured terms, sampling parameters, architectural concepts, and hardware formulas extracted directly from core research spreadsheets.
        </p>
      </div>
    </div>
  </section>

  <!-- 1. Quick Reference Sampling Hyperparameter Cheat Sheet -->
  <section class="section cheat-section">
    <div class="container">
      <div class="cheat-panel">
        <div class="cheat-header">
          <span class="eyebrow-tag">QUICK REFERENCE GUIDE</span>
          <h2>Sampling Hyperparameter Cheat Sheet</h2>
          <p>Recommended parameter configurations for common LLM deployment tasks.</p>
        </div>

        <div class="cheat-grid">
          <div class="cheat-card">
            <span class="cheat-icon">💻</span>
            <h3>Code & Mathematics</h3>
            <div class="cheat-params">
              <span class="param-tag">Temp: <strong>0.0 – 0.2</strong></span>
              <span class="param-tag">Top-P: <strong>0.95</strong></span>
              <span class="param-tag">Min-P: <strong>0.05</strong></span>
            </div>
            <p>Deterministic output minimizing syntax errors and hallucinations.</p>
          </div>

          <div class="cheat-card highlight">
            <span class="cheat-icon">✍️</span>
            <h3>Creative & Storytelling</h3>
            <div class="cheat-params">
              <span class="param-tag">Temp: <strong>0.7 – 0.9</strong></span>
              <span class="param-tag">Top-P: <strong>0.90</strong></span>
              <span class="param-tag">Top-K: <strong>40</strong></span>
            </div>
            <p>High vocabulary diversity while filtering long-tail nonsensical tokens.</p>
          </div>

          <div class="cheat-card">
            <span class="cheat-icon">🤖</span>
            <h3>Agent Tool Calling</h3>
            <div class="cheat-params">
              <span class="param-tag">Temp: <strong>0.0</strong></span>
              <span class="param-tag">Presence: <strong>0.0</strong></span>
              <span class="param-tag">Freq: <strong>0.0</strong></span>
            </div>
            <p>Strict JSON schema compliance for deterministic function arguments.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Interactive VRAM Footprint & KV Cache Calculator -->
  <section class="section">
    <div class="container">
      <div class="calculator-panel">
        <div class="panel-header">
          <span class="eyebrow-tag">MATHEMATICAL FORMULA SIMULATOR</span>
          <h2>LLM VRAM Footprint & KV Cache Calculator</h2>
          <p>Estimate GPU VRAM memory requirements for inference based on model parameter count, precision, context length, and batch size.</p>
        </div>

        <div class="calc-grid">
          <div class="calc-inputs">
            <div class="input-group">
              <label for="calcParams">Model Size (Billion Parameters): <span id="calcParamsVal" class="val-num">70B</span></label>
              <input type="range" id="calcParams" min="7" max="1000" step="1" value="70" />
            </div>

            <div class="input-group">
              <label for="calcPrecision">Precision Quantization:</label>
              <select id="calcPrecision" class="calc-select">
                <option value="2">FP16 / BF16 (2 Bytes/param)</option>
                <option value="1" selected>FP8 / INT8 (1 Byte/param)</option>
                <option value="0.5">INT4 / AWQ (0.5 Bytes/param)</option>
              </select>
            </div>

            <div class="input-group">
              <label for="calcContext">Context Length: <span id="calcContextVal" class="val-num">128,000 tokens (128K)</span></label>
              <input type="range" id="calcContext" min="4" max="2000" step="4" value="128" />
            </div>

            <div class="input-group">
              <label for="calcBatch">Concurrent Batch Size: <span id="calcBatchVal" class="val-num">16 Requests</span></label>
              <input type="range" id="calcBatch" min="1" max="128" step="1" value="16" />
            </div>
          </div>

          <div class="calc-results">
            <div class="res-card">
              <span class="res-label">MODEL WEIGHT MEMORY</span>
              <span class="res-val" id="resWeights">70.0 GB</span>
              <span class="res-sub">Base GPU memory for loaded weights</span>
            </div>

            <div class="res-card">
              <span class="res-label">KV CACHE MEMORY</span>
              <span class="res-val highlight" id="resKv">25.6 GB</span>
              <span class="res-sub">Attention context state VRAM</span>
            </div>

            <div class="res-card total">
              <span class="res-label">MINIMUM VRAM REQUIRED</span>
              <span class="res-val total-val" id="resTotalVram">114.7 GB</span>
              <span class="res-sub">Requires 2x H100 80GB GPUs</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Navigation Controls: View Switcher, Search Bar, A–Z Bar -->
  <section class="section">
    <div class="container">
      <div class="nav-controls-box">
        <!-- Search Input -->
        <div class="search-input-wrapper">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="glossarySearch" placeholder="Search 89 terms, formulas, or concepts (e.g. Temperature, Top-P, KV Cache, MoE)..." />
        </div>

        <!-- View Switcher & Counter -->
        <div class="view-switcher-bar">
          <div class="view-toggle">
            <button id="viewCardsBtn" class="view-btn active">🃏 Visual Cards View</button>
            <button id="viewTableBtn" class="view-btn">📋 Compact Table View</button>
          </div>
          <div class="term-count-bar">
            Showing <span id="visibleCount">{glossaryData.length}</span> of {glossaryData.length} terms
          </div>
        </div>

        <!-- Category Pills -->
        <div class="filter-pills">
          {categories.map((cat) => (
            <button class={`pill-btn ${cat === 'All' ? 'active' : ''}`} data-category={cat}>{cat}</button>
          ))}
        </div>

        <!-- A-Z Alphabetical Jump Bar -->
        <div class="az-bar">
          {alphabet.map((letter) => (
            <button class={`az-btn ${letter === 'All' ? 'active' : ''}`} data-letter={letter}>{letter}</button>
          ))}
        </div>
      </div>

      <!-- Mode 1: Cards View Grid -->
      <div class="glossary-grid" id="glossaryGrid">
        {glossaryData.map((item, idx) => {
          const badge = getParamBadge(item.term);
          return (
            <div class="term-card" data-term={item.term.toLowerCase()} data-first={item.term.charAt(0).toUpperCase()} data-cat={item.category} data-idx={idx}>
              <div class="term-header">
                <span class="term-category-badge">{item.category}</span>
                <h3 class="term-title">{item.term}</h3>
              </div>

              <!-- Parameter Rule Badge if applicable -->
              {badge && (
                <div class="param-badge-box">
                  <span>Range: <strong>{badge.range}</strong></span>
                  <span>Default: <strong>{badge.def}</strong></span>
                  <span class="rec">Rec: {badge.rec}</span>
                </div>
              )}

              <p class="term-def">{item.definition}</p>

              <!-- Accordion Toggle Button -->
              {(item.technicalDetails || item.tradeoffs || item.related) && (
                <button class="accordion-toggle-btn">
                  <span>Show Technical Formulas & Details</span>
                  <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
              )}

              <div class="accordion-body">
                {item.technicalDetails && (
                  <div class="term-expand-details">
                    <span class="detail-label">TECHNICAL DETAILS & FORMULAS</span>
                    <p class="detail-text">{item.technicalDetails}</p>
                  </div>
                )}

                {item.tradeoffs && (
                  <div class="term-tradeoffs">
                    <span class="detail-label">TRADE-OFFS & IMPLICATIONS</span>
                    <p class="detail-text">{item.tradeoffs}</p>
                  </div>
                )}

                {item.related && (
                  <div class="term-related">
                    <span class="detail-label">RELATED TERMS</span>
                    <span class="related-tag">{item.related}</span>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Mode 2: Compact High-Density Table View (Hidden by default) -->
      <div class="table-card-wrapper" id="glossaryTableWrapper" style="display: none;">
        <table class="compact-table">
          <thead>
            <tr>
              <th>Term</th>
              <th>Category</th>
              <th>Quick Definition</th>
              <th>Parameter Rules</th>
            </tr>
          </thead>
          <tbody>
            {glossaryData.map((item, idx) => {
              const badge = getParamBadge(item.term);
              return (
                <tr class="compact-row" data-term={item.term.toLowerCase()} data-first={item.term.charAt(0).toUpperCase()} data-cat={item.category} data-idx={idx}>
                  <td><strong class="row-term">{item.term}</strong></td>
                  <td><span class="term-category-badge">{item.category}</span></td>
                  <td class="row-def">{item.definition}</td>
                  <td>{badge ? <span class="row-param-badge">{badge.range} (Def: {badge.def})</span> : '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <style>
    .back-link { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; color: #2563eb; text-decoration: none; display: inline-block; margin-bottom: 0.5rem; }
    .eyebrow-tag { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--gold-hot); letter-spacing: 0.1em; display: block; margin-bottom: 0.2rem; }
    
    .section { padding: 1rem 0; }

    /* Cheat Sheet Panel */
    .cheat-panel { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 16px; padding: 1.25rem 1.5rem; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04); margin-bottom: 1.25rem; }
    .cheat-header h2 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: var(--text); margin: 0 0 0.15rem 0; }
    .cheat-header p { color: var(--text-muted); font-size: 0.88rem; margin: 0 0 1rem 0; }
    
    .cheat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 850px) { .cheat-grid { grid-template-columns: 1fr; } }
    .cheat-card { background: rgba(15, 23, 42, 0.03); border-radius: 12px; padding: 1rem; display: flex; flex-direction: column; gap: 0.35rem; border: 1px solid rgba(15, 23, 42, 0.06); }
    .cheat-card.highlight { background: rgba(37, 99, 235, 0.04); border-color: rgba(37, 99, 235, 0.2); }
    .cheat-icon { font-size: 1.25rem; }
    .cheat-card h3 { font-family: var(--font-display); font-size: 0.98rem; font-weight: 700; color: var(--text); margin: 0; }
    .cheat-params { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    .param-tag { font-family: var(--font-mono); font-size: 0.7rem; color: #2563eb; background: rgba(37, 99, 235, 0.08); padding: 0.1rem 0.4rem; border-radius: 4px; }
    .cheat-card p { font-size: 0.8rem; color: var(--text-muted); line-height: 1.35; margin: 0; }

    /* Calculator Panel */
    .calculator-panel { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 16px; padding: 1.25rem 1.5rem; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04); margin-bottom: 1.25rem; }
    .panel-header h2 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: var(--text); margin: 0 0 0.15rem 0; }
    .panel-header p { color: var(--text-muted); font-size: 0.88rem; margin: 0 0 1rem 0; }
    .calc-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 1.75rem; align-items: center; }
    @media (max-width: 850px) { .calc-grid { grid-template-columns: 1fr; gap: 1.25rem; } }
    .input-group { margin-bottom: 0.85rem; }
    .input-group label { font-size: 0.85rem; font-weight: 600; color: var(--text); display: flex; justify-content: space-between; margin-bottom: 0.25rem; }
    .val-num { font-family: var(--font-mono); color: #2563eb; font-weight: 700; }
    .input-group input[type="range"] { width: 100%; accent-color: #2563eb; }
    .calc-select { width: 100%; padding: 0.45rem 0.6rem; border-radius: 8px; border: 1px solid rgba(15, 23, 42, 0.15); font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600; background: white; }

    .calc-results { display: flex; flex-direction: column; gap: 0.65rem; }
    .res-card { background: rgba(15, 23, 42, 0.03); border-radius: 10px; padding: 0.85rem 1rem; }
    .res-card.total { background: rgba(37, 99, 235, 0.06); border: 1px solid rgba(37, 99, 235, 0.2); }
    .res-label { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-faint); }
    .res-val { font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: var(--text); margin: 0.1rem 0; }
    .res-val.highlight { color: #2563eb; }
    .res-val.total-val { color: #2563eb; font-size: 1.55rem; }
    .res-sub { font-size: 0.78rem; color: var(--text-muted); }

    /* Navigation Controls Box */
    .nav-controls-box { display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 1.25rem; }
    .search-input-wrapper { position: relative; width: 100%; }
    .search-icon { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: #64748b; }
    .search-input-wrapper input { width: 100%; padding: 0.75rem 1rem 0.75rem 2.85rem; border-radius: 12px; border: 1px solid rgba(15, 23, 42, 0.12); font-family: var(--font-sans); font-size: 0.92rem; background: rgba(255, 255, 255, 0.9); box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03); transition: border-color 0.2s var(--ease); }
    .search-input-wrapper input:focus { outline: none; border-color: #2563eb; }

    .view-switcher-bar { display: flex; justify-content: space-between; align-items: center; }
    @media (max-width: 650px) { .view-switcher-bar { flex-direction: column; align-items: flex-start; gap: 0.5rem; } }
    .view-toggle { display: flex; gap: 0.35rem; background: rgba(15, 23, 42, 0.05); padding: 0.2rem; border-radius: 8px; }
    .view-btn { border: none; background: none; padding: 0.35rem 0.7rem; border-radius: 6px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--text-muted); cursor: pointer; transition: all 0.2s var(--ease); }
    .view-btn.active { background: white; color: #2563eb; box-shadow: 0 2px 6px rgba(0,0,0,0.06); }

    .term-count-bar { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-faint); font-weight: 600; }
    .term-count-bar span { color: #2563eb; font-weight: 700; }

    .filter-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .pill-btn { background: rgba(15, 23, 42, 0.05); border: 1px solid rgba(15, 23, 42, 0.08); padding: 0.35rem 0.8rem; border-radius: 16px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--text-muted); cursor: pointer; transition: all 0.2s var(--ease); }
    .pill-btn:hover { background: rgba(37, 99, 235, 0.1); color: #2563eb; }
    .pill-btn.active { background: #2563eb; color: white; border-color: #2563eb; }

    /* A-Z Jump Bar */
    .az-bar { display: flex; flex-wrap: wrap; gap: 0.2rem; background: rgba(255, 255, 255, 0.6); padding: 0.35rem 0.6rem; border-radius: 10px; border: 1px solid rgba(15, 23, 42, 0.06); }
    .az-btn { border: none; background: none; padding: 0.15rem 0.35rem; border-radius: 4px; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--text-muted); cursor: pointer; }
    .az-btn:hover { color: #2563eb; background: rgba(37, 99, 235, 0.08); }
    .az-btn.active { background: #2563eb; color: white; }

    /* Mode 1: Cards View Grid */
    .glossary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 1050px) { .glossary-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 650px) { .glossary-grid { grid-template-columns: 1fr; } }

    .term-card { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 14px; padding: 1.15rem; display: flex; flex-direction: column; gap: 0.65rem; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.02); transition: transform 0.2s var(--ease), border-color 0.2s var(--ease); }
    .term-card:hover { transform: translateY(-2px); border-color: rgba(37, 99, 235, 0.3); }

    .term-header { display: flex; flex-direction: column; gap: 0.35rem; }
    .term-category-badge { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: #2563eb; background: rgba(37, 99, 235, 0.08); padding: 0.15rem 0.5rem; border-radius: 4px; align-self: flex-start; }
    .term-title { font-family: var(--font-display); font-size: 1.15rem; font-weight: 800; color: var(--text); margin: 0; line-height: 1.3; }

    /* Param Badges */
    .param-badge-box { background: rgba(37, 99, 235, 0.05); border: 1px solid rgba(37, 99, 235, 0.15); border-radius: 8px; padding: 0.5rem 0.75rem; font-family: var(--font-mono); font-size: 0.75rem; display: flex; flex-direction: column; gap: 0.2rem; color: var(--text); }
    .param-badge-box .rec { color: #2563eb; font-weight: 600; font-size: 0.72rem; }

    .term-def { color: var(--text-muted); font-size: 0.9rem; line-height: 1.55; margin: 0; }

    /* Accordion Drawer */
    .accordion-toggle-btn { background: rgba(15, 23, 42, 0.04); border: 1px solid rgba(15, 23, 42, 0.08); padding: 0.45rem 0.75rem; border-radius: 8px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: #2563eb; cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: background 0.2s var(--ease); }
    .accordion-toggle-btn:hover { background: rgba(37, 99, 235, 0.1); }
    .accordion-toggle-btn .chevron { transition: transform 0.3s var(--ease); }
    .accordion-toggle-btn.open .chevron { transform: rotate(180deg); }

    .accordion-body { display: none; flex-direction: column; gap: 0.75rem; margin-top: 0.5rem; }
    .accordion-body.open { display: flex; }

    .detail-label { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-faint); letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem; }
    .detail-text { font-size: 0.85rem; color: var(--text); line-height: 1.5; margin: 0; background: rgba(15, 23, 42, 0.03); padding: 0.65rem 0.85rem; border-radius: 8px; border-left: 3px solid #2563eb; white-space: pre-line; }
    .related-tag { font-family: var(--font-mono); font-size: 0.75rem; color: #2563eb; background: rgba(37, 99, 235, 0.06); padding: 0.2rem 0.5rem; border-radius: 4px; display: inline-block; }

    /* Mode 2: Compact Table View */
    .table-card-wrapper { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 16px; overflow-x: auto; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04); }
    .compact-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.88rem; }
    .compact-table th, .compact-table td { padding: 0.85rem 1.25rem; border-bottom: 1px solid rgba(15, 23, 42, 0.06); }
    .compact-table th { background: rgba(15, 23, 42, 0.03); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-faint); }
    .row-term { color: var(--text); font-weight: 700; }
    .row-def { color: var(--text-muted); font-size: 0.85rem; line-height: 1.4; }
    .row-param-badge { font-family: var(--font-mono); font-size: 0.75rem; color: #2563eb; background: rgba(37, 99, 235, 0.08); padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 700; }
  </style>

  <script is:raw>
    // VRAM Footprint & KV Cache Calculator
    const calcParams = document.getElementById('calcParams');
    const calcPrecision = document.getElementById('calcPrecision');
    const calcContext = document.getElementById('calcContext');
    const calcBatch = document.getElementById('calcBatch');

    function updateVramCalc() {
      const paramsB = parseFloat(calcParams.value);
      const bytesPerParam = parseFloat(calcPrecision.value);
      const contextK = parseFloat(calcContext.value);
      const batchSize = parseInt(calcBatch.value);

      document.getElementById('calcParamsVal').textContent = `${paramsB}B`;
      document.getElementById('calcContextVal').textContent = `${contextK}K tokens (${contextK * 1000})`;
      document.getElementById('calcBatchVal').textContent = `${batchSize} Requests`;

      const weightsGb = (paramsB * bytesPerParam);
      const kvGb = (0.0128 * (contextK) * batchSize * (paramsB / 70));
      const totalVramGb = weightsGb + kvGb + 4.0;

      document.getElementById('resWeights').textContent = `${weightsGb.toFixed(1)} GB`;
      document.getElementById('resKv').textContent = `${kvGb.toFixed(1)} GB`;
      document.getElementById('resTotalVram').textContent = `${totalVramGb.toFixed(1)} GB`;
    }

    calcParams?.addEventListener('input', updateVramCalc);
    calcPrecision?.addEventListener('change', updateVramCalc);
    calcContext?.addEventListener('input', updateVramCalc);
    calcBatch?.addEventListener('input', updateVramCalc);

    // Accordion Toggle Script
    document.querySelectorAll('.accordion-toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const body = btn.nextElementSibling;
        if (body) {
          btn.classList.toggle('open');
          body.classList.toggle('open');
          const isOpen = btn.classList.contains('open');
          btn.querySelector('span').textContent = isOpen ? 'Hide Technical Details' : 'Show Technical Formulas & Details';
        }
      });
    });

    // View Switcher Script (Cards vs Table)
    const viewCardsBtn = document.getElementById('viewCardsBtn');
    const viewTableBtn = document.getElementById('viewTableBtn');
    const glossaryGrid = document.getElementById('glossaryGrid');
    const glossaryTableWrapper = document.getElementById('glossaryTableWrapper');

    viewCardsBtn?.addEventListener('click', () => {
      viewCardsBtn.classList.add('active');
      viewTableBtn.classList.remove('active');
      if (glossaryGrid) glossaryGrid.style.display = 'grid';
      if (glossaryTableWrapper) glossaryTableWrapper.style.display = 'none';
    });

    viewTableBtn?.addEventListener('click', () => {
      viewTableBtn.classList.add('active');
      viewCardsBtn.classList.remove('active');
      if (glossaryGrid) glossaryGrid.style.display = 'none';
      if (glossaryTableWrapper) glossaryTableWrapper.style.display = 'block';
    });

    // Filtering System (Search + Category + A-Z)
    const searchInput = document.getElementById('glossarySearch');
    const pillBtns = document.querySelectorAll('.pill-btn');
    const azBtns = document.querySelectorAll('.az-btn');
    const termCards = document.querySelectorAll('.term-card');
    const compactRows = document.querySelectorAll('.compact-row');
    const visibleCount = document.getElementById('visibleCount');

    let currentCategory = 'All';
    let currentLetter = 'All';

    function filterTerms() {
      const query = searchInput.value.toLowerCase().trim();
      let matchCount = 0;

      termCards.forEach((card, idx) => {
        const termName = card.getAttribute('data-term') || '';
        const firstLetter = card.getAttribute('data-first') || '';
        const cat = card.getAttribute('data-cat') || '';
        const textContent = card.textContent.toLowerCase();

        const matchesCat = (currentCategory === 'All') || cat.toLowerCase().includes(currentCategory.toLowerCase());
        const matchesLetter = (currentLetter === 'All') || (currentLetter === '#' ? !/[A-Z]/i.test(firstLetter) : firstLetter === currentLetter);
        const matchesQuery = !query || termName.includes(query) || textContent.includes(query);

        const isMatch = matchesCat && matchesLetter && matchesQuery;

        card.style.display = isMatch ? 'flex' : 'none';
        if (compactRows[idx]) compactRows[idx].style.display = isMatch ? 'table-row' : 'none';

        if (isMatch) matchCount++;
      });

      if (visibleCount) visibleCount.textContent = matchCount;
    }

    searchInput?.addEventListener('input', filterTerms);

    pillBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        pillBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = btn.getAttribute('data-category') || 'All';
        filterTerms();
      });
    });

    azBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        azBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentLetter = btn.getAttribute('data-letter') || 'All';
        filterTerms();
      });
    });
  </script>
</Layout>
