---
import Layout from '../../layouts/Layout.astro';
import ExecutiveCallout from '../../components/ExecutiveCallout.astro';
import AnalogyBadge from '../../components/AnalogyBadge.astro';

const energySlides = [
  { id: 1, img: '../../images/slides/energy_image1.png', title: 'The 2030 AI Factory Blueprint: Full-Stack Co-Design', text: 'Full-stack 1 GW gigawatt infrastructure co-design spanning nuclear reactors, liquid cooling, Blackwell NVL72, UEC packet-spraying, and Kubernetes.' },
  { id: 2, img: '../../images/slides/energy_image2.png', title: 'Layer 0 (Power): Nuclear SMRs for Baseload Compute', text: 'Kairos Power KP-FHR Fluoride Salt-Cooled High-Temperature Reactor supplying 1 GW behind-the-meter zero-carbon baseload compute power.' },
  { id: 3, img: '../../images/slides/energy_image3.png', title: 'Layer 0 (Power): Modern Reactor Molten Salt Architecture', text: 'TRISO pebble fuel elements, primary molten fluoride salt loops, secondary steam heat exchangers, and passive emergency decay heat removal.' },
  { id: 4, img: '../../images/slides/energy_image4.png', title: 'Layer 1 (Facility): Cooling the Gigawatt Data Center', text: 'Air cooling 12kW per rack thermal wall vs Direct-to-Chip (DLC) liquid cold plates handling 160kW+ per rack power densities.' },
  { id: 5, img: '../../images/slides/energy_image5.png', title: 'Layer 1 (Facility): Heat Exchange & Liquid Plumbing', text: 'Coolant Distribution Units (CDUs), secondary dielectric liquid loops, dry heat exchangers, and 95% water consumption reduction.' },
  { id: 6, img: '../../images/slides/energy_image6.png', title: 'Layer 2 (Hardware): Compute Architecture (GB200/GB300 NVL72)', text: '72 Blackwell GPUs in a single liquid-cooled NVLink domain delivering 130 TB/s bisection bandwidth.' },
  { id: 7, img: '../../images/slides/energy_image7.png', title: 'Layer 2 (Hardware): Power Delivery & Rack Density', text: '48V to 12V direct-to-die power conversion, copper busbars, and 120kW+ per rack power density delivery.' },
  { id: 8, img: '../../images/slides/energy_image8.png', title: 'Layer 3 (Network): The RoCEv2 Bottleneck', text: 'TCP/IP latency limits (>15us) vs RoCEv2 PFC pause frame head-of-line blocking and network congestion deadlocks.' },
  { id: 9, img: '../../images/slides/energy_image9.png', title: 'Layer 3 (Network): Evaluating the AI Fabric (RoCEv2 vs InfiniBand vs UEC)', text: 'RoCEv2 (5-6us), InfiniBand (1.2us proprietary), and Ultra Ethernet Consortium UEC (~1.9us open-standard TH4/TH5 silicon).' },
  { id: 10, img: '../../images/slides/energy_image10.png', title: 'Layer 3 (Network): Mechanics of Ultra Ethernet Packet Spraying', text: 'Packet-by-packet spraying across spine paths, eliminating flow pinning, with sender-based rate control and out-of-order NIC reassembly.' },
  { id: 11, img: '../../images/slides/energy_image11.png', title: 'Layer 4 (Software): Orchestrating at Scale with Slinky', text: 'Slinky (Slurm-operator) running Slurm workloads natively inside Kubernetes with High Availability (HA) up to 8,000+ GPUs.' },
  { id: 12, img: '../../images/slides/energy_image12.png', title: 'Layer 4 (Software): Topology-Aware Scheduling', text: 'NVIDIA GPU Operator, Dynamic Resource Allocation (DRA), and internode memory exchange (IMEX) domain alignment.' },
  { id: 13, img: '../../images/slides/energy_image13.png', title: 'The 2030 AI Factory Stack Synthesis', text: '120-meter vertical integration: Nuclear Baseload -> Hybrid Liquid Facility -> NVL72 Racks -> UEC Fabric -> Kubernetes.' }
];
---

<Layout title="Energy & Power Infrastructure — AI Concepts & Infrastructure">
  <div class="glitch-overlay"></div>
  <div class="viewport-matrix-container">
    <canvas id="networkCanvas"></canvas>
  </div>

  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-header">
        <a href="/ai" class="back-link">← Back to AI Concepts and Infrastructure</a>
        <p class="hero-eyebrow">MODULE 05 · INFRASTRUCTURE & ENERGETICS</p>
        <h1 class="hero-title">Energy & Power Grid Infrastructure</h1>
        <p class="hero-tagline">
          The 2030 AI Factory Blueprint: Behind-the-meter Small Modular Reactors (SMRs), direct-to-chip closed-loop liquid cooling, Ultra Ethernet (UEC) fabrics, and gigawatt cluster energetics.
        </p>

        <ExecutiveCallout title="EXECUTIVE ENERGETICS BRIEFING">
          Scaling gigawatt AI factories requires full-stack co-design across 5 layers. <strong>Behind-the-Meter (BTM) nuclear SMRs</strong> provide 100% zero-carbon baseload power directly to the site, bypassing multi-year public grid queues. <strong>Closed-loop liquid cooling</strong> drops Power Usage Effectiveness (PUE) to 1.03 while cutting water usage by 95%.
        </ExecutiveCallout>

        <AnalogyBadge concept="Small Modular Reactors (SMRs)">
          SMRs are like compact, factory-fabricated mini nuclear plants built offsite and plugged directly into a single AI campus, drawing ZERO electricity from the public residential grid.
        </AnalogyBadge>
      </div>
    </div>
  </section>

  <!-- 1. Interactive 1 GW SMR Power Grid & Cooling Calculator -->
  <section class="section">
    <div class="container">
      <div class="calculator-panel">
        <div class="panel-header">
          <span class="eyebrow-tag">GIGAWATT CLUSTER SIMULATOR</span>
          <h2>Data Center Baseload Power & PUE Calculator</h2>
          <p>Simulate cluster capacity, nuclear SMR baseload requirements, and liquid cooling PUE efficiency.</p>
        </div>

        <div class="calc-grid">
          <div class="calc-inputs">
            <div class="input-group">
              <label for="powerGpuCount">NVIDIA Blackwell GPUs: <span id="powerGpuVal" class="val-num">100,000 GPUs</span></label>
              <input type="range" id="powerGpuCount" min="10000" max="500000" step="10000" value="100000" />
            </div>

            <div class="input-group">
              <label for="powerPerRack">Rack Power Density: <span id="powerRackVal" class="val-num">120 kW / rack</span></label>
              <input type="range" id="powerPerRack" min="20" max="200" step="10" value="120" />
            </div>

            <div class="input-group">
              <label for="pueTarget">Target PUE Efficiency: <span id="pueTargetVal" class="val-num">1.03 (Closed-Loop Liquid)</span></label>
              <input type="range" id="pueTarget" min="1.02" max="1.60" step="0.01" value="1.03" />
            </div>
          </div>

          <div class="calc-results">
            <div class="res-card">
              <span class="res-label">PEAK COMPUTE POWER DRAW</span>
              <span class="res-val highlight" id="resPowerDraw">120 MW</span>
              <span class="res-sub">Direct IT equipment power consumption</span>
            </div>

            <div class="res-card">
              <span class="res-label">TOTAL FACILITY POWER (WITH PUE)</span>
              <span class="res-val" id="resFacilityPower">123.6 MW</span>
              <span class="res-sub">Includes cooling & auxiliary infrastructure</span>
            </div>

            <div class="res-card total">
              <span class="res-label">REQUIRED SMR UNITS (50MW EACH)</span>
              <span class="res-val total-val" id="resSmrUnits">3 SMR Reactors</span>
              <span class="res-sub">100% Behind-the-Meter Zero-Carbon Baseload</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Closed-Loop Liquid vs Evaporative Cooling Infographic Feature -->
  <section class="section">
    <div class="container">
      <div class="sec-card">
        <div class="section-title-box">
          <span class="eyebrow-tag">COOLING TECHNOLOGY COMPARISON</span>
          <h2>The Sealed Future: Closed-Loop Liquid vs. Evaporative Cooling</h2>
          <p>Cutting daily data center water usage by 95% while lowering PUE from 1.58 down to 1.03.</p>
        </div>

        <div class="cooling-feature-grid">
          <div class="cooling-img-box">
            <img src="../../images/slides/cooling_comparison.png" alt="AI Data Center Cooling Comparison" />
          </div>

          <div class="cooling-metrics-box">
            <div class="cool-stat-card danger">
              <span class="cool-tag">TRADITIONAL EVAPORATIVE</span>
              <h3>5,000,000 Gallons / Day</h3>
              <p>Evaporates millions of gallons of municipal water daily as steam. Limited to 12kW per rack power densities.</p>
              <div class="cool-badge-row">
                <span class="badge">PUE: 1.58</span>
                <span class="badge">Air-Cooled Limit</span>
              </div>
            </div>

            <div class="cool-stat-card success">
              <span class="cool-tag">CLOSED-LOOP LIQUID (SOTA)</span>
              <h3>22,000 Gallons / Day</h3>
              <p>Direct-to-chip (DLC) dielectric cold plates with dry heat exchangers. <strong>95% Water Savings</strong> and supports 160kW+ per rack power density.</p>
              <div class="cool-badge-row highlight">
                <span class="badge green">PUE: 1.03</span>
                <span class="badge green">160kW+ Rack Density</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. 2030 AI Factory Blueprint Slide Deck Lightbox Inspector (All 13 Slides) -->
  <section class="section">
    <div class="container">
      <div class="section-title-box">
        <span class="eyebrow-tag">SLIDE INSPECTOR (13 SLIDES)</span>
        <h2>The 2030 AI Factory Blueprint Slide Deck Inspector</h2>
        <p>Click any slide to open the high-resolution lightbox inspector with slide details and OCR technical breakdown.</p>
      </div>

      <div class="slide-gallery">
        {energySlides.map((slide) => (
          <div class="slide-card" data-img={slide.img} data-title={slide.title} data-text={slide.text} data-num={slide.id}>
            <div class="slide-img-wrapper">
              <img src={slide.img} alt={slide.title} loading="lazy" />
              <div class="expand-overlay">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                <span>Expand Slide</span>
              </div>
            </div>
            <div class="slide-caption">
              <span class="slide-num">SLIDE {slide.id < 10 ? `0${slide.id}` : slide.id} // 13</span>
              <h4>{slide.title}</h4>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div id="slideModal" class="modal-overlay" aria-hidden="true">
    <div class="modal-content">
      <button id="modalClose" class="modal-close-btn">&times;</button>
      <div class="modal-grid">
        <div class="modal-img-container">
          <img id="modalImg" src="" alt="Slide Detail" />
        </div>
        <div class="modal-info">
          <span id="modalNum" class="modal-num">SLIDE 01 // 13</span>
          <h3 id="modalTitle" class="modal-title">Slide Title</h3>
          <p id="modalText" class="modal-text">Slide description and OCR text breakdown.</p>

          <div class="modal-controls">
            <button id="prevSlideBtn" class="modal-nav-btn">← Previous</button>
            <button id="nextSlideBtn" class="modal-nav-btn">Next →</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .back-link { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; color: #2563eb; text-decoration: none; display: inline-block; margin-bottom: 0.5rem; }
    .eyebrow-tag { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--gold-hot); letter-spacing: 0.1em; display: block; margin-bottom: 0.2rem; }
    .section-title-box h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--text); margin: 0 0 0.2rem 0; }
    .section-title-box p { color: var(--text-muted); font-size: 0.88rem; margin: 0 0 1rem 0; }

    .section { padding: 0.75rem 0; }

    /* Calculator Panel */
    .calculator-panel { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 14px; padding: 1.15rem 1.35rem; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03); margin-bottom: 1.25rem; }
    .calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: center; }
    @media (max-width: 850px) { .calc-grid { grid-template-columns: 1fr; gap: 1rem; } }
    .input-group { margin-bottom: 0.75rem; }
    .input-group label { font-size: 0.82rem; font-weight: 600; color: var(--text); display: flex; justify-content: space-between; margin-bottom: 0.2rem; }
    .val-num { font-family: var(--font-mono); color: #2563eb; font-weight: 700; }
    .input-group input[type="range"] { width: 100%; accent-color: #2563eb; }

    .calc-results { display: flex; flex-direction: column; gap: 0.5rem; }
    .res-card { background: rgba(15, 23, 42, 0.03); border-radius: 8px; padding: 0.75rem 0.85rem; }
    .res-card.total { background: rgba(37, 99, 235, 0.06); border: 1px solid rgba(37, 99, 235, 0.2); }
    .res-label { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--text-faint); }
    .res-val { font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: var(--text); margin: 0.05rem 0; }
    .res-val.highlight { color: #2563eb; }
    .res-val.total-val { color: #2563eb; font-size: 1.55rem; }
    .res-sub { font-size: 0.78rem; color: var(--text-muted); }

    /* Cooling Feature Card */
    .sec-card { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 14px; padding: 1.25rem; margin-bottom: 1.25rem; }
    .cooling-feature-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 1.25rem; margin-top: 0.85rem; align-items: center; }
    @media (max-width: 900px) { .cooling-feature-grid { grid-template-columns: 1fr; } }
    .cooling-img-box { border-radius: 10px; overflow: hidden; border: 1px solid rgba(15, 23, 42, 0.1); box-shadow: 0 4px 16px rgba(0,0,0,0.05); background: #0f172a; }
    .cooling-img-box img { width: 100%; height: auto; display: block; object-fit: contain; }

    .cooling-metrics-box { display: flex; flex-direction: column; gap: 0.85rem; }
    .cool-stat-card { background: rgba(15, 23, 42, 0.03); border-radius: 10px; padding: 0.85rem 1rem; display: flex; flex-direction: column; gap: 0.35rem; }
    .cool-stat-card.danger { border-left: 3px solid #ef4444; }
    .cool-stat-card.success { border-left: 3px solid #10b981; background: rgba(16, 185, 129, 0.04); }
    .cool-tag { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-faint); }
    .cool-stat-card h3 { font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; color: var(--text); margin: 0; }
    .cool-stat-card p { font-size: 0.8rem; color: var(--text-muted); line-height: 1.4; margin: 0; }
    .cool-badge-row { display: flex; gap: 0.5rem; margin-top: 0.2rem; }
    .badge { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; background: rgba(15, 23, 42, 0.06); padding: 0.15rem 0.45rem; border-radius: 4px; color: var(--text-muted); }
    .badge.green { background: rgba(16, 185, 129, 0.1); color: #10b981; }

    /* Gallery */
    .slide-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
    @media (max-width: 900px) { .slide-gallery { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .slide-gallery { grid-template-columns: 1fr; } }

    .slide-card { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.02); cursor: pointer; transition: transform 0.2s var(--ease); }
    .slide-card:hover { transform: translateY(-2px); border-color: rgba(37, 99, 235, 0.4); }
    .slide-img-wrapper { aspect-ratio: 16/9; background: #0f172a; position: relative; overflow: hidden; }
    .slide-img-wrapper img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .expand-overlay { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.65); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem; color: white; opacity: 0; transition: opacity 0.2s var(--ease); font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; }
    .slide-card:hover .expand-overlay { opacity: 1; }
    .slide-caption { padding: 0.75rem 0.85rem; }
    .slide-num { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: #2563eb; }
    .slide-caption h4 { font-family: var(--font-display); font-size: 0.88rem; font-weight: 700; color: var(--text); margin: 0.1rem 0 0 0; }

    /* Lightbox Modal */
    .modal-overlay { position: fixed; inset: 0; z-index: 9999; background: rgba(15, 23, 42, 0.92); backdrop-filter: blur(16px); display: none; align-items: center; justify-content: center; padding: 1.5rem; }
    .modal-overlay.active { display: flex; }
    .modal-content { background: #0f172a; border-radius: 20px; max-width: 95vw; width: 1400px; max-height: 92vh; height: 90vh; overflow: hidden; position: relative; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7); border: 1px solid rgba(255, 255, 255, 0.1); }
    .modal-close-btn { position: absolute; top: 1rem; right: 1.5rem; font-size: 2.5rem; border: none; background: rgba(255, 255, 255, 0.1); color: #f8fafc; border-radius: 50%; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 20; line-height: 1; transition: background 0.2s var(--ease); }
    .modal-close-btn:hover { background: #2563eb; color: white; }

    .modal-grid { display: grid; grid-template-columns: 2.5fr 1fr; height: 100%; }
    @media (max-width: 950px) { .modal-grid { grid-template-columns: 1fr; overflow-y: auto; } }
    .modal-img-container { background: #020617; display: flex; align-items: center; justify-content: center; padding: 1.5rem; height: 100%; overflow: hidden; }
    .modal-img-container img { max-width: 100%; max-height: 85vh; width: 100%; object-fit: contain; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .modal-info { padding: 2.5rem 2rem; display: flex; flex-direction: column; justify-content: space-between; background: #0f172a; border-left: 1px solid rgba(255, 255, 255, 0.08); height: 100%; overflow-y: auto; }
    .modal-num { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; color: #3b82f6; }
    .modal-title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: #f8fafc; margin: 0.5rem 0 1rem 0; line-height: 1.3; }
    .modal-text { color: #94a3b8; font-size: 0.95rem; line-height: 1.65; margin-bottom: 2rem; }

    .modal-controls { display: flex; gap: 1rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.08); }
    .modal-nav-btn { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); padding: 0.85rem 1.25rem; border-radius: 10px; font-family: var(--font-mono); font-size: 0.88rem; font-weight: 700; color: #f8fafc; cursor: pointer; transition: all 0.2s var(--ease); flex: 1; }
    .modal-nav-btn:hover { background: #2563eb; color: white; border-color: #2563eb; }
  </style>

  <script is:raw>
    // Baseload & Power Grid Calculator
    const gpuInput = document.getElementById('powerGpuCount');
    const rackInput = document.getElementById('powerPerRack');
    const pueInput = document.getElementById('pueTarget');

    function updatePowerCalc() {
      const gpus = parseInt(gpuInput.value);
      const kwPerRack = parseInt(rackInput.value);
      const pue = parseFloat(pueInput.value);

      document.getElementById('powerGpuVal').textContent = `${gpus.toLocaleString()} GPUs`;
      document.getElementById('powerRackVal').textContent = `${kwPerRack} kW / rack`;
      document.getElementById('pueTargetVal').textContent = `${pue.toFixed(2)} (${pue <= 1.05 ? 'Closed-Loop Liquid' : 'Evaporative Air'})`;

      // 72 GPUs per rack (NVL72 standard)
      const rackCount = Math.ceil(gpus / 72);
      const itMw = (rackCount * kwPerRack) / 1000;
      const facilityMw = itMw * pue;
      const smrCount = Math.ceil(facilityMw / 50); // 50MW per SMR reactor module

      document.getElementById('resPowerDraw').textContent = `${itMw.toFixed(1)} MW`;
      document.getElementById('resFacilityPower').textContent = `${facilityMw.toFixed(1)} MW`;
      document.getElementById('resSmrUnits').textContent = `${smrCount} SMR Reactor${smrCount > 1 ? 's' : ''}`;
    }

    gpuInput?.addEventListener('input', updatePowerCalc);
    rackInput?.addEventListener('input', updatePowerCalc);
    pueInput?.addEventListener('input', updatePowerCalc);

    updatePowerCalc();

    // Slide Lightbox Script
    const cards = document.querySelectorAll('.slide-card');
    const modal = document.getElementById('slideModal');
    const modalImg = document.getElementById('modalImg');
    const modalNum = document.getElementById('modalNum');
    const modalTitle = document.getElementById('modalTitle');
    const modalText = document.getElementById('modalText');
    const modalClose = document.getElementById('modalClose');
    const prevBtn = document.getElementById('prevSlideBtn');
    const nextBtn = document.getElementById('nextSlideBtn');

    let currentIndex = 0;

    function openModal(index) {
      if (!cards[index] || !modal) return;
      currentIndex = index;
      const card = cards[index];

      const img = card.getAttribute('data-img') || '';
      const title = card.getAttribute('data-title') || '';
      const text = card.getAttribute('data-text') || '';
      const num = card.getAttribute('data-num') || '';

      if (modalImg) modalImg.src = img;
      if (modalNum) modalNum.textContent = `SLIDE ${parseInt(num) < 10 ? '0' + num : num} // ${cards.length}`;
      if (modalTitle) modalTitle.textContent = title;
      if (modalText) modalText.textContent = text;

      modal.classList.add('active');
    }

    cards.forEach((card, idx) => { card.addEventListener('click', () => openModal(idx)); });
    modalClose?.addEventListener('click', () => modal?.classList.remove('active'));
    modal?.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('active'); });

    prevBtn?.addEventListener('click', () => { openModal((currentIndex - 1 + cards.length) % cards.length); });
    nextBtn?.addEventListener('click', () => { openModal((currentIndex + 1) % cards.length); });

    window.addEventListener('keydown', (e) => {
      if (!modal?.classList.contains('active')) return;
      if (e.key === 'Escape') modal.classList.remove('active');
      if (e.key === 'ArrowLeft') prevBtn?.click();
      if (e.key === 'ArrowRight') nextBtn?.click();
    });
  </script>
</Layout>
