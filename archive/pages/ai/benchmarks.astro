---
import Layout from '../../layouts/Layout.astro';
import modelsData from '../../data/models.json';
import ExecutiveCallout from '../../components/ExecutiveCallout.astro';
import AnalogyBadge from '../../components/AnalogyBadge.astro';
import Tooltip from '../../components/Tooltip.astro';

const frontierSlides = [
  { id: 1, img: '../../images/slides/architecture_image1.png', title: 'Frontier Model Architecture & Agentic Economics', text: 'Overview of Gen 4 models (Claude Opus 5, Claude Fable 5, GPT-5.6 Sol, Gemini 3.1 Pro, Kimi K3).' },
  { id: 2, img: '../../images/slides/architecture_image2.png', title: 'Agentic Evaluation Matrix (SWE-bench & ARC-AGI)', text: 'DeepSWE 95.0% Gemini 3.1 Pro, 30.2% ARC-AGI-3 Opus 5, and OSWorld 2.0 benchmark rankings.' },
  { id: 3, img: '../../images/slides/architecture_image3.png', title: 'The Token-Efficiency Paradox', text: '50% nominal per-token price cuts neutralized by 2.5x self-verification loops, yielding ~20% net task savings.' },
  { id: 4, img: '../../images/slides/architecture_image4.png', title: 'Adaptive Test-Time Compute & Speed Toggles', text: 'Claude Opus 5 Fast Mode (2.5x speedup at $10/M in) vs Batch API ($2.50/M in) vs Standard Mode.' },
  { id: 5, img: '../../images/slides/architecture_image5.png', title: 'Intrinsic Alignment vs Outer Safety Cascade', text: 'Outer wrapper safety classifiers (Fable 5) vs intrinsic weight alignment (Opus 5) reducing false positives by 85%.' },
  { id: 6, img: '../../images/slides/architecture_image6.png', title: 'Model Personalities & Operational Styles', text: 'Architectural craftsman (Fable 5), inquisitive agent (Opus 5), obedient executor (GPT-5.6), and open-weight (Kimi K3).' },
  { id: 7, img: '../../images/slides/architecture_image7.png', title: 'Evolution of Frontier Architectures (Gen 1 to Gen 4)', text: 'Foundational Dense Scaling -> MoE Routing -> Explicit Reasoning Traces -> Gen 4 Adaptive Distilled Frontier.' },
  { id: 8, img: '../../images/slides/architecture_image8.png', title: 'Gen 4 Model Bifurcation (Distilled vs Parent)', text: 'Distilled agents ($5/$25 per M) vs massive parent orchestrators ($10/$50 per M) and open-weight MoEs.' },
  { id: 9, img: '../../images/slides/architecture_image9.png', title: 'Zero-Data-Retention (ZDR) Enterprise Compliance', text: 'Intrinsic weight alignment enabling Zero-Data-Retention policies without 30-day logging bottlenecks.' },
  { id: 10, img: '../../images/slides/architecture_image10.png', title: 'Four Strategic Pillars for Distilled Deployment', text: '1. Optimize Cost-Per-Task | 2. Leverage Prompt Caching | 3. Match Workload | 4. Adaptive Effort Dials.' },
  { id: 11, img: '../../images/slides/architecture_image11.png', title: 'Macroeconomic Pressures & On-Policy Distillation', text: 'Shift from raw parameter pre-training to on-policy knowledge distillation and intrinsic alignment.' },
  { id: 12, img: '../../images/slides/architecture_image12.png', title: 'Agentic Benchmark Dominance (OSWorld & SWE-bench)', text: 'Comparative benchmark scores evaluating computer use, repo-level software engineering, and Elo rankings.' },
  { id: 13, img: '../../images/slides/architecture_image13.png', title: 'Self-Verification Loop Expansion Mechanics', text: 'Mathematical proof showing how distilled models think out loud to match parent model reasoning.' },
  { id: 14, img: '../../images/slides/architecture_image14.png', title: 'Enterprise Model Deployment Strategy Matrix', text: 'Matching specialized workloads to Opus 5, Fable 5, GPT-5.6 Sol, and Kimi K3 open-weight.' },
  { id: 15, img: '../../images/slides/architecture_image15.png', title: 'Conclusion: Active Structural AI Engineering', text: 'Mastering adaptive compute controls, prompt caching, and workload-specific deployment strategies.' }
];

const benchmarkExplainers = {
  swe: {
    title: "SWE-bench & DeepSWE (Autonomous Repo Coding)",
    subtitle: "Long-Horizon Software Engineering Benchmark",
    description: "SWE-bench evaluates AI models on resolving real-world GitHub issues across complex open-source repositories. Models are provided an issue description and full codebase access, requiring them to search files, edit code, run unit tests, and generate passing patches autonomously.",
    why: "Replaces single-function code generation (HumanEval) with real-world multi-file repo navigation, long-horizon planning, and tool execution.",
    sota: "Gemini 3.1 Pro (95.0%), GPT-5.6 Sol (86.5%), Claude 3.7 Sonnet (85.2%), Claude Fable 5 (84.0%), Claude Opus 5 (83.0%), Next-Gen Open Weight MoE (81.5%)."
  },
  gdp: {
    title: "GDPval-AA v2 (Knowledge Work Blind Elo)",
    subtitle: "Real-World Corporate Workflow Evaluation",
    description: "Evaluates models on complex multi-modal knowledge work tasks derived from real corporate workflows (financial modeling, legal policy analysis, medical diagnostics, strategic pitch decks). Scored via double-blind human expert Elo pairing.",
    why: "Eliminates multiple-choice memorization by testing deep synthesis quality, domain nuance, and strategic clarity.",
    sota: "Gemini 3.1 Pro (1890 Elo), Claude Opus 5 (1861 Elo), Claude 3.7 Sonnet (1850 Elo), GPT-5.6 Sol (1845 Elo), Claude Fable 5 (1820 Elo)."
  },
  arc: {
    title: "ARC-AGI-3 (Abstraction & Spatial Reasoning)",
    subtitle: "Zero-Shot Out-of-Distribution Novelty",
    description: "Evaluates novel spatial reasoning and problem solving using visual grid transformation puzzles designed specifically to prevent pre-training memorization.",
    why: "Serves as the primary benchmark for fluid intelligence and zero-shot adaptation to unseen logic rules.",
    sota: "Gemini 3.1 Pro (32.0%), Claude Opus 5 (30.2%), GPT-5.6 Sol (29.1%), Claude Fable 5 (28.5%), Next-Gen Open Weight MoE (26.8%)."
  }
};
---

<Layout title="Model Benchmarks & Frontier Architectures — AI Concepts & Infrastructure">
  <div class="glitch-overlay"></div>
  <div class="viewport-matrix-container">
    <canvas id="networkCanvas"></canvas>
  </div>

  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-header">
        <a href="/ai" class="back-link">← Back to AI Concepts and Infrastructure</a>
        <p class="hero-eyebrow">MODULE 02 · MODEL EVALUATION & ARCHITECTURES</p>
        <h1 class="hero-title">Frontier Model Benchmarks & Gen 4 Architectures</h1>
        <p class="hero-tagline">
          Empirical evaluation matrix of Gen 4 frontier LLMs alongside an interactive slide deck inspector analyzing on-policy distillation, agentic benchmarks, and test-time compute.
        </p>

        <ExecutiveCallout title="EXECUTIVE EVALUATION SUMMARY">
          Frontier AI selection is no longer about buying raw parameter size. <strong>Gemini 3.1 Pro</strong> dominates autonomous software engineering (95% SWE-bench) and corporate knowledge synthesis (1890 Elo). <strong>Claude Opus 5</strong> leads in novel spatial reasoning and agentic tool planning. Deploying mid-tier distilled models for daily workflows delivers 80% cost savings compared to top-tier parent orchestrators.
        </ExecutiveCallout>

        <AnalogyBadge concept="Mixture-of-Experts (MoE)">
          An MoE model is like employing 896 specialized consultants, but only activating the 16 exact experts needed for each question. You get 2.8 trillion parameters of knowledge at 1/16th the operational server cost.
        </AnalogyBadge>
      </div>
    </div>
  </section>

  <!-- Interactive Linked Radar Graph & Model Comparator -->
  <section class="section">
    <div class="container">
      <div class="comp-grid">
        <!-- Radar Chart Panel -->
        <div class="comp-card">
          <div class="card-header">
            <span class="eyebrow-tag">DYNAMIC VISUAL COMPARISON</span>
            <h3>Frontier Capability Radar Chart</h3>
            <p>Selecting models in the comparator dynamically updates the spider graph below.</p>
          </div>

          <div class="radar-box">
            <svg viewBox="0 0 400 360" class="radar-svg">
              <!-- Radar Background Polygons -->
              <polygon points="200,40 330,115 330,265 200,340 70,265 70,115" class="radar-grid-line" />
              <polygon points="200,85 297,141 297,248 200,305 102,248 102,141" class="radar-grid-line inner" />
              <polygon points="200,130 265,167 265,232 200,270 135,232 135,167" class="radar-grid-line inner" />

              <!-- Axes Lines -->
              <line x1="200" y1="190" x2="200" y2="40" class="radar-axis" />
              <line x1="200" y1="190" x2="330" y2="115" class="radar-axis" />
              <line x1="200" y1="190" x2="330" y2="265" class="radar-axis" />
              <line x1="200" y1="190" x2="200" y2="340" class="radar-axis" />
              <line x1="200" y1="190" x2="70" y2="265" class="radar-axis" />
              <line x1="200" y1="190" x2="70" y2="115" class="radar-axis" />

              <!-- Labels -->
              <text x="200" y="25" text-anchor="middle" class="radar-label">Coding (SWE-bench)</text>
              <text x="345" y="115" text-anchor="start" class="radar-label">Elo (GDPval)</text>
              <text x="345" y="270" text-anchor="start" class="radar-label">Spatial (ARC-AGI)</text>
              <text x="200" y="358" text-anchor="middle" class="radar-label">Context Size</text>
              <text x="55" y="270" text-anchor="end" class="radar-label">Speed (TPS)</text>
              <text x="55" y="115" text-anchor="end" class="radar-label">Cost Efficiency</text>

              <!-- Dynamic Model Polygons -->
              <polygon id="polyA" points="200,45 325,120 320,260 200,335 90,240 85,125" class="radar-poly gemini" />
              <polygon id="polyB" points="200,60 310,130 310,250 200,310 110,225 100,135" class="radar-poly opus" />
            </svg>

            <div class="radar-legend">
              <span class="legend-item gemini"><span class="legend-dot"></span> <span id="legendNameA">Gemini 3.1 Pro (Model A)</span></span>
              <span class="legend-item opus"><span class="legend-dot"></span> <span id="legendNameB">Claude Opus 5 (Model B)</span></span>
            </div>
          </div>
        </div>

        <!-- Side-by-Side Model Comparator Panel -->
        <div class="comp-card">
          <div class="card-header">
            <span class="eyebrow-tag">HEAD-TO-HEAD SELECTOR</span>
            <h3>Model Selector & Comparator</h3>
            <p>Select any two models to update both table metrics and the spider graph in real time.</p>
          </div>

          <div class="selector-row">
            <div class="select-box">
              <label for="modelSelectA">Model A (Blue Shape)</label>
              <select id="modelSelectA">
                <option value="gemini-3-1-pro" selected>Gemini 3.1 Pro</option>
                <option value="claude-opus-5">Claude Opus 5</option>
                <option value="gpt-5-6-sol">GPT-5.6 Sol</option>
                <option value="kimi-k3-moe">Next-Gen Open Weight MoE</option>
              </select>
            </div>

            <div class="vs-badge">VS</div>

            <div class="select-box">
              <label for="modelSelectB">Model B (Gold Shape)</label>
              <select id="modelSelectB">
                <option value="claude-opus-5" selected>Claude Opus 5</option>
                <option value="gemini-3-1-pro">Gemini 3.1 Pro</option>
                <option value="gpt-5-6-sol">GPT-5.6 Sol</option>
                <option value="kimi-k3-moe">Next-Gen Open Weight MoE</option>
              </select>
            </div>
          </div>

          <!-- Dynamic Comparison Results -->
          <div class="comparison-results" id="compResults">
            <div class="comp-metric-row">
              <span class="comp-label">SWE-bench (Coding)</span>
              <div class="comp-vals">
                <span class="val-a" id="sweValA">95.0%</span>
                <span class="val-b" id="sweValB">83.0%</span>
              </div>
            </div>

            <div class="comp-metric-row">
              <span class="comp-label">GDPval-AA Elo</span>
              <div class="comp-vals">
                <span class="val-a" id="gdpValA">1890 Elo</span>
                <span class="val-b" id="gdpValB">1861 Elo</span>
              </div>
            </div>

            <div class="comp-metric-row">
              <span class="comp-label">ARC-AGI-3 (Spatial)</span>
              <div class="comp-vals">
                <span class="val-a" id="arcValA">32.0%</span>
                <span class="val-b" id="arcValB">30.2%</span>
              </div>
            </div>

            <div class="comp-metric-row">
              <span class="comp-label">Context Window</span>
              <div class="comp-vals">
                <span class="val-a" id="contextValA">2.0M tokens</span>
                <span class="val-b" id="contextValB">1.0M tokens</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Model Comparison Table with Explainer Modals -->
  <section class="section">
    <div class="container">
      <div class="section-title-box">
        <span class="eyebrow-tag">CLICK ANY BENCHMARK FOR EXPLAINER</span>
        <h2>Gen 4 Frontier Model Benchmark Matrix</h2>
        <p>Click on any column header (<button class="inline-explainer-btn" data-explainer="swe">SWE-bench</button>, <button class="inline-explainer-btn" data-explainer="gdp">GDPval Elo</button>, <button class="inline-explainer-btn" data-explainer="arc">ARC-AGI-3</button>) to view methodology details.</p>
      </div>

      <div class="table-card">
        <table class="benchmark-table">
          <thead>
            <tr>
              <th>Model Name</th>
              <th>Developer</th>
              <th>Architecture</th>
              <th>Context Window</th>
              <th class="clickable-th" data-explainer="swe">SWE-bench ℹ️</th>
              <th class="clickable-th" data-explainer="gdp">GDPval Elo ℹ️</th>
              <th class="clickable-th" data-explainer="arc">ARC-AGI-3 ℹ️</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {modelsData.map((m) => (
              <tr class={m.sweBench && m.sweBench >= 90 ? "highlight-row" : ""}>
                <td><strong>{m.name}</strong></td>
                <td>{m.developer}</td>
                <td>{m.architecture}</td>
                <td>{m.contextWindow}</td>
                <td>{m.sweBench ? <span class="score-badge high">{m.sweBench}%</span> : 'N/A'}</td>
                <td>{m.gdpValElo ? <span class="score-badge high">{m.gdpValElo} Elo</span> : 'N/A'}</td>
                <td>{m.arcAgi3 ? `${m.arcAgi3}%` : 'N/A'}</td>
                <td><span class="status-badge">{m.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Full PowerPoint Slide Deck Lightbox Inspector (All 15 Slides) -->
  <section class="section">
    <div class="container">
      <div class="section-title-box">
        <span class="eyebrow-tag">SLIDE INSPECTOR (15 SLIDES)</span>
        <h2>Frontier Model Architecture & Agentic Economics Deck Inspector</h2>
        <p>Click any slide to open the high-resolution lightbox inspector with slide details and OCR text breakdown.</p>
      </div>

      <div class="slide-gallery">
        {frontierSlides.map((slide) => (
          <div class="slide-card" data-img={slide.img} data-title={slide.title} data-text={slide.text} data-num={slide.id}>
            <div class="slide-img-wrapper">
              <img src={slide.img} alt={slide.title} loading="lazy" />
              <div class="expand-overlay">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                <span>Expand Slide</span>
              </div>
            </div>
            <div class="slide-caption">
              <span class="slide-num">SLIDE {slide.id < 10 ? `0${slide.id}` : slide.id} // 15</span>
              <h4>{slide.title}</h4>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Sparse MoE & KV Cache Topology Calculator -->
  <section class="section">
    <div class="container">
      <div class="calculator-panel">
        <div class="panel-header">
          <span class="eyebrow-tag">ARCHITECTURAL SIMULATOR</span>
          <h2>Sparse MoE & KV Cache Topology Calculator</h2>
          <p>Adjust MoE expert count and attention type to simulate FLOP savings and VRAM footprint reductions.</p>
        </div>

        <div class="calc-grid">
          <div class="calc-inputs">
            <div class="input-group">
              <label for="moeTotalParams">Total Parameters (Billion): <span id="moeTotalVal" class="val-num">2,800B (2.8T)</span></label>
              <input type="range" id="moeTotalParams" min="100" max="3000" step="100" value="2800" />
            </div>

            <div class="input-group">
              <label for="moeExperts">Total Experts: <span id="moeExpertVal" class="val-num">896 experts</span></label>
              <input type="range" id="moeExperts" min="8" max="1024" step="8" value="896" />
            </div>

            <div class="input-group">
              <label for="moeActive">Active Experts per Token: <span id="moeActiveVal" class="val-num">16 active</span></label>
              <input type="range" id="moeActive" min="1" max="32" step="1" value="16" />
            </div>
          </div>

          <div class="calc-results">
            <div class="res-card">
              <span class="res-label">ACTIVE PARAMETER COMPUTE</span>
              <span class="res-val" id="resActiveParams">50.0B Params</span>
              <span class="res-sub">Compute cost per generated token</span>
            </div>

            <div class="res-card">
              <span class="res-label">PER-TOKEN FLOP SAVINGS</span>
              <span class="res-val highlight" id="resFlopSavings">75.0% FLOP Reduction</span>
              <span class="res-sub">Versus dense equivalent training</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benchmark Explainer Modal -->
  <div id="explainerModal" class="modal-overlay" aria-hidden="true">
    <div class="modal-content explainer-modal-content">
      <button id="explainerClose" class="modal-close-btn">&times;</button>
      <div class="explainer-inner">
        <span id="expSubtitle" class="modal-num">BENCHMARK METHODOLOGY</span>
        <h2 id="expTitle" class="modal-title">Benchmark Explainer</h2>
        <div class="exp-body">
          <div class="exp-section">
            <h4>What It Evaluates</h4>
            <p id="expDesc">Description</p>
          </div>
          <div class="exp-section">
            <h4>Why It Matters Over Legacy Tests</h4>
            <p id="expWhy">Why it matters</p>
          </div>
          <div class="exp-section">
            <h4>SOTA Leaderboard Benchmarks</h4>
            <p id="expSota" class="sota-highlight">SOTA scores</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox Slide Modal -->
  <div id="slideModal" class="modal-overlay" aria-hidden="true">
    <div class="modal-content">
      <button id="modalClose" class="modal-close-btn">&times;</button>
      <div class="modal-grid">
        <div class="modal-img-container">
          <img id="modalImg" src="" alt="Slide Detail" />
        </div>
        <div class="modal-info">
          <span id="modalNum" class="modal-num">SLIDE 01 // 15</span>
          <h3 id="modalTitle" class="modal-title">Slide Title</h3>
          <p id="modalText" class="modal-text">Slide description and OCR text breakdown.</p>

          <div class="modal-controls">
            <button id="prevSlideBtn" class="modal-nav-btn">← Previous</button>
            <button id="nextSlideBtn" class="modal-nav-btn">Next →</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .back-link { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; color: #2563eb; text-decoration: none; display: inline-block; margin-bottom: 0.5rem; }
    .eyebrow-tag { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--gold-hot); letter-spacing: 0.1em; display: block; margin-bottom: 0.2rem; }
    .section-title-box h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--text); margin: 0 0 0.2rem 0; }
    .section-title-box p { color: var(--text-muted); font-size: 0.88rem; margin: 0 0 1rem 0; }

    .section { padding: 0.75rem 0; }

    /* Comparison Grid */
    .comp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem; }
    @media (max-width: 900px) { .comp-grid { grid-template-columns: 1fr; } }
    .comp-card { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 14px; padding: 1.15rem; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03); }
    
    .radar-box { position: relative; width: 100%; display: flex; flex-direction: column; align-items: center; }
    .radar-svg { width: 100%; max-width: 320px; height: auto; }
    .radar-grid-line { fill: none; stroke: rgba(15, 23, 42, 0.1); stroke-width: 1.5; }
    .radar-grid-line.inner { stroke: rgba(15, 23, 42, 0.06); stroke-dasharray: 4,4; }
    .radar-axis { stroke: rgba(15, 23, 42, 0.1); stroke-width: 1; }
    .radar-label { font-family: var(--font-mono); font-size: 10px; font-weight: 700; fill: #475569; }
    .radar-poly { transition: all 0.4s var(--ease); }
    .radar-poly.gemini { fill: rgba(37, 99, 235, 0.25); stroke: #2563eb; stroke-width: 2.5; }
    .radar-poly.opus { fill: rgba(217, 119, 6, 0.25); stroke: #d97706; stroke-width: 2.5; }

    .radar-legend { display: flex; gap: 1rem; margin-top: 0.5rem; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; }
    .legend-item { display: flex; align-items: center; gap: 0.35rem; color: var(--text); }
    .legend-dot { width: 8px; height: 8px; border-radius: 50%; }
    .legend-item.gemini .legend-dot { background: #2563eb; }
    .legend-item.opus .legend-dot { background: #d97706; }

    /* Model Comparator */
    .selector-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }
    .select-box { flex: 1; }
    .select-box label { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--text-faint); display: block; margin-bottom: 0.15rem; }
    .select-box select { width: 100%; padding: 0.4rem 0.5rem; border-radius: 6px; border: 1px solid rgba(15, 23, 42, 0.15); font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600; background: white; }
    .vs-badge { font-family: var(--font-mono); font-weight: 800; font-size: 0.72rem; color: #2563eb; background: rgba(37, 99, 235, 0.08); padding: 0.2rem 0.45rem; border-radius: 4px; }

    .comparison-results { display: flex; flex-direction: column; gap: 0.45rem; }
    .comp-metric-row { display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0.75rem; background: rgba(15, 23, 42, 0.03); border-radius: 6px; }
    .comp-label { font-size: 0.82rem; font-weight: 600; color: var(--text-muted); }
    .comp-vals { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; display: flex; gap: 1rem; }
    .val-a { color: #2563eb; }
    .val-b { color: #d97706; }

    /* Explainer Buttons & Clickable TH */
    .inline-explainer-btn { background: rgba(37, 99, 235, 0.08); border: 1px solid rgba(37, 99, 235, 0.2); color: #2563eb; padding: 0.15rem 0.45rem; border-radius: 4px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; cursor: pointer; }
    .clickable-th { cursor: pointer; transition: background 0.2s var(--ease); }
    .clickable-th:hover { background: rgba(37, 99, 235, 0.1) !important; color: #2563eb !important; }

    /* Calculator Panel */
    .calculator-panel { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 14px; padding: 1.15rem 1.35rem; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03); margin-bottom: 1.25rem; }
    .calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: center; }
    @media (max-width: 850px) { .calc-grid { grid-template-columns: 1fr; gap: 1rem; } }
    .input-group { margin-bottom: 0.75rem; }
    .input-group label { font-size: 0.82rem; font-weight: 600; color: var(--text); display: flex; justify-content: space-between; margin-bottom: 0.2rem; }
    .val-num { font-family: var(--font-mono); color: #2563eb; font-weight: 700; }
    .input-group input[type="range"] { width: 100%; accent-color: #2563eb; }

    .calc-results { display: flex; flex-direction: column; gap: 0.5rem; }
    .res-card { background: rgba(15, 23, 42, 0.03); border-radius: 8px; padding: 0.75rem 0.85rem; }
    .res-label { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--text-faint); }
    .res-val { font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; color: var(--text); margin: 0.05rem 0; }
    .res-val.highlight { color: #2563eb; }
    .res-sub { font-size: 0.78rem; color: var(--text-muted); }

    /* Table & Gallery */
    .table-card { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 14px; overflow-x: auto; box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03); margin-bottom: 1.25rem; }
    .benchmark-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem; }
    .benchmark-table th, .benchmark-table td { padding: 0.7rem 1rem; border-bottom: 1px solid rgba(15, 23, 42, 0.06); }
    .benchmark-table th { background: rgba(15, 23, 42, 0.03); font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-faint); }
    .highlight-row { background: rgba(37, 99, 235, 0.04); }
    .score-badge { font-family: var(--font-mono); font-weight: 700; padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.75rem; }
    .score-badge.high { background: rgba(37, 99, 235, 0.1); color: #2563eb; }
    .status-badge { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-faint); background: rgba(15, 23, 42, 0.05); padding: 0.15rem 0.4rem; border-radius: 4px; }

    .slide-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
    @media (max-width: 900px) { .slide-gallery { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .slide-gallery { grid-template-columns: 1fr; } }

    .slide-card { background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.9); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.02); cursor: pointer; transition: transform 0.2s var(--ease); }
    .slide-card:hover { transform: translateY(-2px); border-color: rgba(37, 99, 235, 0.4); }
    .slide-img-wrapper { aspect-ratio: 16/9; background: #0f172a; position: relative; overflow: hidden; }
    .slide-img-wrapper img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .expand-overlay { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.65); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem; color: white; opacity: 0; transition: opacity 0.2s var(--ease); font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; }
    .slide-card:hover .expand-overlay { opacity: 1; }
    .slide-caption { padding: 0.75rem 0.85rem; }
    .slide-num { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: #2563eb; }
    .slide-caption h4 { font-family: var(--font-display); font-size: 0.88rem; font-weight: 700; color: var(--text); margin: 0.1rem 0 0 0; }

    /* Modals */
    .modal-overlay { position: fixed; inset: 0; z-index: 9999; background: rgba(15, 23, 42, 0.92); backdrop-filter: blur(16px); display: none; align-items: center; justify-content: center; padding: 1.5rem; }
    .modal-overlay.active { display: flex; }
    .modal-content { background: #0f172a; border-radius: 20px; max-width: 95vw; width: 1400px; max-height: 92vh; height: 90vh; overflow: hidden; position: relative; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7); border: 1px solid rgba(255, 255, 255, 0.1); }
    
    .explainer-modal-content { background: white; max-width: 700px; height: auto; max-height: 85vh; padding: 2.5rem; overflow-y: auto; }
    .explainer-inner { display: flex; flex-direction: column; gap: 1rem; }
    .exp-body { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1rem; }
    .exp-section h4 { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; color: #2563eb; text-transform: uppercase; margin: 0 0 0.35rem 0; }
    .exp-section p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin: 0; }
    .sota-highlight { background: rgba(37, 99, 235, 0.06); padding: 0.85rem; border-radius: 8px; border-left: 3px solid #2563eb; color: var(--text) !important; font-family: var(--font-mono); font-size: 0.88rem !important; }

    .modal-close-btn { position: absolute; top: 1rem; right: 1.5rem; font-size: 2.5rem; border: none; background: rgba(255, 255, 255, 0.1); color: #f8fafc; border-radius: 50%; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 20; line-height: 1; transition: background 0.2s var(--ease); }
    .explainer-modal-content .modal-close-btn { color: #475569; background: rgba(15, 23, 42, 0.05); }
    .modal-close-btn:hover { background: #2563eb; color: white; }

    .modal-grid { display: grid; grid-template-columns: 2.5fr 1fr; height: 100%; }
    @media (max-width: 950px) { .modal-grid { grid-template-columns: 1fr; overflow-y: auto; } }
    .modal-img-container { background: #020617; display: flex; align-items: center; justify-content: center; padding: 1.5rem; height: 100%; overflow: hidden; }
    .modal-img-container img { max-width: 100%; max-height: 85vh; width: 100%; object-fit: contain; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .modal-info { padding: 2.5rem 2rem; display: flex; flex-direction: column; justify-content: space-between; background: #0f172a; border-left: 1px solid rgba(255, 255, 255, 0.08); height: 100%; overflow-y: auto; }
    .modal-num { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; color: #3b82f6; }
    .modal-title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: #f8fafc; margin: 0.5rem 0 1rem 0; line-height: 1.3; }
    .explainer-modal-content .modal-title { color: var(--text); }
    .modal-text { color: #94a3b8; font-size: 0.95rem; line-height: 1.65; margin-bottom: 2rem; }

    .modal-controls { display: flex; gap: 1rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.08); }
    .modal-nav-btn { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); padding: 0.85rem 1.25rem; border-radius: 10px; font-family: var(--font-mono); font-size: 0.88rem; font-weight: 700; color: #f8fafc; cursor: pointer; transition: all 0.2s var(--ease); flex: 1; }
    .modal-nav-btn:hover { background: #2563eb; color: white; border-color: #2563eb; }
  </style>

  <script is:raw>
    // Benchmark Explainer Modal
    const explainersData = {
      swe: {
        title: "SWE-bench & DeepSWE (Autonomous Repo Coding)",
        subtitle: "Long-Horizon Software Engineering Benchmark",
        description: "SWE-bench evaluates AI models on resolving real-world GitHub issues across complex open-source repositories. Models are provided an issue description and full codebase access, requiring them to search files, edit code, run unit tests, and generate passing patches autonomously.",
        why: "Replaces single-function code generation (HumanEval) with real-world multi-file repo navigation, long-horizon planning, and tool execution.",
        sota: "Gemini 3.1 Pro (95.0%), GPT-5.6 Sol (86.5%), Claude 3.7 Sonnet (85.2%), Claude Fable 5 (84.0%), Claude Opus 5 (83.0%), Next-Gen Open Weight MoE (81.5%)."
      },
      gdp: {
        title: "GDPval-AA v2 (Knowledge Work Blind Elo)",
        subtitle: "Real-World Corporate Workflow Evaluation",
        description: "Evaluates models on complex multi-modal knowledge work tasks derived from real corporate workflows (financial modeling, legal policy analysis, medical diagnostics, strategic pitch decks). Scored via double-blind human expert Elo pairing.",
        why: "Eliminates multiple-choice memorization by testing deep synthesis quality, domain nuance, and strategic clarity.",
        sota: "Gemini 3.1 Pro (1890 Elo), Claude Opus 5 (1861 Elo), Claude 3.7 Sonnet (1850 Elo), GPT-5.6 Sol (1845 Elo), Claude Fable 5 (1820 Elo)."
      },
      arc: {
        title: "ARC-AGI-3 (Abstraction & Spatial Reasoning)",
        subtitle: "Zero-Shot Out-of-Distribution Novelty",
        description: "Evaluates novel spatial reasoning and problem solving using visual grid transformation puzzles designed specifically to prevent pre-training memorization.",
        why: "Serves as the primary benchmark for fluid intelligence and zero-shot adaptation to unseen logic rules.",
        sota: "Gemini 3.1 Pro (32.0%), Claude Opus 5 (30.2%), GPT-5.6 Sol (29.1%), Claude Fable 5 (28.5%), Next-Gen Open Weight MoE (26.8%)."
      }
    };

    const expModal = document.getElementById('explainerModal');
    const expClose = document.getElementById('explainerClose');
    const expTitle = document.getElementById('expTitle');
    const expSubtitle = document.getElementById('expSubtitle');
    const expDesc = document.getElementById('expDesc');
    const expWhy = document.getElementById('expWhy');
    const expSota = document.getElementById('expSota');

    function openExplainer(key) {
      const data = explainersData[key];
      if (!data || !expModal) return;
      if (expTitle) expTitle.textContent = data.title;
      if (expSubtitle) expSubtitle.textContent = data.subtitle;
      if (expDesc) expDesc.textContent = data.description;
      if (expWhy) expWhy.textContent = data.why;
      if (expSota) expSota.textContent = data.sota;
      expModal.classList.add('active');
    }

    document.querySelectorAll('.clickable-th, .inline-explainer-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const key = btn.getAttribute('data-explainer');
        if (key) openExplainer(key);
      });
    });

    expClose?.addEventListener('click', () => expModal?.classList.remove('active'));
    expModal?.addEventListener('click', (e) => { if (e.target === expModal) expModal.classList.remove('active'); });

    // Dynamic Models & Linked Radar Chart System
    const rawModels = [
      {
        id: "gemini-3-1-pro",
        name: "Gemini 3.1 Pro",
        swe: "95.0%", gdp: "1890 Elo", arc: "32.0%", context: "2.0M tokens",
        scores: [0.95, 0.95, 0.95, 1.00, 0.85, 0.90]
      },
      {
        id: "claude-opus-5",
        name: "Claude Opus 5",
        swe: "83.0%", gdp: "1861 Elo", arc: "30.2%", context: "1.0M tokens",
        scores: [0.83, 0.88, 0.88, 0.70, 0.50, 0.60]
      },
      {
        id: "gpt-5-6-sol",
        name: "GPT-5.6 Sol",
        swe: "86.5%", gdp: "1845 Elo", arc: "29.1%", context: "1.0M tokens",
        scores: [0.865, 0.84, 0.84, 0.70, 0.75, 0.60]
      },
      {
        id: "kimi-k3-moe",
        name: "Next-Gen Open Weight MoE",
        swe: "81.5%", gdp: "1790 Elo", arc: "26.8%", context: "2.0M tokens",
        scores: [0.815, 0.75, 0.75, 1.00, 0.30, 0.85]
      }
    ];

    function calculateRadarPoints(scores) {
      const cx = 200, cy = 190, r = 150;
      const angles = [
        -Math.PI / 2,
        -Math.PI / 6,
        Math.PI / 6,
        Math.PI / 2,
        (5 * Math.PI) / 6,
        (-5 * Math.PI) / 6
      ];

      return scores.map((s, i) => {
        const rad = r * s;
        const x = cx + rad * Math.cos(angles[i]);
        const y = cy + rad * Math.sin(angles[i]);
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      }).join(' ');
    }

    const selA = document.getElementById('modelSelectA');
    const selB = document.getElementById('modelSelectB');
    const polyA = document.getElementById('polyA');
    const polyB = document.getElementById('polyB');
    const legendA = document.getElementById('legendNameA');
    const legendB = document.getElementById('legendNameB');

    function updateComparator() {
      const mA = rawModels.find(m => m.id === selA.value) || rawModels[0];
      const mB = rawModels.find(m => m.id === selB.value) || rawModels[1];

      document.getElementById('sweValA').textContent = mA.swe;
      document.getElementById('sweValB').textContent = mB.swe;
      document.getElementById('gdpValA').textContent = mA.gdp;
      document.getElementById('gdpValB').textContent = mB.gdp;
      document.getElementById('arcValA').textContent = mA.arc;
      document.getElementById('arcValB').textContent = mB.arc;
      document.getElementById('contextValA').textContent = mA.context;
      document.getElementById('contextValB').textContent = mB.context;

      if (polyA) polyA.setAttribute('points', calculateRadarPoints(mA.scores));
      if (polyB) polyB.setAttribute('points', calculateRadarPoints(mB.scores));
      if (legendA) legendA.textContent = `${mA.name} (Model A)`;
      if (legendB) legendB.textContent = `${mB.name} (Model B)`;
    }

    selA?.addEventListener('change', updateComparator);
    selB?.addEventListener('change', updateComparator);

    updateComparator();

    // MoE Calculator Logic
    const moeParams = document.getElementById('moeTotalParams');
    const moeExp = document.getElementById('moeExperts');
    const moeAct = document.getElementById('moeActive');

    function updateMoeCalc() {
      const totalB = parseInt(moeParams.value);
      const expCount = parseInt(moeExp.value);
      const activeCount = parseInt(moeAct.value);

      document.getElementById('moeTotalVal').textContent = `${totalB}B (${(totalB/1000).toFixed(1)}T)`;
      document.getElementById('moeExpertVal').textContent = `${expCount} experts`;
      document.getElementById('moeActiveVal').textContent = `${activeCount} active`;

      const activeParams = ((totalB / expCount) * activeCount).toFixed(1);
      const flopRed = (((totalB - activeParams) / totalB) * 100).toFixed(1);

      document.getElementById('resActiveParams').textContent = `${activeParams}B Params`;
      document.getElementById('resFlopSavings').textContent = `${flopRed}% FLOP Reduction`;
    }

    moeParams?.addEventListener('input', updateMoeCalc);
    moeExp?.addEventListener('input', updateMoeCalc);
    moeAct?.addEventListener('input', updateMoeCalc);

    // Slide Lightbox Script
    const cards = document.querySelectorAll('.slide-card');
    const slideModal = document.getElementById('slideModal');
    const modalImg = document.getElementById('modalImg');
    const modalNum = document.getElementById('modalNum');
    const modalTitle = document.getElementById('modalTitle');
    const modalText = document.getElementById('modalText');
    const modalClose = document.getElementById('modalClose');
    const prevBtn = document.getElementById('prevSlideBtn');
    const nextBtn = document.getElementById('nextSlideBtn');

    let currentIndex = 0;

    function openSlide(index) {
      if (!cards[index] || !slideModal) return;
      currentIndex = index;
      const card = cards[index];

      const img = card.getAttribute('data-img') || '';
      const title = card.getAttribute('data-title') || '';
      const text = card.getAttribute('data-text') || '';
      const num = card.getAttribute('data-num') || '';

      if (modalImg) modalImg.src = img;
      if (modalNum) modalNum.textContent = `SLIDE ${parseInt(num) < 10 ? '0' + num : num} // ${cards.length}`;
      if (modalTitle) modalTitle.textContent = title;
      if (modalText) modalText.textContent = text;

      slideModal.classList.add('active');
    }

    cards.forEach((card, idx) => { card.addEventListener('click', () => openSlide(idx)); });
    modalClose?.addEventListener('click', () => slideModal?.classList.remove('active'));
    slideModal?.addEventListener('click', (e) => { if (e.target === slideModal) slideModal.classList.remove('active'); });

    prevBtn?.addEventListener('click', () => { openSlide((currentIndex - 1 + cards.length) % cards.length); });
    nextBtn?.addEventListener('click', () => { openSlide((currentIndex + 1) % cards.length); });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { slideModal?.classList.remove('active'); expModal?.classList.remove('active'); }
      if (slideModal?.classList.contains('active')) {
        if (e.key === 'ArrowLeft') prevBtn?.click();
        if (e.key === 'ArrowRight') nextBtn?.click();
      }
    });
  </script>
</Layout>
