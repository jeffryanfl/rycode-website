---
import '../styles/global.css';
import HeaderBannerNav from '../components/HeaderBannerNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Rycode — Independent Technology & Systems Journal",
  description = "A clean, editorial intelligence journal covering frontier AI architectures, web development, and governance systems.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('og-image.png', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageURL} />
  <link rel="canonical" href={canonicalURL} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <!-- Typography is self-hosted via global.css @font-face (public/fonts). -->
</head>
<body>
  <a class="skip-link" href="#mainContent">Skip to content</a>

  <div class="editorial-shell">
    <!-- TOP MASTHEAD WITH BROADSHEET BANNER NAV -->
    <header class="masthead">
      <div class="masthead-brand">
        <a href="/" class="masthead-logo-link" aria-label="Rycode Home">
          <img src="/logo.svg" alt="Rycode" class="masthead-logo-img" />
        </a>
      </div>

      <!-- NEWSPAPER HEADLINE BANNER NAV -->
      <HeaderBannerNav />
    </header>

    <!-- MAIN EDITORIAL CONTENT -->
    <main id="mainContent" class="editorial-main-content" tabindex="-1">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="editorial-footer">
      <div class="editorial-footer-inner">
        <span>© {new Date().getFullYear()} Rycode · Independent Technology & Systems Journal</span>
      </div>
    </footer>
  </div>
</body>
</html>
