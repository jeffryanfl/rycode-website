---
import '../styles/global.css';
import HeaderBannerNav from '../components/HeaderBannerNav.astro';

interface Props {
  title?: string;
  description?: string;
  variant?: "journal" | "landing" | "newspaper" | "research" | "tools";
}

const {
  title = "Rycode — Systems, tools, and research",
  description = "Systems, tools, and research.",
  variant = "journal",
} = Astro.props;

const isLanding = variant === "landing";
const isNewspaper = variant === "newspaper";
const isResearch = variant === "research";
const isTools = variant === "tools";
const isDark = isLanding || isNewspaper || isResearch || isTools;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('og-image.png', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="color-scheme" content={isDark ? "dark" : "light"} />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageURL} />
  <link rel="canonical" href={canonicalURL} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <!-- Typography is self-hosted via global.css @font-face (public/fonts). -->
</head>
<body>
  <a class="skip-link" href="#mainContent">Skip to content</a>

  <div class:list={["editorial-shell", { "editorial-shell--landing": isLanding, "editorial-shell--newspaper": isNewspaper, "editorial-shell--research": isResearch, "editorial-shell--tools": isTools }]}>
    <!-- TOP MASTHEAD WITH BROADSHEET BANNER NAV (banner skipped on landing, newspaper, research, and tools) -->
    <header class:list={["masthead", { "masthead--landing": isLanding, "masthead--newspaper": isNewspaper, "masthead--research": isResearch, "masthead--tools": isTools }]}>
      {isResearch ? (
        <>
          <div class="masthead-brand">
            <slot name="research-identity">
              <a href="/research" class="research-identity">
                <svg class="research-glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="10.2" cy="10.2" r="6.2" stroke="currentColor" stroke-width="1" />
                  <path d="M14.7 14.7 L20.2 20.2" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
                </svg>
                Research
              </a>
            </slot>
          </div>
          <a href="/" class="research-mark" aria-label="Rycode Home">
            <svg viewBox="0 0 56 56" fill="none" aria-hidden="true">
              <rect x="1" y="1" width="54" height="54" stroke="currentColor" stroke-width="1" />
              <text x="9" y="19" fill="currentColor" font-family="Inter, sans-serif" font-size="11" font-weight="500">26</text>
              <text x="28" y="44" text-anchor="middle" fill="currentColor" font-family="Inter, sans-serif" font-size="20" font-weight="650">Ry</text>
            </svg>
          </a>
        </>
      ) : isTools ? (
        <>
          <div class="masthead-brand">
            <slot name="tools-identity">
              <a href="/tools" class="tools-identity">
                <span class="tools-caliper" aria-hidden="true"></span>
                Tools
              </a>
            </slot>
          </div>
          <a href="/" class="tools-mark" aria-label="Rycode Home">
            <svg viewBox="0 0 56 56" fill="none" aria-hidden="true">
              <rect x="1" y="1" width="54" height="54" stroke="currentColor" stroke-width="1" />
              <text x="9" y="19" fill="currentColor" font-family="Inter, sans-serif" font-size="11" font-weight="500">26</text>
              <text x="28" y="44" text-anchor="middle" fill="currentColor" font-family="Inter, sans-serif" font-size="20" font-weight="650">Ry</text>
            </svg>
          </a>
        </>
      ) : (
        <>
          <div class="masthead-brand">
            <a href="/" class="masthead-logo-link" aria-label="Rycode Home">
              <img src="/logo.svg" alt="Rycode" class="masthead-logo-img" />
              {isNewspaper && <span class="masthead-wordmark">Rycode</span>}
            </a>
          </div>

          {isNewspaper && <p class="masthead-updated">Last updated Aug 2026</p>}

          {!isLanding && !isNewspaper && <HeaderBannerNav />}
        </>
      )}
    </header>

    <!-- MAIN EDITORIAL CONTENT -->
    <main id="mainContent" class="editorial-main-content" tabindex="-1">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="editorial-footer">
      <div class="editorial-footer-inner">
        <span>© {new Date().getFullYear()} Rycode</span>
      </div>
    </footer>
  </div>
</body>
</html>
