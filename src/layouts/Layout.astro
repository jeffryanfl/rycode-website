---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ArticleTop from '../components/ArticleTop.astro';
import ArticleTail from '../components/ArticleTail.astro';
import { articleNav, normalizePath, ogImageFor } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  variant?: "journal" | "landing" | "risk" | "ai" | "economics";
}

const {
  title = "Rycode — Economics, risk, and systems",
  description = "Economics, risk, and systems.",
  variant = "journal",
} = Astro.props;

const isLanding = variant === "landing";
const isRisk = variant === "risk";
const isAi = variant === "ai";
const isEconomics = variant === "economics";
const isDark = true;
const pathname = normalizePath(Astro.url.pathname);
const isHome = pathname === "/";
const showSectionMark = isRisk || isAi || isEconomics;
const piece = articleNav(pathname);

const canonicalURL = new URL(pathname, Astro.site);
const ogImageURL = new URL(ogImageFor(pathname), Astro.site);
const rssURL = new URL("/rss.xml", Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="color-scheme" content={isDark ? "dark" : "light"} />
  <meta name="generator" content={Astro.generator} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Rycode" />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <link rel="canonical" href={canonicalURL} />
  {isHome && <link rel="alternate" type="application/rss+xml" title="Rycode articles" href={rssURL} />}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#mainContent">Skip to content</a>

  <div class:list={["editorial-shell", { "editorial-shell--landing": isLanding, "editorial-shell--risk": isRisk, "editorial-shell--ai": isAi, "editorial-shell--economics": isEconomics }]}>
    <header class:list={["masthead", { "masthead--landing": isLanding, "masthead--risk": isRisk, "masthead--ai": isAi, "masthead--economics": isEconomics }]}>
      <div class="masthead-brand">
        {isRisk ? (
          <slot name="risk-identity">
            <a href="/risk/" class="risk-identity">
              <img class="risk-glyph" src="/landing/hub-risk.webp" alt="" width="79" height="72" />
              Risk
            </a>
          </slot>
        ) : isAi ? (
          <slot name="ai-identity">
            <a href="/ai/" class="ai-identity">
              <img class="ai-glyph" src="/landing/hub-brain-overhead.webp" alt="" width="63" height="72" />
              A.I.
            </a>
          </slot>
        ) : isEconomics ? (
          <slot name="economics-identity">
            <a href="/economics/" class="economics-identity">
              <img class="economics-glyph" src="/landing/hub-economics.webp" alt="" width="81" height="72" />
              Economics
            </a>
          </slot>
        ) : (
          <BrandMark />
        )}
      </div>
      <SiteNav />
      {showSectionMark && <BrandMark class="section-mark" />}
    </header>

    <main id="mainContent" class="editorial-main-content" tabindex="-1">
      {piece && <ArticleTop nav={piece} />}
      <slot />
      {piece && (piece.article.series === 'economics' || piece.article.series === 'risk' || piece.article.series === 'ai-dive') && (
        <ArticleTail nav={piece} />
      )}
    </main>

    <footer class="editorial-footer">
      <div class="editorial-footer-inner">
        <SiteFooter />
      </div>
    </footer>
  </div>
</body>
</html>
