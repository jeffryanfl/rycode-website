---
import '../styles/global.css';
import HeaderBannerNav from '../components/HeaderBannerNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Rycode — Independent Technology & Systems Journal",
  description = "A clean, editorial intelligence journal covering frontier AI architectures, web development, and governance systems.",
} = Astro.props;

const formattedDate = new Date().toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>

  <!-- Typography: Newsreader, Merriweather, Inter, Geist Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..800;1,6..72,400..800&family=Frank+Ruhl+Libre:wght@700;800;900&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&family=Inter:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
  <a class="skip-link" href="#mainContent">Skip to content</a>

  <div class="editorial-shell">
    <!-- TOP MASTHEAD WITH BROADSHEET BANNER NAV -->
    <header class="masthead">
      <div class="masthead-brand">
        <a href="/" class="masthead-logo-link" aria-label="Rycode Home">
          <img src="/logo.svg" alt="Rycode" class="masthead-logo-img" />
        </a>
      </div>

      <!-- NEWSPAPER HEADLINE BANNER NAV -->
      <HeaderBannerNav />
    </header>

    <!-- MAIN EDITORIAL CONTENT -->
    <main id="mainContent" class="editorial-main-content" tabindex="-1">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="editorial-footer">
      <div class="editorial-footer-inner">
        <span>© {new Date().getFullYear()} Rycode · Independent Technology & Systems Journal</span>
      </div>
    </footer>
  </div>
</body>
</html>
