---
import Layout from '../layouts/Layout.astro';
import '../styles/landing.css';
import '../styles/hub.css';
---

<Layout
  title="Risk — Rycode"
  description="Tails and what actually breaks."
  variant="landing"
>
  <section class="landing-stage landing-stage--charcoal landing-stage--branch">
    <a href="/" class="hub-mark" aria-label="Rycode Home">
      <svg viewBox="0 0 56 56" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="54" height="54" stroke="currentColor" stroke-width="1" />
        <text x="9" y="19" fill="currentColor" font-size="11" font-weight="500">26</text>
        <text x="28" y="44" text-anchor="middle" fill="currentColor" font-size="20" font-weight="650">Ry</text>
      </svg>
    </a>

    <div class="hub-branch">
      <img class="hub-branch-mark" src="/landing/hub-risk.png" alt="" width="978" height="887" />
      <h1 class="hub-branch-name">Risk</h1>
      <p class="hub-branch-dek">Tails and what actually breaks. New pieces appear here as rows.</p>
    </div>
  </section>
</Layout>
