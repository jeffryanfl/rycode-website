---
import Layout from '../layouts/Layout.astro';
import '../styles/risk.css';

const pieces = [
  {
    href: '/risk/six-percent-that-stays/',
    title: 'Six percent that stays',
    dek: 'A 6 percent rate that lasts is the named tail.',
  },
];
---

<Layout
  title="Risk — Rycode"
  description="Tails and what actually breaks."
  variant="risk"
>
  <div slot="risk-identity" class="risk-identity-block">
    <h1 class="risk-identity">
      <img class="risk-glyph" src="/landing/hub-risk.png" alt="" width="978" height="887" />
      Risk
    </h1>
    <p class="risk-identity-dek">Tails and what actually breaks. New pieces appear here as rows.</p>
  </div>

  <h2 class="risk-section">Emerging risks</h2>
  <ul class="risk-index">
    {pieces.map((piece) => (
      <li>
        <a href={piece.href}>
          <span class="risk-index-title">{piece.title}</span>
          <span class="risk-index-dek">{piece.dek}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
