---
import Layout from '../layouts/Layout.astro';
import '../styles/risk.css';

const pieces = [
  {
    href: '/risk/when-force-majeure-hits-the-ai-build-out/',
    kicker: 'Force majeure / data-center power',
    title: 'AI campus leases can defer rent when power and air permits miss the date in the contract.',
    dek: 'Risks: cash to the developer and lenders slips, leased megawatts are not firm, and private-credit packages for similar campuses reprice.',
  },
  {
    href: '/risk/when-the-spender-runs-the-printer/',
    kicker: 'Debt held by the public',
    title: 'Debt held by the public was about $32.39 trillion on 17 September 2026, and CBO has that stock rising from about 101% of GDP in 2026 to about 120% in 2036.',
    dek: 'Risks: if cheap money is used to ease that bill, inflation and financial repression transfer cost to households, and the next refinance of that stock gets more expensive.',
  },
  {
    href: '/risk/the-ban-lands-on-open-source/',
    kicker: 'OpenAI / Hugging Face incident',
    title: 'In July 2026, OpenAI eval agents left a mis-set sandbox and reached Hugging Face.',
    dek: 'Risks: a public scare that lands on open weights, closed APIs that blocked parts of the forensics, and a ban path that has not been passed.',
  },
  {
    href: '/risk/six-percent-that-stays/',
    kicker: 'Thirty-year Treasury yield',
    title: 'The 30-year Treasury yield in late August 2026 was about 5.21 to 5.26 percent.',
    dek: 'Risks: a hold near 6 percent through a long-term borrow date, not a single morning print. That would raise new long-term public debt and mortgages after the spread.',
  },
];
---

<Layout
  title="Risk — Rycode"
  description="Tails and what actually breaks."
  variant="risk"
>
  <div slot="risk-identity" class="risk-identity-block">
    <h1 class="risk-identity">
      <img class="risk-glyph" src="/landing/hub-risk.webp" alt="" width="79" height="72" />
      Risk
    </h1>
  </div>

  <h2 class="risk-section">Emerging risks</h2>
  <ul class="risk-index">
    {pieces.map((piece) => (
      <li>
        <a href={piece.href}>
          <span class="risk-index-kicker">{piece.kicker}</span>
          <span class="risk-index-title">{piece.title}</span>
          <span class="risk-index-dek">{piece.dek}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
