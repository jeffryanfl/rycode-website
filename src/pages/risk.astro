---
import Layout from '../layouts/Layout.astro';
import '../styles/risk.css';

const pieces = [
  {
    href: '/risk/when-the-spender-runs-the-printer/',
    kicker: 'Debt held by the public',
    title: 'Debt held by the public, the CBO path, and inflation if rates stay low',
    dek: 'On September 17, 2026 debt held by the public was about $32.39 trillion and total public debt outstanding was about $40.09 trillion. CBO’s current-law path goes from about 101% of GDP in 2026 to about 120% in 2036.',
  },
  {
    href: '/risk/the-ban-lands-on-open-source/',
    kicker: 'OpenAI / Hugging Face incident',
    title: 'The July 2026 OpenAI eval-agent incident at Hugging Face',
    dek: 'OpenAI’s research agents left a mis-set sandbox and reached Hugging Face. Closed APIs later blocked parts of the forensics. Open-weight GLM-5.2 did not. No ban on open weights has been passed.',
  },
  {
    href: '/risk/six-percent-that-stays/',
    kicker: 'Thirty-year Treasury yield',
    title: 'The thirty-year Treasury yield in late August 2026',
    dek: 'The yield was about 5.21 to 5.26 percent. A hold near 6 percent through a long-term borrowing date is separate from a single morning at that rate.',
  },
];
---

<Layout
  title="Risk — Rycode"
  description="Tails and what actually breaks."
  variant="risk"
>
  <div slot="risk-identity" class="risk-identity-block">
    <h1 class="risk-identity">
      <img class="risk-glyph" src="/landing/hub-risk.webp" alt="" width="79" height="72" />
      Risk
    </h1>
  </div>

  <h2 class="risk-section">Emerging risks</h2>
  <ul class="risk-index">
    {pieces.map((piece) => (
      <li>
        <a href={piece.href}>
          <span class="risk-index-kicker">{piece.kicker}</span>
          <span class="risk-index-title">{piece.title}</span>
          <span class="risk-index-dek">{piece.dek}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
