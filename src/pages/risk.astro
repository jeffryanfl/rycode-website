---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import RiskWatchList from '../components/RiskWatchList.astro';
import cardRecords from '../data/risk-cards.json';
import { articles, formatDate, readingMinutes } from '../lib/site';
import { assertRiskCards } from '../lib/risk-card-drift.mjs';
import '../styles/risk.css';

assertRiskCards();

const byHref = new Map(articles.map((article) => [article.href, article]));

function titleFromArticleFile(file) {
  const raw = fs.readFileSync(path.join(process.cwd(), file), 'utf8');
  const match = raw.match(/const title = '([^']*)'/);
  if (!match) {
    throw new Error(`RISK CARD: no const title in ${file}`);
  }
  return match[1].replace(/\\'/g, "'");
}

const cards = cardRecords
  .map((record) => {
    const href = record.slug.endsWith('/') ? record.slug : `${record.slug}/`;
    const article = byHref.get(href);
    if (!article?.file || !article.date) {
      throw new Error(`RISK CARD: catalog is missing a date or file for ${href}`);
    }
    return {
      href,
      title: titleFromArticleFile(article.file),
      date: article.date,
      dateLabel: formatDate(article.date),
      minutes: article.minutes ?? readingMinutes(article.file),
      summary: record.summary,
      watch: record.watch,
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date) || a.href.localeCompare(b.href));
---

<Layout
  title="Risk — Rycode"
  description="Tails and what actually breaks."
  variant="risk"
>
  <div slot="risk-identity" class="risk-identity-block">
    <h1 class="risk-identity">
      <img class="risk-glyph" src="/landing/hub-risk.webp" alt="" width="79" height="72" />
      Risk
    </h1>
  </div>

  <RiskWatchList />

  <h2 class="risk-section">Emerging risks</h2>
  <ul class="risk-cards">
    {cards.map((card) => (
      <li class="risk-summary-card">
        <p class="risk-summary-meta">
          <time datetime={card.date}>{card.dateLabel}</time>
          <span aria-hidden="true"> · </span>
          <span>{card.minutes} min read</span>
        </p>
        <h3 class="risk-summary-title">
          <a href={card.href}>{card.title}</a>
        </h3>
        <p class="risk-summary-body">{card.summary}</p>
        <div class="risk-summary-watch">
          <p class="risk-summary-watch-label">Risk to watch</p>
          <p class="risk-summary-watch-line">{card.watch}</p>
        </div>
      </li>
    ))}
  </ul>
</Layout>
