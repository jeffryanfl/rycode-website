---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Web Development & Systems — Rycode Collections">
  <div class="editorial-container">
    <div class="editorial-main" style="grid-column: span 2;">
      <section class="subpage-hero">
        <p class="subpage-eyebrow">Collections · System Architecture</p>
        <h1 class="subpage-title">Web Development & Systems Engineering</h1>
        <p class="subpage-lead">
          Full-stack application architectures, vanilla CSS design systems, interactive browser explainers, and client-side performance models.
        </p>
        
        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
          <a href="/" class="read-more-link" style="font-size: 1rem;">← Return to Editorial Home</a>
          <a href="/ai" class="read-more-link" style="font-size: 1rem;">Explore AI Systems →</a>
        </div>
      </section>

      <section aria-labelledby="webHeading">
        <div class="article-grid-header">
          <h2 class="grid-section-title" id="webHeading">Interactive Systems & Architecture Specs</h2>
          <span class="meta-date">Active Modules</span>
        </div>

        <div class="article-grid">
          <!-- Module 1 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Systems Explainer</span>
              <h3 class="card-headline">
                <a href="/anatomy/deployment/index.html">Anatomy of a Deployment</a>
              </h3>
              <p class="card-snippet">
                A walkable visual map illustrating the client-server lifecycle, from local commit directories to edge CDN caching and browser paint cycles.
              </p>
            </div>
            <div class="card-bottom">
              <span>Interactive Map</span>
              <a href="/anatomy/deployment/index.html" class="read-more-link">Explore Map →</a>
            </div>
          </article>

          <!-- Module 2 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Physical Systems</span>
              <h3 class="card-headline">
                <a href="/anatomy/teller-ulam/index.html">Teller–Ulam Physics Scroller</a>
              </h3>
              <p class="card-snippet">
                A milliseconds-scale timeline scrubber outlining structural staging and physical sequences inside a thermonuclear reaction in interactive SVG.
              </p>
            </div>
            <div class="card-bottom">
              <span>Timeline Scrubber</span>
              <a href="/anatomy/teller-ulam/index.html" class="read-more-link">Open Scroller →</a>
            </div>
          </article>
        </div>
      </section>
    </div>
  </div>
</Layout>
