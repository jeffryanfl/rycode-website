---
import Layout from '../layouts/Layout.astro';
import LandingTiles from '../components/LandingTiles.astro';
import '../styles/landing.css';

const pieces = [
  {
    label: "Build vs. Buy",
    href: "/dashboards/build-vs-buy/",
    description: "Slide the inputs. Find the year building pays off.",
  },
  {
    label: "Control Effectiveness",
    href: "/dashboards/control-effectiveness/",
    description: "Slide control effectiveness and watch residual risk drop.",
  },
];
---

<Layout
  title="Tools — Rycode"
  description="Tools."
  variant="landing"
>
  <section class="landing-stage">
    <h1 class="landing-identity">Tools</h1>
    <LandingTiles items={pieces} />
  </section>
</Layout>
