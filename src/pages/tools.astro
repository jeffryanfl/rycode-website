---
import Layout from '../layouts/Layout.astro';
import HubList from '../components/HubList.astro';

const items = [
  {
    href: '/dashboards/build-vs-buy/',
    title: 'Build vs. Buy',
    description: 'An interactive calculator comparing the cost of building software vs. licensing SaaS over time.',
  },
  {
    href: '/dashboards/control-effectiveness/',
    title: 'Control Effectiveness & Residual Risk',
    description: 'An interactive ERM calculator. Select risks, assign controls, watch residual risk drop in real time.',
  },
  {
    href: '/dashboards/grocery-swap-calc/',
    title: 'Grocery Swap Calculator',
    description: 'Compare an existing SKU against a proposed replacement using penny profit, shrink, slotting, and cannibalization.',
  },
  {
    href: '/dashboards/vendor-concentration/',
    title: 'Vendor Concentration',
    description: 'Build a stack, take a vendor offline, see the blast radius.',
  },
  {
    href: '/lab/chat-builder/',
    title: 'Chat Builder',
    description: 'A WhatsApp-style chat mockup builder for storytelling and creative work.',
  },
];
---

<Layout title="Tools — Rycode Systems Journal" description="Interactive calculators, decision simulators, and systems dashboards.">
  <div class="writing-layout">
    <header class="lead-header">
      <h1 class="lead-title">
        Tools
      </h1>
      <p class="lead-subtitle">
        Calculators, quantitative models, and interactive utilities.
      </p>
    </header>
    <HubList items={items} />
  </div>
</Layout>
