---
import Layout from '../layouts/Layout.astro';
import '../styles/tools.css';

const pieces = [
  {
    href: '/dashboards/build-vs-buy/',
    label: 'Build vs. Buy',
    dek: 'Build it, or buy it.',
  },
  {
    href: '/dashboards/control-effectiveness/',
    label: 'Control Effectiveness',
    dek: 'How well a control actually works.',
  },
];
---

<Layout
  title="Tools — Rycode"
  description="Two calculators. Pick a job."
  variant="tools"
>
  <div slot="tools-identity" class="tools-identity-block">
    <h1 class="tools-identity">
      <span class="tools-caliper" aria-hidden="true"></span>
      Tools
    </h1>
    <p class="tools-identity-dek">Two calculators. Pick a job.</p>
  </div>

  <ul class="tools-index">
    {pieces.map((piece) => (
      <li>
        <a href={piece.href}>
          <span class="tools-index-title">{piece.label}</span>
          <span class="tools-index-dek">{piece.dek}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
