---
import LabTable from '../../../../components/LabTable.astro';
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/ai.css';

const current = [
  {
    href: '/ai/models/deepseek/flash/',
    title: 'Flash',
    dek: 'Current recommended API model. DeepSeek-V4.1-Flash-1017 (17 Oct 2026).',
    meta: ['deepseek-flash · 1M · lead card'],
  },
  {
    href: '/ai/models/deepseek/v4-pro/',
    title: 'V4 Pro',
    dek: 'Still listed on Models & Pricing. Service continues after 14 Sep 2026 (changelog).',
    meta: ['deepseek-v4-pro · DeepSeek-V4-Pro-0813'],
  },
  {
    href: '/ai/models/deepseek/thinking/',
    title: 'Thinking',
    dek: 'Dual thinking / non-thinking mode, shared across Flash and Pro.',
    meta: ['Default on · effort low / high / max'],
  },
  {
    href: '/ai/models/deepseek/api/',
    title: 'API',
    dek: 'Base URLs, current model ids, and retired aliases.',
    meta: ['api.deepseek.com · OpenAI and Anthropic formats'],
  },
];

const archive = [
  {
    href: '/ai/models/deepseek/r1/',
    title: 'R1',
    dek: 'Landmark open reasoner (Jan 2025). Not the current API SKU.',
    meta: ['Archive stub'],
  },
  {
    href: '/ai/models/deepseek/v3/',
    title: 'V3',
    dek: 'Prior chat generation. API name deepseek-chat is retired.',
    meta: ['Archive stub'],
  },
  {
    href: '/ai/models/deepseek/v4-1-flash/',
    title: 'V4.1-Flash (10 Sep)',
    dek: 'First V4.1-Flash. DeepSeek upgraded deepseek-flash to V4.1-Flash-1017 on 17 Oct 2026.',
    meta: ['Archive · weights still on Hugging Face'],
  },
];
---

<Layout
  title="DeepSeek - A.I. - Rycode"
  description="Current API line is V4: deepseek-flash and deepseek-v4-pro. R1 and V3 are archive doors."
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">DeepSeek</h1>
    <p class="ai-lab-dek">DeepSeek’s current API line is V4: call <code>deepseek-flash</code> (DeepSeek-V4.1-Flash-1017) or <code>deepseek-v4-pro</code>. Older names <code>deepseek-chat</code> and <code>deepseek-reasoner</code> were retired after 24 Jul 2026 UTC. R1, V3 and the 10 Sep V4.1-Flash are in the <a href="/ai/models/archive/">archive</a>.</p>
  </div>

  <LabTable rows={[...current, ...archive]} splitProducts />
</Layout>
