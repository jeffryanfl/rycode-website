---
import LabTable from '../../../../components/LabTable.astro';
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/ai.css';

const rows = [
  {
    href: '/ai/models/anthropic/claude-opus-5-5/',
    title: 'Claude Opus 5.5',
    dek: 'First Claude 5.5 model.',
    meta: ['1M · 128K · $4/$20 · adaptive · claude-opus-5-5'],
  },
  {
    href: '/ai/models/anthropic/claude-sonnet-5-5/',
    title: 'Claude Sonnet 5.5',
    dek: 'Second Claude 5.5 model.',
    meta: ['1M · 128K · $2/$10 · adaptive · claude-sonnet-5-5'],
  },
  {
    href: '/ai/models/anthropic/claude-haiku-5-5/',
    title: 'Claude Haiku 5.5',
    dek: 'Third Claude 5.5 model.',
    meta: ['1M · 128K · from $0.10/$0.50 · adaptive · claude-haiku-5-5'],
  },
  {
    href: '/ai/models/anthropic/claude-fable-5-1/',
    title: 'Claude Fable 5.1',
    dek: 'Most capable widely released.',
    meta: [
      '1M ctx · 128K out · $10/$50 · adaptive always on',
      'Mythos 5.1 = same, Glasswing only.',
      'Opens the Fable chassis →',
    ],
  },
  {
    href: '/ai/models/anthropic/claude-opus-5/',
    title: 'Claude Opus 5',
    dek: 'Default start.',
    meta: ['1M · 128K · $5/$25 · adaptive'],
  },
  {
    href: '/ai/models/anthropic/claude-sonnet-5/',
    title: 'Claude Sonnet 5',
    dek: 'Speed + intelligence.',
    meta: ['1M · 128K · $2/$10 · adaptive'],
  },
  {
    href: '/ai/models/anthropic/claude-haiku-4-5/',
    title: 'Claude Haiku 4.5',
    dek: 'Prior Haiku.',
    meta: ['200K · 64K · $1/$5 · extended thinking'],
  },
];
---

<Layout
  title="Anthropic - A.I. - Rycode"
  description="Claude frontier lineup"
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">Anthropic</h1>
    <p class="ai-lab-dek">Claude frontier lineup</p>
  </div>

  <LabTable rows={rows} />

  <h2 class="ai-lab-lane">Products and features</h2>
  <p class="ai-lab-note">Apps and agents from Anthropic. They run on Claude but are not API models.</p>
  <ul class="ai-lab-note">
    <li><a href="/ai/agents/claude-duet/">Claude Duet</a>: always-on personal agent research preview.</li>
  </ul>
</Layout>
