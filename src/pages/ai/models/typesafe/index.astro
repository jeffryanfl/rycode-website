---
import LabTable from '../../../../components/LabTable.astro';
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/ai.css';

const rows = [
  {
    href: '/ai/models/typesafe/jev/',
    title: 'Jev',
    dek: 'First public System One model. Typed decisions for software, not chat.',
    meta: ['jev-latest · early access · $0.042/MTok input (vendor) · text only'],
  },
];
---

<Layout
  title="TypeSafe - A.I. - Rycode"
  description="System One decision models"
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">TypeSafe</h1>
    <p class="ai-lab-dek">System One decision models.</p>
  </div>
  <p class="ai-lab-note">TypeSafe builds what it calls System One models: instead of writing text word by word like a chat model, a System One model returns a typed decision, such as a label, a number, or a yes or no, that software can use directly. TypeSafe says it samples those decisions in parallel in one query. Its first public model is Jev, in early access, text input only. The full case is on the <a href="/ai/models/typesafe/jev/">Jev page</a> and in <a href="/ai/chat-models-write-strings-system-one-returns-decisions/">Chat models write strings. System One returns decisions.</a></p>

  <LabTable rows={rows} />
</Layout>
