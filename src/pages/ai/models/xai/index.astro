---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/ai.css';

const rows = [
  {
    href: '/ai/models/xai/models/',
    title: 'Models',
    dek: 'Grok 4.7 is xAI’s current coding and knowledge-work frontier model (API grok-4.7). Same $2/$6 token band as 4.6, with a published fast variant at 2× price. Live in Cursor, Grok Build, and the API; consumer surfaces later.',
    meta: ['API · chat · reasoning · multimodal', 'Opens the models index →'],
  },
  {
    href: '/ai/models/xai/grok-build/',
    title: 'Grok Build',
    dek: 'Agent that works the project.',
    meta: ['IDE · repos · multi-step build loops', 'Opens Grok Build →'],
  },
  {
    href: '/ai/models/xai/grok-bot/',
    title: 'Grok Bot',
    dek: 'Named Bots on a cloud computer.',
    meta: ['Durable Bots · tools · cloud computer', 'Opens Grok Bot →'],
  },
  {
    href: '/ai/models/xai/imagine/',
    title: 'Imagine',
    dek: 'Image generation door.',
    meta: ['Prompt · image · edit · iterate', 'Opens Imagine →'],
  },
  {
    href: '/ai/models/xai/voice/',
    title: 'Voice',
    dek: 'Spoken Grok surface.',
    meta: ['Talk · listen · hands-free loops', 'Opens Voice →'],
  },
];
---

<Layout
  title="xAI — A.I. — Rycode"
  description="Grok 4.7 is xAI’s current coding and knowledge-work frontier model."
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">xAI</h1>
    <p class="ai-lab-dek">Grok 4.7 is xAI’s current coding and knowledge-work frontier model (API grok-4.7). Same $2/$6 token band as 4.6, with a published fast variant at 2× price. Live in Cursor, Grok Build, and the API; consumer surfaces later.</p>
  </div>

  <ol class="ai-lab-rows">
    {rows.map((row) => (
      <li>
        <a href={row.href}>
          <span class="ai-lab-row-title">{row.title}</span>
          <span class="ai-lab-row-dek">{row.dek}</span>
          {row.meta.map((line) => (
            <span class="ai-lab-row-meta">{line}</span>
          ))}
        </a>
      </li>
    ))}
  </ol>
</Layout>
