---
import LabTable from '../../../../components/LabTable.astro';
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/ai.css';

const rows = [
  {
    href: '/ai/models/google/gemini-4-carbon/',
    title: 'Gemini 4 Carbon',
    dek: 'Now available on the paid Gemini API. Google says Argon remains the ideal choice for the majority of software engineering and knowledge work.',
    meta: ['gemini-4-carbon · $2 / $10 per million tokens through 30 Nov 2026, then $4 / $20'],
  },
  {
    href: '/ai/models/google/gemini-4-argon/',
    title: 'Gemini 4 Argon',
    dek: 'Generally available since 13 Oct 2026. Google DeepMind frontier model.',
    meta: ['gemini-4-argon · $2 / $10 per million tokens through 30 Nov 2026'],
  },
  {
    href: '/ai/models/google/gemini-4-neon/',
    title: 'Gemini 4 Neon',
    dek: 'Google says Neon balances depth and efficiency, between Carbon and Hydrogen.',
    meta: ['gemini-4-neon · $3 / $15 per million tokens · paid tier only'],
  },
  {
    href: '/ai/models/google/gemini-4-hydrogen/',
    title: 'Gemini 4 Hydrogen',
    dek: 'Google says Hydrogen is built for rapid execution across diverse agentic workflows.',
    meta: ['gemini-4-hydrogen · $1.50 / $7.50 per million tokens'],
  },
  {
    href: '/ai/models/google/gemini-flash/',
    title: 'Gemini 3.8 Flash',
    dek: 'Previous-generation Flash model. Google now recommends Gemini 4 Hydrogen.',
    meta: ['gemini-3.8-flash · $0.75 / $3.75 through 31 Dec 2026'],
  },
  {
    href: '/ai/models/google/gemini-pro/',
    title: 'Gemini 3.1 Pro Preview',
    dek: 'Pro line for harder reasoning and tool use.',
    meta: ['gemini-3.1-pro-preview · $2 / $12 under 200k'],
  },
  {
    href: '/ai/models/google/gemini-flash-lite/',
    title: 'Gemini 3.5 Flash-Lite',
    dek: 'Low-latency Flash-Lite for high-throughput work.',
    meta: ['Stub'],
  },
  {
    href: '/ai/models/google/gemini-omni-1-2-flash/',
    title: 'Gemini Omni 1.2 Flash',
    dek: 'Video model: 15-second clips with audio, edited in conversation.',
    meta: ['gemini-omni-1.2-flash · about $0.07 per second of 720p video'],
  },
  {
    href: '/ai/models/google/gemma/',
    title: 'Gemma 4',
    dek: 'Open-weight family, separate from hosted Gemini.',
    meta: ['Stub'],
  },
];
---

<Layout
  title="Google - A.I. - Rycode"
  description="Gemini and Gemma lineup from Google DeepMind."
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">Google</h1>
    <p class="ai-lab-dek">Google DeepMind’s Gemini family: hosted multimodal models, plus a short door for open-weight Gemma 4. Current models are Gemini 4 Carbon (now available on the paid Gemini API, announced 28 October 2026), Gemini 4 Argon, Gemini 4 Neon (introduced 18 November 2026), Gemini 4 Hydrogen (introduced 12 November 2026), Gemini 3.5 Flash-Lite, and the video model Gemini Omni 1.2 Flash. Gemini 3.8 Flash, which Google now calls its previous-generation Flash model, and Gemini 3.1 Pro Preview are in the archive.</p>
  </div>

  <LabTable rows={rows} />
  <p class="ai-lab-table-note">Gemini Omni 1.2 Flash is a video model. Google bills video output by token use; about $0.07 per second of 720p video is the effective rate. It is not on the Artificial Analysis Intelligence Index, so its AA cell reads "Not on file".</p>

  <h2 class="ai-lab-lane">Products and features</h2>
  <p class="ai-lab-note">Apps and features from Google. They run on Gemini but are not API models.</p>
  <ul class="ai-lab-note">
    <li><a href="https://blog.google/innovation-and-ai/products/gemini-app/computer-use-mac/">Computer use in the Gemini app for Mac</a>: a Gemini app feature, not an API model; rolling out in English in the U.S. for Google AI Plus, Pro, and Ultra users 18 or older with a personal account, on Apple Silicon Macs running macOS Sequoia 15.0 or later; it can click, type, and navigate desktop apps and websites in a separate window.</li>
  </ul>
</Layout>
