---
import LabTable from '../../../../components/LabTable.astro';
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/ai.css';

const rows = [
  {
    href: '/ai/models/google/gemini-4-carbon/',
    title: 'Gemini 4 Carbon',
    dek: 'Announced 28 Oct 2026. Cyber defenders first, not yet public. Google DeepMind frontier model.',
    meta: ['No public API id yet · $2 / $10 per million tokens intro, then $4 / $20'],
  },
  {
    href: '/ai/models/google/gemini-4-argon/',
    title: 'Gemini 4 Argon',
    dek: 'Generally available since 13 Oct 2026. Google DeepMind frontier model.',
    meta: ['gemini-4-argon · $2 / $10 per million tokens through 30 Nov 2026'],
  },
  {
    href: '/ai/models/google/gemini-flash/',
    title: 'Gemini 3.8 Flash',
    dek: 'Current Flash workhorse for long-horizon agents.',
    meta: ['gemini-3.8-flash · $0.75 / $3.75 through 31 Dec 2026'],
  },
  {
    href: '/ai/models/google/gemini-pro/',
    title: 'Gemini 3.1 Pro Preview',
    dek: 'Pro line for harder reasoning and tool use.',
    meta: ['gemini-3.1-pro-preview · $2 / $12 under 200k'],
  },
  {
    href: '/ai/models/google/gemini-flash-lite/',
    title: 'Gemini 3.5 Flash-Lite',
    dek: 'Low-latency Flash-Lite for high-throughput work.',
    meta: ['Stub'],
  },
  {
    href: '/ai/models/google/gemini-omni-1-2-flash/',
    title: 'Gemini Omni 1.2 Flash',
    dek: 'Video model: 15-second clips with audio, edited in conversation.',
    meta: ['gemini-omni-1.2-flash · about $0.07 per second of 720p video'],
  },
  {
    href: '/ai/models/google/gemma/',
    title: 'Gemma 4',
    dek: 'Open-weight family, separate from hosted Gemini.',
    meta: ['Stub'],
  },
];
---

<Layout
  title="Google - A.I. - Rycode"
  description="Gemini and Gemma lineup from Google DeepMind."
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">Google</h1>
    <p class="ai-lab-dek">Google DeepMind’s Gemini family: hosted multimodal models, plus a short door for open-weight Gemma 4. Current models are Gemini 4 Carbon (cyber defenders first, announced 28 October 2026), Gemini 4 Argon, Gemini 3.8 Flash (Google's newest Flash model), Gemini 3.5 Flash-Lite, and the video model Gemini Omni 1.2 Flash. Gemini 3.1 Pro Preview is in the archive.</p>
  </div>

  <LabTable rows={rows} />
  <p class="ai-lab-table-note">Gemini Omni 1.2 Flash is a video model. It is priced per second of video, not per million tokens, and it is not on the Artificial Analysis Intelligence Index, so its AA cell reads "Not on file".</p>
</Layout>
