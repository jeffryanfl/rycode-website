---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/ai.css';

const muse = [
  {
    href: '/ai/models/meta/muse/spark/',
    title: 'Muse Spark',
    dek: 'Flagship reasoning / agentic / coding on Meta Model API and Meta AI.',
    meta: ['Full card'],
  },
  {
    href: '/ai/models/meta/muse/glimmer/',
    title: 'Muse Glimmer',
    dek: 'Open-weight 30B multimodal, distilled from Spark.',
    meta: ['Full card · Apache 2.0'],
  },
  {
    href: '/ai/models/meta/muse/image/',
    title: 'Muse Image',
    dek: 'Image generation and edit on Meta Model API.',
    meta: ['Stub'],
  },
  {
    href: '/ai/models/meta/muse/video/',
    title: 'Muse Video',
    dek: 'Video generation in the Muse family.',
    meta: ['Stub'],
  },
  {
    href: '/ai/models/meta/muse/code/',
    title: 'Muse Code',
    dek: 'Multi-agent coding in the terminal, built for Spark.',
    meta: ['Stub · product, not weights'],
  },
];

const llama = [
  {
    href: '/ai/models/meta/llama/llama-4/',
    title: 'Llama 4',
    dek: 'Current open-weight generation. Scout and Maverick.',
    meta: ['Full card'],
  },
];
---

<Layout
  title="Meta — A.I. — Rycode"
  description="Two stacks: Muse (API / Meta AI) and Llama (open weights)."
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">Meta</h1>
    <p class="ai-lab-dek">Meta ships two stacks. Muse is the Meta Superintelligence Labs family used in Meta AI and the Meta Model API. Llama is the open-weight line for download and self-host. Family hubs: <a href="/ai/models/meta/muse/">Muse</a> · <a href="/ai/models/meta/llama/">Llama</a>.</p>
  </div>

  <h2 class="ai-lab-lane">Muse</h2>
  <ol class="ai-lab-rows">
    {muse.map((row) => (
      <li>
        <a href={row.href}>
          <span class="ai-lab-row-title">{row.title}</span>
          <span class="ai-lab-row-dek">{row.dek}</span>
          {row.meta.map((line) => (
            <span class="ai-lab-row-meta">{line}</span>
          ))}
        </a>
      </li>
    ))}
  </ol>

  <h2 class="ai-lab-lane">Llama</h2>
  <ol class="ai-lab-rows">
    {llama.map((row) => (
      <li>
        <a href={row.href}>
          <span class="ai-lab-row-title">{row.title}</span>
          <span class="ai-lab-row-dek">{row.dek}</span>
          {row.meta.map((line) => (
            <span class="ai-lab-row-meta">{line}</span>
          ))}
        </a>
      </li>
    ))}
  </ol>
</Layout>
