---
import LabTable from '../../../../../components/LabTable.astro';
import Layout from '../../../../../layouts/Layout.astro';
import '../../../../../styles/ai.css';

const rows = [
  {
    href: '/ai/models/meta/muse/wonder/',
    title: 'Muse Wonder',
    dek: 'Meta’s most capable model to date, for coding and long-running agents. Wonder on Meta Model API; Wonder Full in Muse Code only.',
    meta: ['muse-wonder-1.0 · 1M · $4/$20 (vendor, 12 Oct 2026)'],
  },
  {
    href: '/ai/models/meta/muse/spark/',
    title: 'Muse Spark',
    dek: 'Lighter reasoning / agentic / coding model on Meta Model API and Meta AI.',
    meta: ['muse-spark-1.3 · 1M · $1.25/$4.25 standard (vendor, 20 Sep 2026)'],
  },
  {
    href: '/ai/models/meta/muse/spark-open/',
    title: 'Muse Spark Open',
    dek: 'Open-weight Spark: 816B total, 42B active, for coding and agents. Released 15 Oct 2026.',
    meta: ['Muse Model License · 1M · Hugging Face and hosted APIs'],
  },
  {
    href: '/ai/models/meta/muse/glimmer/',
    title: 'Muse Glimmer',
    dek: 'Open-weight 30B multimodal, distilled from Spark.',
    meta: ['Apache 2.0 · 128K default · local runtimes'],
  },
  {
    href: '/ai/models/meta/muse/image/',
    title: 'Muse Image',
    dek: 'Image generation and edit on Meta Model API.',
    meta: ['Stub · muse-image-1.0'],
  },
  {
    href: '/ai/models/meta/muse/video/',
    title: 'Muse Video',
    dek: 'Video generation in the Muse family.',
    meta: ['Stub · preview / coming-soon language on Meta’s blog'],
  },
  {
    href: '/ai/models/meta/muse/code/',
    title: 'Muse Code',
    dek: 'Multi-agent coding in the terminal. Runs Wonder and Wonder Full.',
    meta: ['Stub · product surface, not weights'],
  },
];
---

<Layout
  title="Muse - Meta - A.I. - Rycode"
  description="Meta Superintelligence Labs model family. Separate from Llama."
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">Muse</h1>
    <p class="ai-lab-dek">Muse is Meta’s model family from Meta Superintelligence Labs. It is separate from Llama. Wonder, released 12 Oct 2026, is what Meta calls its most capable model to date, with a larger Wonder Full in Muse Code. Spark is the lighter reasoning line that powers Meta AI and the Meta Model API, and since 15 Oct 2026 it also comes as Spark Open, with weights you can download. Glimmer is the open-weight sibling distilled from Spark. Image and Video are media models. Code is a multi-agent coding product that runs Wonder and Wonder Full.</p>
  </div>

  <LabTable rows={rows} />
</Layout>
