---
import LabTable from '../../../../../components/LabTable.astro';
import Layout from '../../../../../layouts/Layout.astro';
import '../../../../../styles/ai.css';

const rows = [
  {
    href: '/ai/models/meta/llama/llama-4/',
    title: 'Llama 4',
    dek: 'Current open-weight generation. Scout and Maverick.',
    meta: ['Scout-17B-16E · Maverick-17B-128E · Llama 4 Community License'],
  },
];
---

<Layout
  title="Llama - Meta - A.I. - Rycode"
  description="Meta’s open-weight model line. Separate from Muse."
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">Llama</h1>
    <p class="ai-lab-dek">Llama is Meta’s open-weight model line for download and self-host. It is separate from the Muse API and Meta AI stack.</p>
  </div>

  <h2 class="ai-lab-lane">Current</h2>
  <LabTable rows={rows} />

  <p class="ai-lab-note">Prior releases, without full cards here: Llama 3, 3.1, 3.2, 3.3 and earlier. See Meta’s <a href="https://github.com/meta-llama/llama-models/">llama-models</a> herd table and Hugging Face <code>meta-llama</code>.</p>
</Layout>
