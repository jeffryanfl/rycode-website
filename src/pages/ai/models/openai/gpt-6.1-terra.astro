          </tr>
        </thead>
        <tbody>
          <tr><td>Input / MTok</td><td>$1</td></tr>
          <tr><td>Cached input / MTok</td><td>$0.05</td></tr>
          <tr><td>Cache writes / MTok</td><td>$1.25</td></tr>
          <tr><td>Output / MTok</td><td>$5</td></tr>
