---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/ai.css';

const rows = [
  {
    href: '/ai/models/openai/gpt-6-astra/',
    title: 'GPT-6 Astra',
    dek: 'Flagship for hard end-to-end work.',
    meta: ['1.05M · 128K · $10/$50 · effort low–max (no none)'],
  },
  {
    href: '/ai/models/openai/gpt-6.1-sol/',
    title: 'GPT-6.1 Sol',
    dek: 'Near-Astra mid-tier at Sol list price.',
    meta: ['1.05M · 128K · $2/$10 · gpt-6.1-sol'],
  },
  {
    href: '/ai/models/openai/dots/',
    title: 'Dots',
    dek: 'Always-on agent. Own cloud computer. Astra.',
    meta: ['Pro / Business Premium · first dot included'],
  },
  {
    href: '/ai/models/openai/gpt-6-intelligent-ui/',
    title: 'Intelligent UI in ChatGPT',
    dek: 'GPT-6 answers with visuals and controls in the Chat tab.',
    meta: ['Chat tab · Instant to Extra High · no API'],
  },
  {
    href: '/ai/models/openai/gpt-6-sol/',
    title: 'GPT-6 Sol',
    dek: 'Mid-tier for complex coding and agentic work.',
    meta: ['1.05M · 128K · $2/$10 · effort none–max'],
  },
  {
    href: '/ai/models/openai/gpt-6-luna/',
    title: 'GPT-6 Luna',
    dek: 'Cheaper, faster GPT-6 tier.',
    meta: ['1.05M · 128K · $0.10/$0.50'],
  },
];
---

<Layout
  title="OpenAI - A.I. - Rycode"
  description="GPT frontier lineup"
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">OpenAI</h1>
    <p class="ai-lab-dek">GPT frontier lineup</p>
    <p class="ai-lab-note">GPT-6.1 Astra was not released.</p>
  </div>

  <ol class="ai-lab-rows">
    {rows.map((row) => (
      <li>
        <a href={row.href}>
          <span class="ai-lab-row-title">{row.title}</span>
          <span class="ai-lab-row-dek">{row.dek}</span>
          {row.meta.map((line) => (
            <span class="ai-lab-row-meta">{line}</span>
          ))}
        </a>
      </li>
    ))}
  </ol>
</Layout>
