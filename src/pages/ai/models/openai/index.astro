---
import LabTable from '../../../../components/LabTable.astro';
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/ai.css';

const rows = [
  {
    href: '/ai/models/openai/gpt-6-astra/',
    title: 'GPT-6 Astra',
    dek: 'Flagship for hard end-to-end work.',
    meta: ['1.05M · 128K · $10/$50 · effort low–max (no none)'],
  },
  {
    href: '/ai/models/openai/gpt-6.1-sol/',
    title: 'GPT-6.1 Sol',
    dek: 'Near-Astra mid-tier at Sol list price.',
    meta: ['1.05M · 128K · $2/$10 · gpt-6.1-sol'],
  },
  {
    href: '/ai/models/openai/gpt-6.1-terra/',
    title: 'GPT-6.1 Terra',
    dek: 'Fast, lower-cost GPT-6.1 tier for computer use.',
    meta: ['1.05M · 128K · $1/$5 · gpt-6.1-terra'],
  },
  {
    href: '/ai/models/openai/gpt-6-luna/',
    title: 'GPT-6 Luna',
    dek: 'Cheaper, faster GPT-6 tier.',
    meta: ['1.05M · 128K · $0.10/$0.50'],
  },
];

const products = [
  {
    href: '/ai/models/openai/gpt-6-intelligent-ui/',
    title: 'Intelligent UI in ChatGPT',
    note: 'a ChatGPT feature, not an API model',
  },
  {
    href: '/ai/agents/dots/',
    title: 'dots',
    note: 'always-on ChatGPT agent on GPT-6 Astra, not an API model; texting over iMessage or RCS in US Pro beta',
  },
];
---

<Layout
  title="OpenAI - A.I. - Rycode"
  description="GPT frontier lineup"
  variant="ai"
>
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">OpenAI</h1>
    <p class="ai-lab-dek">GPT frontier lineup</p>
    <p class="ai-lab-note">GPT-6.1 Astra was not released.</p>
  </div>

  <LabTable rows={rows} />

  <h2 class="ai-lab-lane">Products and features</h2>
  <p class="ai-lab-note">Apps and agents from OpenAI. They run on GPT models but are not API models.</p>
  <ul class="ai-lab-note">
    {products.map((p) => (
      <li><a href={p.href}>{p.title}</a>: {p.note}</li>
    ))}
  </ul>
</Layout>
