---
import Layout from '../../layouts/Layout.astro';
import ExecutiveCallout from '../../components/ExecutiveCallout.astro';
---

<Layout title="AI Concepts and Infrastructure — Rycode Intelligence">
  <div class="editorial-container">
    <div class="editorial-main" style="grid-column: span 2;">
      <!-- SUBPAGE HERO -->
      <section class="subpage-hero">
        <p class="subpage-eyebrow">Intelligence Vault · AI Systems</p>
        <h1 class="subpage-title">AI Concepts and Infrastructure</h1>
        <p class="subpage-lead">
          An empirical analytical portal covering frontier AI model benchmarks, model architectures, silicon supply chains, low-precision inference engineering, data center power infrastructure, and prompt engineering mechanics.
        </p>
        
        <ExecutiveCallout title="EXECUTIVE PORTAL OVERVIEW">
          This portal translates complex artificial intelligence engineering into actionable strategic insights for non-technical stakeholders. Whether evaluating model capability (Evals), semiconductor bottlenecks (Ecosystem), serving costs (Inference), or clean energy grid self-sufficiency (Power), each module bridges raw engineering data with clear business, financial, and governance outcomes.
        </ExecutiveCallout>
      </section>

      <!-- RESEARCH CATEGORIES GRID -->
      <section aria-labelledby="catHeading">
        <div class="article-grid-header">
          <h2 class="grid-section-title" id="catHeading">Research Categories</h2>
          <span class="meta-date">7 Modules</span>
        </div>

        <div class="article-grid">
          <!-- Module 1 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">01 // Evals</span>
              <h3 class="card-headline">
                <a href="/ai/benchmarks">Model Benchmarks & Architectures</a>
              </h3>
              <p class="card-snippet">
                Frontier LLM evaluations (SWE-bench, GDPval Elo, ARC-AGI-3) and Frontier Model Architecture & Economics breakdown.
              </p>
            </div>
            <div class="card-bottom">
              <span>8 min read</span>
              <a href="/ai/benchmarks" class="read-more-link">Explore Evals →</a>
            </div>
          </article>

          <!-- Module 2 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">02 // Systems</span>
              <h3 class="card-headline">
                <a href="/ai/inference">Inference & Serving Performance</a>
              </h3>
              <p class="card-snippet">
                Quantization dynamics (NVFP4, FP8, INT4), KV-cache compression, batching efficiency, and GPU memory bandwidth.
              </p>
            </div>
            <div class="card-bottom">
              <span>6 min read</span>
              <a href="/ai/inference" class="read-more-link">Explore Systems →</a>
            </div>
          </article>

          <!-- Module 3 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">03 // Ecosystem</span>
              <h3 class="card-headline">
                <a href="/ai/supply-chain">Supply Chain & Semiconductor Ecosystem</a>
              </h3>
              <p class="card-snippet">
                8-tier semiconductor directory (Synopsys, ASML, TSMC, NVIDIA, SK Hynix) spanning 32 top global infrastructure leaders.
              </p>
            </div>
            <div class="card-bottom">
              <span>12 min read</span>
              <a href="/ai/supply-chain" class="read-more-link">Explore Ecosystem →</a>
            </div>
          </article>

          <!-- Module 4 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">04 // Power</span>
              <h3 class="card-headline">
                <a href="/ai/energy-compute">Energy & Compute Infrastructure</a>
              </h3>
              <p class="card-snippet">
                Datacenter power bottlenecks, small modular reactors (SMRs), grid interconnection queues, and hyperscale energy self-sufficiency.
              </p>
            </div>
            <div class="card-bottom">
              <span>7 min read</span>
              <a href="/ai/energy-compute" class="read-more-link">Explore Power →</a>
            </div>
          </article>

          <!-- Module 5 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">05 // Sampling</span>
              <h3 class="card-headline">
                <a href="/ai/glossary">Glossary & Sampling Parameters</a>
              </h3>
              <p class="card-snippet">
                Comprehensive glossary of 89 indexed AI terms and interactive parameter simulators (temperature, top_p, top_k, context window).
              </p>
            </div>
            <div class="card-bottom">
              <span>Interactive</span>
              <a href="/ai/glossary" class="read-more-link">Open Reference →</a>
            </div>
          </article>

          <!-- Module 6 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">06 // Engineering</span>
              <h3 class="card-headline">
                <a href="/ai/prompt-engineering">Prompt Engineering Handbook</a>
              </h3>
              <p class="card-snippet">
                System prompts, structured JSON schema output enforcement, chain-of-thought orchestration, and context optimization.
              </p>
            </div>
            <div class="card-bottom">
              <span>5 min read</span>
              <a href="/ai/prompt-engineering" class="read-more-link">Read Handbook →</a>
            </div>
          </article>

          <!-- Module 7 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">07 // Economics</span>
              <h3 class="card-headline">
                <a href="/ai/macroeconomics">Macroeconomics & Capex</a>
              </h3>
              <p class="card-snippet">
                Hyperscale capex projections, ROI timelines, software market consolidation, and enterprise AI adoption dynamics.
              </p>
            </div>
            <div class="card-bottom">
              <span>9 min read</span>
              <a href="/ai/macroeconomics" class="read-more-link">Read Analysis →</a>
            </div>
          </article>
        </div>
      </section>
    </div>
  </div>
</Layout>
