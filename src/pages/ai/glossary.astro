    text: 'Artificial Analysis methodology',
  },
  {
    href: 'https://metr.org/',
    text: 'METR',
  },
  {
    href: 'https://osworld-v2.xlang.ai/',
    text: 'OSWorld',
  },
  {
    href: 'https://github.com/xlang-ai/OSWorld',
