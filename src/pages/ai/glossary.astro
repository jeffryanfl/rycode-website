---
import Layout from '../../layouts/Layout.astro';
import '../../styles/ai.css';
import '../../styles/paper.css';

const title = 'AI glossary';
const subhead = 'Twenty plain terms for models, serving, and agents on this site';

const sources = [
  {
    href: 'https://arxiv.org/abs/2309.06180',
    text: 'Kwon et al., Efficient Memory Management for Large Language Model Serving with PagedAttention',
  },
  {
