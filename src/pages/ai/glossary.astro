    text: 'vLLM: Easy, Fast, and Cheap LLM Serving with PagedAttention',
  },
  {
    href: 'https://docs.vllm.ai/en/latest/design/paged_attention.html',
    text: 'vLLM documentation: Paged Attention',
  },
  {
    href: 'https://www.anthropic.com/news/model-context-protocol',
    text: 'Anthropic, Introducing the Model Context Protocol',
  },
  {
    href: 'https://modelcontextprotocol.io/',
    text: 'Model Context Protocol docs home',
  },
  {
    href: 'https://github.com/modelcontextprotocol/specification',
    text: 'Model Context Protocol specification',
  },
  {
    href: 'https://owasp.org/www-project-top-10-for-large-language-model-applications/',
    text: 'OWASP Top 10 for Large Language Model Applications',
  },
  {
    href: 'https://arxiv.org/abs/1706.03762',
    text: 'Vaswani et al., Attention Is All You Need',
  },
  {
    href: 'https://arxiv.org/abs/2205.14135',
    text: 'Dao et al., FlashAttention: Fast and Memory-Efficient Exact Attention with IO-Awareness',
  },
  {
    href: 'https://github.com/Dao-AILab/flash-attention',
    text: 'Dao-AILab / flash-attention',
  },
  {
    href: 'https://openai.com/index/why-language-models-hallucinate/',
    text: 'OpenAI, Why language models hallucinate',
  },
  {
