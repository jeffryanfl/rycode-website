---
import Layout from '../../../../layouts/Layout.astro';
import HardwarePlantGroups from '../../../../components/HardwarePlantGroups.astro';
import HardwareCrumb from '../../../../components/HardwareCrumb.astro';
import { hardwareTheme } from '../../../../lib/hardware';
import '../../../../styles/ai.css';

const theme = hardwareTheme('power');
---

<Layout title={`${theme.title} - Hardware - Rycode`} description={theme.dek} variant="ai">
  <div class="ai-lab-head">
    <HardwareCrumb current={theme.title} />
    <h1 class="ai-lab-title">{theme.title}</h1>
    <p class="ai-lab-dek">{theme.dek}</p>
  </div>
  <p class="ai-lab-note">A data center is sized by the power it can draw. A megawatt (MW) is a million watts and a gigawatt (GW) a billion, about the output of one large power plant. AI campuses now plan for 1 to 5 GW, so labs sign their own deals for gas plants, batteries, and nuclear power.</p>
  <p class="ai-lab-note">An uprate is an upgrade that lets an existing power plant make more electricity. A grid connection, or interconnect, is the permission and wiring to draw power from the public grid. The cards below each come from a sourced page.</p>
  <HardwarePlantGroups themeId="power" listLabel={theme.title} emptyTitle="" />
</Layout>
