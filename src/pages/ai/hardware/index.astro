---
import Layout from '../../../layouts/Layout.astro';
import HardwareCardGrid from '../../../components/HardwareCardGrid.astro';
import { hardwareThemes } from '../../../lib/hardware';
import '../../../styles/ai.css';

const title = 'Hardware';
const dek = 'Five jobs: power, cooling, chips, data centers, and networks.';
---

<Layout title={`${title} - A.I. - Rycode`} description={dek} variant="ai">
  <div class="ai-lab-head">
    <h1 class="ai-lab-title">{title}</h1>
    <p class="ai-lab-dek">{dek}</p>
  </div>
  <p class="ai-lab-note">An AI model runs on chips, and the chips need a building, power, cooling, and a network to act as one machine. Each door below covers one of those jobs, with figures taken from the company that makes or runs the hardware.</p>
  <HardwareCardGrid cards={hardwareThemes} listLabel="Hardware themes" />
  <p class="ai-lab-note hw-chip-more">
    <span class="hw-chip-more-label">Reference</span>
    <a href="/ai/hardware/hbm/">HBM memory</a> ·
    <a href="/ai/hardware/tsmc/">TSMC and chip manufacturing</a> ·
    <a href="/ai/hardware/ai-clouds/">AI cloud providers</a> ·
    <a href="/ai/ai-regulation/">AI regulation</a>
  </p>
</Layout>
