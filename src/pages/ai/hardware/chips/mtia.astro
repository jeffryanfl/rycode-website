          <tr>
            <th scope="col">Figure</th>
            <th scope="col">Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>HBM3E</td>
            <td>216 GB</td>
          </tr>
          <tr>
            <td>I/O</td>
            <td>1.2 TB/s</td>
          </tr>
          <tr>
            <td>RDMA NICs (network cards)</td>
            <td>Six custom 800 Gbps on each network chiplet</td>
          </tr>
          <tr>
            <td>Scale-up</td>
            <td>Rack of 16 nodes, up to 1 TB/s</td>
          </tr>
          <tr>
            <td>Scale-out</td>
            <td>200 GB/s across racks</td>
          </tr>
          <tr>
            <td>Processing elements</td>
            <td>12 by 6</td>
          </tr>
          <tr>
            <td>Message engines</td>
            <td>16</td>
          </tr>
          <tr>
            <td>Near-memory reduction</td>
            <td>More than 2.8 TBs of reduction throughput</td>
          </tr>
          <tr>
            <td>GEMMs with collectives</td>
            <td>Less than 0.5% compute degradation</td>
          </tr>
          <tr>
            <td>HCCL, one rack</td>
            <td>Up to 940 GB/s</td>
          </tr>
          <tr>
            <td>Recommendation model</td>
            <td>150 billion parameters across 40 accelerators</td>
          </tr>
          <tr>
