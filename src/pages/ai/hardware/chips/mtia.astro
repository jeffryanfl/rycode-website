---
import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/ai.css';
---

<Layout
  title="MTIA - Hardware - Rycode"
  description="MTIA 300 is in production for ranking and ads models. MTIA 400 finished lab tests. MTIA 450 and MTIA 500 are planned for general-AI inference."
  variant="ai"
>
  <article class="ai-model">
    <p class="ai-model-kicker">Hardware · Chips</p>
    <h1 class="ai-model-title">MTIA</h1>
    <p class="ai-model-dek">Meta's own chips. MTIA 300 trains ranking and ads models. MTIA 400 finished lab tests. MTIA 450 and MTIA 500 are planned for general-AI inference.</p>
    <hr class="ai-model-rule" />

    <h2 class="ai-model-section">Dated claims</h2>
    <div class="ai-model-table-wrap">
      <table class="ai-model-table ai-model-table--prose">
        <thead>
          <tr>
            <th scope="col">Chip</th>
            <th scope="col">Status</th>
            <th scope="col">What it is for</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>MTIA 300</td>
            <td>In production 11 March 2026</td>
            <td>Training ranking and ads models.</td>
          </tr>
          <tr>
            <td>MTIA 400</td>
            <td>Finished lab tests</td>
            <td>On the path into data centers.</td>
          </tr>
          <tr>
            <td>MTIA 450</td>
            <td>Planned early 2027</td>
            <td>General-AI inference. Inference means running a model.</td>
          </tr>
          <tr>
            <td>MTIA 500</td>
            <td>Planned 2027</td>
            <td>General-AI inference. Inference means running a model.</td>
          </tr>
        </tbody>
      </table>
    </div>

  </article>
</Layout>
