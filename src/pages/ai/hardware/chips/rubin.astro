            <td>72 Rubin</td>
          </tr>
          <tr>
            <td>CPUs</td>
            <td>36 Vera</td>
          </tr>
          <tr>
            <td>CPU</td>
            <td>3,168 Olympus cores and 6,336 threads</td>
