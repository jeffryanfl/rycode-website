---
import Layout from '../../../../layouts/Layout.astro';
import HardwarePlantGroups from '../../../../components/HardwarePlantGroups.astro';
import HardwareCrumb from '../../../../components/HardwareCrumb.astro';
import { hardwareTheme } from '../../../../lib/hardware';
import '../../../../styles/ai.css';

const theme = hardwareTheme('chips');
---

<Layout title={`${theme.title} - Hardware - Rycode`} description={theme.dek} variant="ai">
  <div class="ai-lab-head">
    <HardwareCrumb current={theme.title} />
    <h1 class="ai-lab-title">{theme.title}</h1>
    <p class="ai-lab-dek">{theme.dek}</p>
  </div>
  <HardwarePlantGroups themeId="chips" listLabel={theme.title} emptyTitle="" />
  <p class="ai-lab-note">
    Stacks name who buys or builds the chip.
    <a href="/ai/hardware/chips/meta/">Meta</a> deploys
    <a href="/ai/hardware/chips/mtia/">MTIA</a>,
    <a href="/ai/hardware/chips/meta-broadcom/">Broadcom</a>,
    <a href="/ai/hardware/chips/meta-nvidia/">Nvidia</a>, and
    <a href="/ai/hardware/chips/meta-amd/">AMD</a>.
    <a href="/ai/hardware/chips/terafab/">Terafab</a> is the SpaceX and Tesla factory, not a chip family.
  </p>
</Layout>
