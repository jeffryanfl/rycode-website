            <th scope="col">Label</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>&gt;300 MW for Colossus 1 under the Anthropic deal</td>
            <td>Company and partner announcement</td>
            <td>Anthropic 6 May 2026; SpaceXAI partnership post aligns on GPU count</td>
          </tr>
        </tbody>
