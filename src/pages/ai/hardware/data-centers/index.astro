---
import Layout from '../../../../layouts/Layout.astro';
import HardwarePlantGroups from '../../../../components/HardwarePlantGroups.astro';
import HardwareCrumb from '../../../../components/HardwareCrumb.astro';
import { hardwareTheme } from '../../../../lib/hardware';
import '../../../../styles/ai.css';

const theme = hardwareTheme('data-centers');
---

<Layout title={`${theme.title} - Hardware - Rycode`} description={theme.dek} variant="ai">
  <div class="ai-lab-head">
    <HardwareCrumb current={theme.title} />
    <h1 class="ai-lab-title">{theme.title}</h1>
    <p class="ai-lab-dek">{theme.dek}</p>
  </div>
  <p class="ai-lab-note">A data center is the building, or campus of buildings, that houses the chips, power, and cooling. An AI training campus is built to run one very large job across hundreds of thousands of chips, so its layout, power, and network are designed together.</p>
  <p class="ai-lab-note">Each card shows one public figure from the company that owns or builds the site. Power, cooling, and network details are on each page and on the <a href="/ai/hardware/power/">Power</a>, <a href="/ai/hardware/cooling/">Cooling</a>, and <a href="/ai/hardware/networks/">Networks</a> pages.</p>
  <HardwarePlantGroups themeId="data-centers" listLabel={theme.title} emptyTitle="" />
</Layout>
