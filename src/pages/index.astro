---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rycode — Under Development" hideNavLinks={true}>
  <!-- Full Screen Glitch Effect Overlay -->
  <div class="glitch-overlay"></div>

  <!-- Interactive Background Matrix Grid Canvas (fixed in viewport behind page) -->
  <div class="viewport-matrix-container">
    <canvas id="networkCanvas"></canvas>
  </div>

  <!-- ===========================================================
       HERO / WORKSTATION PORTAL
       =========================================================== -->
  <section class="hero" aria-labelledby="heroTitle">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-grid">
        <!-- Brand / Tagline Column -->
        <div class="hero-text-block">
          <p class="hero-eyebrow">Technology · Geopolitics · Finance</p>
          <h1 class="hero-title" id="heroTitle">Rycode</h1>
          <p class="hero-tagline">
            An independent research lab and developer workshop exploring complex global systems. Our public interfaces, quantitative dashboards, and analytical briefings are currently undergoing scheduled system updates.
          </p>
        </div>

        <!-- Telemetry Diagnostics & Control Column -->
        <div class="hud-container">
          <div class="hud-card">
            <h2 class="hud-title">
              <span class="hud-pulse" aria-hidden="true"></span>
              System Diagnostics
            </h2>
            <div class="hud-row">
              <span class="hud-label">LAB_STATUS</span>
              <span class="hud-val active">ONLINE</span>
            </div>
            <div class="hud-row">
              <span class="hud-label">MATRIX_GRID</span>
              <span class="hud-val" id="hudMatrixStatus">ACTIVE</span>
            </div>
            <div class="hud-row">
              <span class="hud-label">HOVERED_GLYPHS</span>
              <span class="hud-val" id="hudActiveNodes">0 cells</span>
            </div>
            <div class="hud-row">
              <span class="hud-label">PACKETS_SECURED</span>
              <span class="hud-val" id="hudPackets">14,832</span>
            </div>
            <div class="hud-row">
              <span class="hud-label">PUBLIC_PORTAL</span>
              <span class="hud-val restricted">RESTRICTED</span>
            </div>
          </div>

          <!-- Interactive Matrix Control HUD Console -->
          <div class="matrix-console">
            <h3>
              <span style="display:inline-block; width:8px; height:8px; background:var(--gold-hot); border-radius:50%;"></span>
              Matrix Control Panel
            </h3>
            
            <!-- Speed Slider -->
            <div class="control-group">
              <label for="speedRange">Speed: <span class="val-display" id="speedVal">1.0x</span></label>
              <input type="range" id="speedRange" class="matrix-range" min="0.1" max="3" step="0.1" value="1.0" aria-label="Matrix speed slider" />
            </div>

            <!-- Density Slider -->
            <div class="control-group">
              <label for="densityRange">Density: <span class="val-display" id="densityVal">60%</span></label>
              <input type="range" id="densityRange" class="matrix-range" min="10" max="100" step="5" value="60" aria-label="Matrix density slider" />
            </div>

            <!-- Theme Color Selector -->
            <div class="control-group">
              <label>Color Palette</label>
              <div class="btn-grid">
                <button class="matrix-select-btn active" data-theme="blue" aria-label="Blue color theme">Cobalt</button>
                <button class="matrix-select-btn" data-theme="gold" aria-label="Gold color theme">Gold</button>
                <button class="matrix-select-btn" data-theme="green" aria-label="Green color theme">Green</button>
                <button class="matrix-select-btn" data-theme="red" aria-label="Alert red color theme">Alert</button>
              </div>
            </div>

            <!-- Glyph Selector -->
            <div class="control-group">
              <label>Glyph Mode</label>
              <div class="btn-grid">
                <button class="matrix-select-btn active" data-glyph="binary" aria-label="Binary glyphs mode">Bin</button>
                <button class="matrix-select-btn" data-glyph="hex" aria-label="Hexadecimal glyphs mode">Hex</button>
                <button class="matrix-select-btn" data-glyph="glyphs" aria-label="Standard matrix glyphs mode">Glyph</button>
                <button class="matrix-select-btn" data-glyph="rycode" aria-label="Rycode glyphs mode">Ryc</button>
              </div>
            </div>

            <!-- Interaction Mode Selector -->
            <div class="control-group">
              <label>Interaction Mode</label>
              <div class="btn-grid-2">
                <button class="matrix-select-btn active" data-mode="deflect" aria-label="Deflect interaction mode">Deflect</button>
                <button class="matrix-select-btn" data-mode="decrypt" aria-label="Decrypt interaction mode">Decrypt</button>
                <button class="matrix-select-btn" data-mode="glow" aria-label="Glow interaction mode">Glow</button>
                <button class="matrix-select-btn" data-mode="shockwave" aria-label="Shockwave interaction mode">Shockwave</button>
              </div>
            </div>

            <!-- System Glitch Button -->
            <div class="control-group" style="margin-top: 1.25rem;">
              <button id="glitchBtn" class="matrix-action-btn" aria-label="Trigger Matrix Glitch Override">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z"/></svg>
                Glitch Override
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Hero 2-column grid layout */
    .hero-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 4rem;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 968px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 3rem;
      }
    }

    #networkCanvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Glassmorphic Telemetry Card */
    .hud-card {
      background: rgba(255, 255, 255, 0.45);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      border-radius: 16px;
      padding: 1.75rem;
      box-shadow: 0 8px 32px rgba(15, 23, 42, 0.04);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .hud-title {
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text);
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Pulsing Cobalt Status Indicator */
    .hud-pulse {
      width: 8px;
      height: 8px;
      background: #2563eb;
      border-radius: 50%;
      box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.5);
      animation: hud-pulse-anim 1.8s ease-out infinite;
    }

    @keyframes hud-pulse-anim {
      0%   { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.6); }
      100% { box-shadow: 0 0 0 8px rgba(37, 99, 235, 0); }
    }

    .hud-row {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid rgba(15, 23, 42, 0.04);
      padding: 0.65rem 0;
    }

    .hud-row:last-child {
      border-bottom: none;
    }

    .hud-label {
      color: var(--text-faint);
    }

    .hud-val {
      font-weight: 600;
      color: var(--text);
    }

    .hud-val.active {
      color: #2563eb;
    }

    .hud-val.restricted {
      color: #c2410c; /* Rust Red */
    }
  </style>

  <script>
    import '../scripts/matrix.js';
  </script>
</Layout>

