---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- ===========================================================
       HERO
       =========================================================== -->
  <section class="hero" aria-labelledby="heroTitle">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow">Technology · Geopolitics · Finance</p>
      <h1 class="hero-title" id="heroTitle">Rycode</h1>
      <p class="hero-tagline">
        High-integrity models, quantitative dashboards, and analytical briefings exploring complex global systems and emerging risks.
      </p>
      <div class="hero-cta">
        <a href="#projects" class="btn btn-primary">Explore the Projects <span aria-hidden="true">→</span></a>
        <a href="/research/saaspocalypse/index.html" class="btn btn-ghost">Read Briefings</a>
      </div>
    </div>
  </section>

  <!-- ===========================================================
       ABOUT
       =========================================================== -->
  <section id="about" class="section about" aria-labelledby="aboutTitle">
    <div class="container">
        <p class="section-eyebrow reveal">Overview</p>
        <h2 class="section-title reveal" id="aboutTitle">Modeling complex global systems.</h2>
        <div class="about-grid">
          <div class="about-text reveal">
            <p>Rycode is an independent research lab and developer hub. This platform serves as a workshop and catalog of custom interactive dashboards, systems models, and quantitative briefings exploring the intersections of emerging technology, economics, and geopolitics.</p>
            <p>Our goal is to build tools and research that translate complex market data, geopolitical sequences, and technical structures into digestible, interactive, and functional interfaces.</p>
          </div>
          <aside class="about-card reveal">
            <h3>Core Disciplines</h3>
            <ul>
              <li><strong>Geopolitical & Tech Analysis.</strong> Mapping strategic dependency risks, technology supply chains, and evolutionary trends.</li>
              <li><strong>Quantitative Modeling.</strong> Interactive dashboards that simulate economic formulas, stock movements, and financial cross-over curves in real time.</li>
              <li><strong>Technical Explainers.</strong> Visualizing high-stakes systems engineering and physical sequences through timelines and maps.</li>
              <li><strong>Functional Interfaces.</strong> Lightweight, high-fidelity browser apps designed for rapid exploration and analysis.</li>
            </ul>
          </aside>
      </div>
    </div>
  </section>

  <!-- ===========================================================
       PROJECTS GRID (BENTO SYSTEM)
       =========================================================== -->
  <section id="projects" class="section projects" aria-labelledby="projectsTitle">
    <div class="container">
      <p class="section-eyebrow reveal">Catalog</p>
      <h2 class="section-title reveal" id="projectsTitle">Systems and tools.</h2>
      <p class="section-lead reveal">Explore a curated catalog of custom-built software, dashboards, and research reports.</p>

      <div class="bento-grid">
        <!-- Card 1: GRC System (Double Width) -->
        <article class="project-card tilt reveal bento-w2" data-category="systems" style="transition-delay: 50ms;">
          <header class="project-head">
            <span class="card-category">Systems Suite</span>
            <span class="card-status is-live" aria-label="Status: Live, version 1.11.1">
              <span class="live-dot" aria-hidden="true"></span> Live · v1.11.1
            </span>
          </header>
          <div class="project-card-content">
            <h3 class="project-title">Rycode GRC</h3>
            <p class="project-desc">A complete governance, risk, and compliance suite built to model enterprise workflows. Features four interconnected registers (Entity, Risk, Control, and Defect), active browser database storage, and a dynamic 5×5 risk heat map designed for risk officers.</p>
          </div>
          <ul class="tag-row" aria-label="Technologies">
            <li>Governance</li><li>Chart.js</li><li>Risk Modeling</li><li>Vanilla JS</li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="/projects/grc.html">Case Study <span aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href="https://grc.rycode.dev/" target="_blank" rel="noopener">Open App</a>
          </div>
        </article>

        <!-- Card 2: Build vs Buy (Standard Width) -->
        <article class="project-card tilt reveal" data-category="dashboards" style="transition-delay: 100ms;">
          <header class="project-head">
            <span class="card-category">Analytical Dashboard</span>
            <span class="card-status is-live" aria-label="Status: Live, version 1.0">
              <span class="live-dot" aria-hidden="true"></span> Live · v1.0
            </span>
          </header>
          <div class="project-card-content">
            <h3 class="project-title">Build vs. Buy</h3>
            <p class="project-desc">Interactive financial cost calculator comparing proprietary software development costs against recurring SaaS licenses using 7 key parameters and dynamic intersection curve mapping.</p>
          </div>
          <ul class="tag-row" aria-label="Technologies">
            <li>Calculators</li><li>Chart.js</li><li>Finance</li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="/dashboards/build-vs-buy/index.html">Open Dashboard <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- Card 3: SaaSpocalypse (Standard Width) -->
        <article class="project-card tilt reveal" data-category="research" style="transition-delay: 150ms;">
          <header class="project-head">
            <span class="card-category">Research Report</span>
            <span class="card-status is-live" aria-label="Status: Live, version 1.0">
              <span class="live-dot" aria-hidden="true"></span> Live · v1.0
            </span>
          </header>
          <div class="project-card-content">
            <h3 class="project-title">SaaSpocalypse 2026</h3>
            <p class="project-desc">An emerging-risk intelligence briefing on the collapse of seat-based licensing models, the inversion of build-vs-buy decisions, and the growth vectors in modern GRC software.</p>
          </div>
          <ul class="tag-row" aria-label="Technologies">
            <li>Emerging Risk</li><li>Data Brief</li><li>Interactive Charts</li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="/research/saaspocalypse/index.html">Read Briefing <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- Card 4: Vendor Concentration (Double Width) -->
        <article class="project-card tilt reveal bento-w2" data-category="dashboards" style="transition-delay: 200ms;">
          <header class="project-head">
            <span class="card-category">Risk Tool</span>
            <span class="card-status is-live" aria-label="Status: Live, version 1.0">
              <span class="live-dot" aria-hidden="true"></span> Live · v1.0
            </span>
          </header>
          <div class="project-card-content">
            <h3 class="project-title">Vendor Concentration Dashboard</h3>
            <p class="project-desc">An interactive mapping tool designed to audit single-point-of-failure SaaS dependency risks. Users can map infrastructure across 30+ domains, simulate vendor outages, and instantly visualize the operational blast radius and systemic failover states.</p>
          </div>
          <ul class="tag-row" aria-label="Technologies">
            <li>Dependency Audits</li><li>Risk Mapping</li><li>Interactive Grid</li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="/dashboards/vendor-concentration/index.html">Open Dashboard <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- Card 5: Control Effectiveness (Standard Width) -->
        <article class="project-card tilt reveal" data-category="dashboards" style="transition-delay: 250ms;">
          <header class="project-head">
            <span class="card-category">Risk Calculator</span>
            <span class="card-status is-live" aria-label="Status: Live, version 1.0">
              <span class="live-dot" aria-hidden="true"></span> Live · v1.0
            </span>
          </header>
          <div class="project-card-content">
            <h3 class="project-title">Control Effectiveness</h3>
            <p class="project-desc">An ERM risk reduction calculator applying defense-in-depth formulas. Drag effectiveness sliders to calculate residual impact and export reports to CSV/PNG.</p>
          </div>
          <ul class="tag-row" aria-label="Technologies">
            <li>Enterprise Risk</li><li>CSV/PNG Export</li><li>Chart.js</li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="/dashboards/control-effectiveness/index.html">Open Calculator <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- Card 6: Grocery Swap (Standard Width) -->
        <article class="project-card tilt reveal" data-category="dashboards" style="transition-delay: 300ms;">
          <header class="project-head">
            <span class="card-category">B2B Dashboard</span>
            <span class="card-status is-live" aria-label="Status: Live, version 1.0">
              <span class="live-dot" aria-hidden="true"></span> Live · v1.0
            </span>
          </header>
          <div class="project-card-content">
            <h3 class="project-title">Grocery SKU Swap</h3>
            <p class="project-desc">A gross-margin calculation tool comparing proposed SKU shifts, incorporating transition overhead, slotting fees, shrink, and cannibalization with PDF output capabilities.</p>
          </div>
          <ul class="tag-row" aria-label="Technologies">
            <li>Gross Margin</li><li>Print-to-PDF</li><li>CSV Export</li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="/dashboards/grocery-swap-calc/index.html">Open Calculator <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- Card 7: Deployment Map (Standard Width) -->
        <article class="project-card tilt reveal" data-category="anatomy" style="transition-delay: 350ms;">
          <header class="project-head">
            <span class="card-category">Interactive Explainer</span>
            <span class="card-status is-live" aria-label="Status: Live, version 1.0">
              <span class="live-dot" aria-hidden="true"></span> Live · v1.0
            </span>
          </header>
          <div class="project-card-content">
            <h3 class="project-title">Anatomy of a Deployment</h3>
            <p class="project-desc">A walkable visual map illustrating the client-server lifecycle, following code from local commit directories to edge CDN caching and browser paint cycles.</p>
          </div>
          <ul class="tag-row" aria-label="Technologies">
            <li>Systems Explainer</li><li>Vanilla JS</li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="/anatomy/deployment/index.html">Explore Map <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- Card 8: Fission History (Standard Width) -->
        <article class="project-card tilt reveal" data-category="research" style="transition-delay: 400ms;">
          <header class="project-head">
            <span class="card-category">Technical History</span>
            <span class="card-status is-live" aria-label="Status: Live, version 1.0">
              <span class="live-dot" aria-hidden="true"></span> Live · v1.0
            </span>
          </header>
          <div class="project-card-content">
            <h3 class="project-title">Atomic Proliferation</h3>
            <p class="project-desc">A deep-dive technical layout mapping the physics, firing systems, and control frameworks of early nuclear systems as a supreme exercise in catastrophic risk containment.</p>
          </div>
          <ul class="tag-row" aria-label="Technologies">
            <li>History</li><li>Technical Briefing</li><li>Data Tables</li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="/research/fission/index.html">Read History <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- Card 9: Teller-Ulam Scroller (Standard Width) -->
        <article class="project-card tilt reveal" data-category="anatomy" style="transition-delay: 450ms;">
          <header class="project-head">
            <span class="card-category">Interactive Explainer</span>
            <span class="card-status is-live" aria-label="Status: Live, version 1.0">
              <span class="live-dot" aria-hidden="true"></span> Live · v1.0
            </span>
          </header>
          <div class="project-card-content">
            <h3 class="project-title">Teller–Ulam Scrubber</h3>
            <p class="project-desc">A milliseconds-scale timeline scrubber outlining the structural staging and physical sequences inside a thermonuclear reaction. Fully rendered in interactive SVGs.</p>
          </div>
          <ul class="tag-row" aria-label="Technologies">
            <li>Physics Explainer</li><li>SVG Scrubber</li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="/anatomy/teller-ulam/index.html">Open Scrubber <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ===========================================================
       CONTACT
       =========================================================== -->
  <section id="contact" class="section contact" aria-labelledby="contactTitle">
    <div class="container">
        <p class="section-eyebrow reveal">Collaborate</p>
        <h2 class="section-title reveal" id="contactTitle">Let's discuss models and systems design.</h2>
        <p class="section-lead reveal">Have inquiries regarding the dashboards, geopolitical maps, or interested in collaborating? Reach out.</p>
        <div class="contact-links reveal">
          <a class="btn btn-primary" href="mailto:contact@rycode.dev">Email Us</a>
          <a class="btn btn-ghost" href="https://github.com/jeffryanfl" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
    </div>
  </section>
</Layout>
