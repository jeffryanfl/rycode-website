---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rycode — Clean Editorial Journal">
  <div class="editorial-container">
    <!-- ===========================================================
         LEFT / CENTRAL WIDE EDITORIAL COLUMN
         =========================================================== -->
    <div class="editorial-main">
      <!-- ONE LARGE FEATURED STORY AT THE TOP -->
      <article class="featured-story">
        <div class="story-header">
          <span class="category-tag">AI Systems & Frontier Models</span>
          <span class="meta-date">August 18, 2026 · 8 min read</span>
        </div>

        <h1 class="featured-title">
          <a href="/ai/benchmarks">
            Frontier AI Model Benchmarks & Architectural Trade-offs
          </a>
        </h1>

        <p class="featured-deck">
          An empirical evaluation analyzing Kimi K3 MoE, DeepSeek V3/R1, MMLU-Pro, and SWE-bench performance across reasoning rigor, code generation precision, and low-precision inference economics.
        </p>

        <!-- Rectangular illustration / editorial artwork placeholder -->
        <div class="illustration-box" aria-label="Editorial Illustration Placeholder">
          <svg class="illustration-graphic" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="1.5"></rect>
            <line x1="3" y1="9" x2="21" y2="9" stroke-width="1.5"></line>
            <line x1="9" y1="21" x2="9" y2="9" stroke-width="1.5"></line>
            <circle cx="15" cy="15" r="2" stroke-width="1.5"></circle>
          </svg>
          <span class="illustration-caption">Editorial Schema · Frontier AI Systems Architecture</span>
        </div>
      </article>

      <!-- MULTI-COLUMN ARTICLE-STYLE CARDS GRID -->
      <section aria-labelledby="articlesHeading">
        <div class="article-grid-header">
          <h2 class="grid-section-title" id="articlesHeading">Latest Research & Technical Dossiers</h2>
          <span class="meta-date">6 Articles</span>
        </div>

        <div class="article-grid">
          <!-- Article Card 1 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Inference Engineering</span>
              <h3 class="card-headline">
                <a href="/ai/inference">Low-Precision NVFP4 & FP8 Serving Architectures</a>
              </h3>
              <p class="card-snippet">
                Serving frontier LLMs at scale with sub-byte quantization, KV-cache compression, and GPU memory bandwidth optimization.
              </p>
            </div>
            <div class="card-bottom">
              <span>6 min read</span>
              <a href="/ai/inference" class="read-more-link">
                Read Article →
              </a>
            </div>
          </article>

          <!-- Article Card 2 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Semiconductors</span>
              <h3 class="card-headline">
                <a href="/ai/supply-chain">8-Tier Global AI Silicon & Hardware Supply Chain</a>
              </h3>
              <p class="card-snippet">
                Mapping photolithography, wafer fabrication, advanced packaging, HBM3e memory, and optical networking bottlenecks.
              </p>
            </div>
            <div class="card-bottom">
              <span>12 min read</span>
              <a href="/ai/supply-chain" class="read-more-link">
                Read Article →
              </a>
            </div>
          </article>

          <!-- Article Card 3 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Power & Infrastructure</span>
              <h3 class="card-headline">
                <a href="/ai/energy-compute">Datacenter Power Constraints & SMR Nuclear Strategy</a>
              </h3>
              <p class="card-snippet">
                Analyzing hyperscale power requirements, small modular reactor deployment timelines, and grid interconnection queues.
              </p>
            </div>
            <div class="card-bottom">
              <span>7 min read</span>
              <a href="/ai/energy-compute" class="read-more-link">
                Read Article →
              </a>
            </div>
          </article>

          <!-- Article Card 4 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Interactive Reference</span>
              <h3 class="card-headline">
                <a href="/ai/glossary">Sampling Parameters & AI Engineering Glossary</a>
              </h3>
              <p class="card-snippet">
                Interactive simulator for temperature, top_p, top_k, and context windows alongside a dictionary of 89 essential AI terms.
              </p>
            </div>
            <div class="card-bottom">
              <span>Interactive</span>
              <a href="/ai/glossary" class="read-more-link">
                Open Simulator →
              </a>
            </div>
          </article>

          <!-- Article Card 5 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Developer Guide</span>
              <h3 class="card-headline">
                <a href="/ai/prompt-engineering">Prompt Engineering & Structured JSON Schemas</a>
              </h3>
              <p class="card-snippet">
                System prompt design, structured output enforcement, chain-of-thought orchestration, and context window optimization.
              </p>
            </div>
            <div class="card-bottom">
              <span>5 min read</span>
              <a href="/ai/prompt-engineering" class="read-more-link">
                Read Article →
              </a>
            </div>
          </article>

          <!-- Article Card 6 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Web Architecture</span>
              <h3 class="card-headline">
                <a href="/web-dev">Web Development & Vanilla CSS Design Systems</a>
              </h3>
              <p class="card-snippet">
                Developer workstation lab, full-stack application architectures, Astro client performance, and component specs.
              </p>
            </div>
            <div class="card-bottom">
              <span>Diagnostics</span>
              <a href="/web-dev" class="read-more-link">
                View Specs →
              </a>
            </div>
          </article>
        </div>
      </section>
    </div>

    <!-- ===========================================================
         RIGHT COLUMN - STACK OF 4 COMPACT PRIORITY CARDS
         =========================================================== -->
    <aside class="priority-sidebar" aria-label="Priority Briefings">
      <div class="sidebar-header">
        <h2 class="sidebar-title">Priority Stories</h2>
      </div>

      <div class="priority-stack">
        <!-- Priority Card 1 -->
        <article class="priority-card">
          <span class="priority-tag">Macroeconomics</span>
          <h3 class="priority-headline">
            <a href="/ai/macroeconomics">Hyperscale Capex Projections & ROI Economics</a>
          </h3>
          <p class="priority-desc">
            Evaluating capital expenditure efficiency, hardware depreciation curves, and enterprise adoption metrics.
          </p>
        </article>

        <!-- Priority Card 2 -->
        <article class="priority-card">
          <span class="priority-tag">Emerging Risk</span>
          <h3 class="priority-headline">
            <a href="/research/saaspocalypse/index.html">SaaSpocalypse 2026: The Software Inversion</a>
          </h3>
          <p class="priority-desc">
            Strategic analysis of seat-based SaaS model displacement by autonomous AI agents and in-house builds.
          </p>
        </article>

        <!-- Priority Card 3 -->
        <article class="priority-card">
          <span class="priority-tag">Strategic History</span>
          <h3 class="priority-headline">
            <a href="/research/fission/index.html">Fission: High-Stakes Risk Management</a>
          </h3>
          <p class="priority-desc">
            An open-source technical history of atomic systems framed as an extreme exercise in risk containment.
          </p>
        </article>

        <!-- Priority Card 4 -->
        <article class="priority-card">
          <span class="priority-tag">Governance & Risk</span>
          <h3 class="priority-headline">
            <a href="/grc">Enterprise Risk & Control Effectiveness</a>
          </h3>
          <p class="priority-desc">
            Quantitative risk aggregation, internal control effectiveness evaluation, and vendor concentration analytics.
          </p>
        </article>
      </div>
    </aside>
  </div>
</Layout>
