---
import Layout from '../layouts/Layout.astro';
import LandingTiles from '../components/LandingTiles.astro';
import '../styles/landing.css';

const sections = [
  { label: "Systems" },
  { label: "Tools", href: "/tools" },
  { label: "Research" },
];
---

<Layout
  title="Rycode — Systems, tools, and research"
  description="Systems, tools, and research."
  variant="landing"
>
  <section class="landing-stage">
    <h1 class="visually-hidden">Rycode</h1>
    <LandingTiles items={sections} />
  </section>
</Layout>
