---
import Layout from '../layouts/Layout.astro';
import '../styles/landing.css';
---

<Layout
  title="Rycode — Systems, tools, and research"
  description="Systems, tools, and research."
  variant="landing"
>
  <section class="landing-stage landing-stage--coverflow">
    <h1 class="visually-hidden">Rycode</h1>
    <ul class="landing-coverflow" data-coverflow data-active="tools">
      <li data-card="research">
        <a href="/research" aria-label="Research">
          <img src="/landing/panel-research.jpg" alt="" width="844" height="622" />
        </a>
      </li>
      <li data-card="tools">
        <a href="/tools" aria-label="Tools">
          <img src="/landing/panel-tools.jpg" alt="" width="722" height="628" />
        </a>
      </li>
      <li data-card="systems">
        <img src="/landing/panel-systems.jpg" alt="" width="706" height="552" />
        <span class="visually-hidden">Systems</span>
      </li>
    </ul>
    <a href="/ai" class="landing-brain" aria-label="A.I.">
      <img src="/landing/hub-brain.png" alt="" width="498" height="446" />
      <span class="landing-brain-kicker">A.I.</span>
    </a>
    <a href="/" class="landing-mark" aria-label="Rycode Home">
      <img src="/logo.svg" alt="Rycode" width="100" height="100" />
    </a>
  </section>
</Layout>

<script>
  const root = document.querySelector("[data-coverflow]");
  if (root instanceof HTMLElement) {
    const desktop = window.matchMedia("(min-width: 721px) and (hover: hover)");
    const routes: Record<string, string> = {
      research: "/research",
      tools: "/tools",
    };
    type Slot = "left" | "center" | "right";
    let slot: Slot = "center";
    let armed = true;
    let dwell: number | null = null;

    const activeCard = () => root.dataset.active || "tools";
    const occupant = (current: string, side: "left" | "right") => {
      if (side === "left") return current === "research" ? "tools" : "research";
      return current === "systems" ? "tools" : "systems";
    };
    const readSlot = (clientX: number): Slot => {
      const box = root.getBoundingClientRect();
      const x = (clientX - box.left) / box.width;
      if (slot === "center") {
        if (x < 0.24) return "left";
        if (x > 0.76) return "right";
        return "center";
      }
      if (slot === "left") {
        if (x > 0.38) return x > 0.76 ? "right" : "center";
        return "left";
      }
      if (x < 0.62) return x < 0.24 ? "left" : "center";
      return "right";
    };
    const cancelDwell = () => {
      if (dwell !== null) window.clearTimeout(dwell);
      dwell = null;
    };
    const reset = () => {
      cancelDwell();
      slot = "center";
      armed = true;
      root.dataset.active = "tools";
    };

    root.addEventListener("mousemove", (event) => {
      if (!desktop.matches) return;
      slot = readSlot(event.clientX);
      if (slot === "center") {
        cancelDwell();
        armed = true;
        return;
      }
      if (!armed) return;
      const next = occupant(activeCard(), slot);
      if (next === activeCard()) return;
      if (dwell !== null) return;
      dwell = window.setTimeout(() => {
        root.dataset.active = next;
        armed = false;
        dwell = null;
      }, 140);
    });
    root.addEventListener("click", (event) => {
      if (!desktop.matches) return;
      const link = event.target instanceof Element ? event.target.closest("a") : null;
      if (link instanceof HTMLAnchorElement) return;
      const href = routes[activeCard()];
      if (!href) return;
      window.location.assign(href);
    });
    root.addEventListener("mouseleave", reset);
    desktop.addEventListener("change", () => {
      if (!desktop.matches) reset();
    });
  }
</script>

