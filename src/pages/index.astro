---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rycode — Under Development" hideNavLinks={true}>
  <!-- ===========================================================
       HERO / MAINTENANCE
       =========================================================== -->
  <section class="hero" aria-labelledby="heroTitle">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow">Technology · Geopolitics · Finance</p>
      <h1 class="hero-title" id="heroTitle">Rycode</h1>
      <p class="hero-tagline">
        Our public portal is currently offline for scheduled updates. Custom dashboards, risk models, and quantitative briefings are temporarily restricted.
      </p>
      <div class="hero-cta">
        <span class="card-status is-live" aria-label="Status: Maintenance Mode Active" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;">
          <span class="live-dot" aria-hidden="true"></span> Active Maintenance Mode
        </span>
      </div>
    </div>
  </section>
</Layout>
