---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rycode — Under Development" hideNavLinks={true}>
  <!-- ===========================================================
       HERO / WORKSTATION PORTAL
       =========================================================== -->
  <section class="hero" aria-labelledby="heroTitle">
    <!-- Interactive Background Matrix Grid Canvas -->
    <div class="canvas-container">
      <canvas id="networkCanvas"></canvas>
    </div>

    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-grid">
        <!-- Brand / Tagline Column -->
        <div class="hero-text-block">
          <p class="hero-eyebrow">Technology · Geopolitics · Finance</p>
          <h1 class="hero-title" id="heroTitle">Rycode</h1>
          <p class="hero-tagline">
            An independent research lab and developer workshop exploring complex global systems. Our public interfaces, quantitative dashboards, and analytical briefings are currently undergoing scheduled system updates.
          </p>
        </div>

        <!-- Telemetry Diagnostics Column -->
        <div class="hud-container">
          <div class="hud-card">
            <h2 class="hud-title">
              <span class="hud-pulse" aria-hidden="true"></span>
              System Diagnostics
            </h2>
            <div class="hud-row">
              <span class="hud-label">LAB_STATUS</span>
              <span class="hud-val active">ONLINE</span>
            </div>
            <div class="hud-row">
              <span class="hud-label">MATRIX_GRID</span>
              <span class="hud-val">ACTIVE</span>
            </div>
            <div class="hud-row">
              <span class="hud-label">DECODED_CELLS</span>
              <span class="hud-val" id="hudActiveNodes">0 active</span>
            </div>
            <div class="hud-row">
              <span class="hud-label">PACKETS_SECURED</span>
              <span class="hud-val" id="hudPackets">14,832</span>
            </div>
            <div class="hud-row">
              <span class="hud-label">PUBLIC_PORTAL</span>
              <span class="hud-val restricted">RESTRICTED</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero 2-column grid layout */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @media (max-width: 968px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  /* Full-bleed background canvas container */
  .canvas-container {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.85;
  }

  #networkCanvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Glassmorphic Telemetry Card */
  .hud-card {
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 8px 32px rgba(15, 23, 42, 0.04);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .hud-title {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Pulsing Cobalt Status Indicator */
  .hud-pulse {
    width: 8px;
    height: 8px;
    background: #2563eb;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.5);
    animation: hud-pulse-anim 1.8s ease-out infinite;
  }

  @keyframes hud-pulse-anim {
    0%   { box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.6); }
    100% { box-shadow: 0 0 0 8px rgba(37, 99, 235, 0); }
  }

  .hud-row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgba(15, 23, 42, 0.04);
    padding: 0.65rem 0;
  }

  .hud-row:last-child {
    border-bottom: none;
  }

  .hud-label {
    color: var(--text-faint);
  }

  .hud-val {
    font-weight: 600;
    color: var(--text);
  }

  .hud-val.active {
    color: #2563eb;
  }

  .hud-val.restricted {
    color: #c2410c; /* Rust Red */
  }
</style>

<script is:inline>
  (() => {
    function init() {
      const canvas = document.getElementById('networkCanvas');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      const container = canvas.parentElement;
      if (!container) return;

      let width = 0;
      let height = 0;

      function resize() {
        const rect = container.getBoundingClientRect();
        if (canvas.width !== rect.width || canvas.height !== rect.height) {
          width = canvas.width = rect.width;
          height = canvas.height = rect.height;
        }
      }
      
      resize();

      const mouse = { x: null, y: null };
      const heroSection = document.querySelector('.hero');

      if (heroSection) {
        heroSection.addEventListener('mousemove', (e) => {
          const rect = canvas.getBoundingClientRect();
          mouse.x = e.clientX - rect.left;
          mouse.y = e.clientY - rect.top;
        });
        heroSection.addEventListener('mouseleave', () => {
          mouse.x = null;
          mouse.y = null;
        });
      }

      const activeNodesEl = document.getElementById('hudActiveNodes');
      const packetsEl = document.getElementById('hudPackets');
      let totalPackets = 14832;

      // Dynamically increment processed packets
      setInterval(() => {
        totalPackets += Math.floor(Math.random() * 3) + 1;
        if (packetsEl) packetsEl.textContent = totalPackets.toLocaleString();
      }, 1200);

      const spacing = 22; // Grid cell spacing
      const decodeChars = ['0', '1', 'ø', '+', 'x', 'a', 'f', '8', '3', 'e', '9', 'ø', '·'];

      function animate(time) {
        resize();

        ctx.clearRect(0, 0, width, height);

        if (width > 0 && height > 0) {
          const cols = Math.floor(width / spacing) + 1;
          const rows = Math.floor(height / spacing) + 1;

          ctx.font = '10px "Geist Mono", Monaco, "Courier New", monospace';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';

          let decodedCellsCount = 0;
          
          // Calculate a slow vertical drift offset based on time
          const offset = Math.floor(time / 300);

          for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
              const x = c * spacing;
              const y = r * spacing;

              // Default drifting matrix background character (0 or 1)
              let char = (c + Math.floor(r + offset)) % 2 === 0 ? '0' : '1';
              let isHovered = false;
              let alpha = 0.22; // High-visibility default opacity
              let glow = 0;

              if (mouse.x !== null && mouse.y !== null) {
                const dx = x - mouse.x;
                const dy = y - mouse.y;
                const dist = Math.hypot(dx, dy);

                // Decode radius
                if (dist < 130) {
                  isHovered = true;
                  decodedCellsCount++;
                  glow = 1 - dist / 130;
                  alpha = 0.22 + glow * 0.68;

                  // Flip character rapidly when hovered
                  if (Math.random() > 0.45) {
                    char = decodeChars[Math.floor(Math.random() * decodeChars.length)];
                  }
                }
              }

              if (isHovered) {
                ctx.fillStyle = `rgba(37, 99, 235, ${alpha})`;
                ctx.shadowColor = '#2563eb';
                ctx.shadowBlur = glow * 8;
              } else {
                ctx.fillStyle = `rgba(37, 99, 235, ${alpha})`;
                ctx.shadowBlur = 0;
              }

              ctx.fillText(char, x, y);
            }
          }

          // Update telemetry display
          if (activeNodesEl) {
            activeNodesEl.textContent = `${decodedCellsCount} cells`;
          }
        }

        requestAnimationFrame(animate);
      }

      requestAnimationFrame(animate);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
