---
import Layout from '../layouts/Layout.astro';
import '../styles/landing.css';
import '../styles/hub.css';
---

<Layout
  title="Rycode — Economics, risk, and systems"
  description="Economics, risk, and systems."
  variant="landing"
>
  <section class="landing-stage landing-stage--charcoal landing-stage--doors">
    <h1 class="visually-hidden">Rycode</h1>

    <a class="hub-tape hub-tape--top" id="hubAiTape" href="/ai/" hidden aria-label="A.I. tape">
      <span class="hub-tape-asof" data-hub-ai-tape-asof aria-hidden="true"></span>
      <span class="hub-tape-viewport" data-hub-ai-tape-viewport aria-hidden="true">
        <span class="hub-tape-track" data-hub-ai-tape-track></span>
      </span>
    </a>

    <nav class="hub-cluster" aria-label="Doors">
      <ul class="hub-doors">
        <li>
          <a class="hub-door" href="/economics/">
            <img class="hub-glyph hub-glyph--raster" src="/landing/hub-economics.webp" alt="" width="81" height="72" />
            <span>Economics</span>
          </a>
        </li>
        <li>
          <a class="hub-door" href="/risk/">
            <img class="hub-glyph hub-glyph--raster" src="/landing/hub-risk.webp" alt="" width="79" height="72" />
            <span>Risk</span>
          </a>
        </li>
        <li>
          <a class="hub-door" href="https://systems.rycode.dev" target="_blank" rel="noopener noreferrer">
            <img class="hub-glyph hub-glyph--raster" src="/landing/hub-systems.webp" alt="" width="80" height="72" />
            <span>Systems<span class="visually-hidden"> (opens in a new tab)</span></span>
          </a>
        </li>
        <li>
          <a class="hub-door" href="/ai/">
            <img class="hub-glyph hub-glyph--raster" src="/landing/hub-brain-overhead.webp" alt="" width="63" height="72" />
            <span>A.I.</span>
          </a>
        </li>
      </ul>
    </nav>

    <a class="hub-tape" id="hubTape" href="/economics/" hidden aria-label="Economics tape">
      <span class="hub-tape-asof" data-hub-tape-asof aria-hidden="true"></span>
      <span class="hub-tape-viewport" data-hub-tape-viewport aria-hidden="true">
        <span class="hub-tape-track" data-hub-tape-track></span>
      </span>
    </a>
  </section>
  <script is:inline src="/home-ai-tape.js" defer></script>
  <script is:inline src="/home-tape.js" defer></script>
</Layout>
