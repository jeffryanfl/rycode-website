---
import Layout from '../layouts/Layout.astro';
import '../styles/landing.css';

const sections = [
  { label: "AI" },
  { label: "Build" },
  { label: "Technology" },
  { label: "Systems" },
  { label: "Economics" },
  { label: "Engineering" },
  { label: "Tools" },
] as const;
---

<Layout title="Rycode — Working Notes & Systems Journal" variant="landing">
  <section class="landing-stage">
    <h1 class="visually-hidden">Rycode</h1>

    <div class="landing-rail">
      <ul>
        {sections.map((item) => (
          <li>
            <span class="landing-rail-link">
              <span class="landing-rail-label">{item.label}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
