---
import Layout from '../layouts/Layout.astro';
import '../styles/landing.css';
import '../styles/hub.css';
---

<Layout
  title="Rycode - Economics, risk, and systems"
  description="Economics, risk, and systems."
  variant="landing"
>
  <section class="landing-stage landing-stage--charcoal landing-stage--doors">
    <h1 class="visually-hidden">Rycode</h1>

    <div
      class="hub-tape hub-tape--top"
      id="hubAiTape"
      role="region"
      hidden
      aria-label="A.I. tape"
      data-tape-pause-label="Pause A.I. tape"
      data-tape-play-label="Play A.I. tape"
    >
      <a class="hub-tape-asof" data-hub-ai-tape-asof href="/ai/"></a>
      <button type="button" class="hub-tape-toggle" data-hub-tape-pause aria-pressed="false" aria-label="Pause A.I. tape" hidden>
        <span data-hub-tape-toggle-icon aria-hidden="true">||</span>
      </button>
      <span class="hub-tape-viewport" data-hub-ai-tape-viewport>
        <span class="hub-tape-track" data-hub-ai-tape-track></span>
      </span>
    </div>

    <nav class="hub-cluster" aria-label="Doors">
      <ul class="hub-doors">
        <li>
          <a class="hub-door" href="/economics/">
            <img class="hub-glyph hub-glyph--raster" src="/landing/hub-economics.webp" alt="" width="81" height="72" />
            <span>Economics</span>
          </a>
        </li>
        <li>
          <a class="hub-door" href="/risk/">
            <img class="hub-glyph hub-glyph--raster" src="/landing/hub-risk.webp" alt="" width="79" height="72" />
            <span>Risk</span>
          </a>
        </li>
        <li>
          <a class="hub-door" href="https://systems.rycode.dev" target="_blank" rel="noopener noreferrer">
            <img class="hub-glyph hub-glyph--raster" src="/landing/hub-systems.webp" alt="" width="80" height="72" />
            <span>Systems<span class="visually-hidden"> (opens in a new tab)</span></span>
          </a>
        </li>
        <li>
          <a class="hub-door" href="/ai/">
            <img class="hub-glyph hub-glyph--raster" src="/landing/hub-brain.webp" alt="" width="160" height="160" />
            <span>A.I.</span>
          </a>
        </li>
        <li>
          <a class="hub-door" href="/opinions/">
            <img class="hub-glyph hub-glyph--raster" src="/landing/hub-opinions.webp" alt="" width="80" height="72" />
            <span>Opinions</span>
          </a>
        </li>
      </ul>
    </nav>

    <div
      class="hub-tape"
      id="hubTape"
      hidden
      role="region"
      aria-label="Economics tape"
      data-tape-pause-label="Pause Economics tape"
      data-tape-play-label="Play Economics tape"
    >
      <a class="hub-tape-asof" data-hub-tape-asof href="/economics/"></a>
      <button type="button" class="hub-tape-toggle" data-hub-tape-pause aria-pressed="false" aria-label="Pause Economics tape" hidden>
        <span data-hub-tape-toggle-icon aria-hidden="true">||</span>
      </button>
      <span class="hub-tape-viewport" data-hub-tape-viewport>
        <span class="hub-tape-track" data-hub-tape-track></span>
      </span>
    </div>
  </section>
  <script is:inline src="/hub-tape-controls.js" defer></script>
  <script is:inline src="/home-ai-tape.js" defer></script>
  <script is:inline src="/home-tape.js" defer></script>
</Layout>
