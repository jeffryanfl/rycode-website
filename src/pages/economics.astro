---
import Layout from '../layouts/Layout.astro';
import '../styles/economics.css';

const pieces = [
  {
    href: '/economics/long-yields-hike-ai-credit-stress/',
    title: 'Long yields, the hike, and AI credit stress hit in the same week.',
    dek: 'The bond tape, the Fed vote, and data-center financing belong in one read.',
  },
  {
    href: '/economics/post-inflation-dollars-pay-pre-inflation-debts/',
    title: 'Inflation changes the real cost of fixed government debt.',
    dek: 'Repayment dollars buy less than the dollars borrowed. That does not pay the debt off.',
  },
  {
    href: '/economics/warsh-first-hike-oil-and-five-percent-ten-year/',
    title: 'The first hike arrived with oil above $100 and the ten-year near 5 percent.',
    dek: 'The 16 September 2026 vote was a quarter point. Energy and long rates were already tight.',
  },
  {
    href: '/economics/still-1998-not-1999/',
    title: 'This boom already has revenue and profit.',
    dek: 'The open question is the price paid for those earnings, and when private companies raise cash.',
  },
  {
    href: '/economics/saas-barbell-2026/',
    title: 'Software subscription stock prices fell in 2026 because the multiple fell.',
    dek: 'Investors paid less for a dollar of sales. Revenue did not disappear.',
  },
  {
    href: '/economics/jobs-print-was-strong-mix-is-the-story/',
    title: 'August payrolls were strong. The mix of jobs is the story.',
    dek: 'Hiring people who do the work with AI, not only people who manage that work.',
  },
  {
    href: '/economics/ten-trillion-to-roll/',
    title: 'About $10 trillion of U.S. debt comes due and has to be refinanced.',
    dek: 'Most of that is short-term bills the Treasury already replaces. The cash balance is a checking account, not a purchase program.',
  },
];
---

<Layout
  title="Economics — Rycode"
  description="Prices, cycles, and trade-offs."
  variant="economics"
>
  <div slot="economics-identity" class="economics-identity-block">
    <h1 class="economics-identity">
      <img class="economics-glyph" src="/landing/hub-economics.webp" alt="" width="81" height="72" />
      Economics
    </h1>
  </div>

  <ul class="economics-index">
    {pieces.map((piece) => (
      <li>
        <a href={piece.href}>
          <span class="economics-index-title">{piece.title}</span>
          <span class="economics-index-dek">{piece.dek}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
