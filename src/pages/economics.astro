---
import Layout from '../layouts/Layout.astro';
import '../styles/economics.css';

const pieces = [
  {
    href: '/economics/post-inflation-dollars-pay-pre-inflation-debts/',
    title: 'Post-inflation dollars pay pre-inflation debts',
    dek: 'Inflating fixed debt is real. It is not a clean reset.',
  },
  {
    href: '/economics/warsh-first-hike-oil-and-five-percent-ten-year/',
    title: 'Warsh’s first hike met oil above $100 and a five percent ten-year',
    dek: 'Clean, hawkish, and expensive for stock multiples.',
  },
  {
    href: '/economics/still-1998-not-1999/',
    title: 'Why this boom isn’t a repeat of the dot-com bubble',
    dek: 'The useful answer is still 1998. Real revenue and profits are here.',
  },
  {
    href: '/economics/jobs-print-was-strong-mix-is-the-story/',
    title: 'August jobs were strong. Who gets hired is the real story.',
    dek: 'The interesting part is who the next hire is.',
  },
  {
    href: '/economics/ten-trillion-to-roll/',
    title: 'Near ten trillion of U.S. debt comes due and must be refinanced',
    dek: 'Ten trillion to roll is the ordinary refinance. One trillion to buy is a checking account.',
  },
];

const saas = [
  {
    href: '/economics/saas-barbell-2026/',
    title: 'Software subscription stocks got cheaper. The industry did not die.',
    dek: 'SaaS is a pricing and durability problem, not a dying industry.',
  },
];
---

<Layout
  title="Economics — Rycode"
  description="Prices, cycles, and trade-offs."
  variant="economics"
>
  <div slot="economics-identity" class="economics-identity-block">
    <h1 class="economics-identity">
      <img class="economics-glyph" src="/landing/hub-economics.png" alt="" width="880" height="784" />
      Economics
    </h1>
    <p class="economics-identity-dek">Prices, cycles, and trade-offs. New pieces appear here as rows.</p>
  </div>

  <ul class="economics-index">
    {pieces.map((piece) => (
      <li>
        <a href={piece.href}>
          <span class="economics-index-title">{piece.title}</span>
          <span class="economics-index-dek">{piece.dek}</span>
        </a>
      </li>
    ))}
  </ul>

  <h2 class="economics-section">SaaS</h2>
  <ul class="economics-index">
    {saas.map((piece) => (
      <li>
        <a href={piece.href}>
          <span class="economics-index-title">{piece.title}</span>
          <span class="economics-index-dek">{piece.dek}</span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
