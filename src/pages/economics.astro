---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import EconomicsRail from '../components/EconomicsRail.astro';
import { findArticle, formatDate } from '../lib/site';
import '../styles/economics.css';

const rail = JSON.parse(
  fs.readFileSync(path.join(process.cwd(), 'public', 'economics-rail.json'), 'utf8'),
);

const pieces = [
  {
    href: '/economics/still-1998-not-1999/',
    title: 'This boom already has revenue and profit.',
    dek: 'The open question is the price paid for those earnings, and when private companies raise cash.',
  },
  {
    href: '/economics/jobs-print-was-strong-mix-is-the-story/',
    title: 'Payrolls and the jobs mix',
    dek: 'From the August 2026 jobs report, released 4 Sep 2026. Hiring people who do the work with AI, not only people who manage that work.',
  },
];

// Date comes from the article catalog, the same date the essay header uses.
const cards = pieces.map((piece) => {
  const article = findArticle(piece.href);
  return {
    ...piece,
    date: article?.date ?? '',
    dateLabel: article?.date ? formatDate(article.date) : '',
  };
});
---

<Layout
  title="Economics - Rycode"
  description="Prices, cycles, and trade-offs."
  variant="economics"
>
  <div slot="economics-identity" class="economics-identity-block">
    <h1 class="economics-identity">
      <img class="economics-glyph" src="/landing/hub-economics.webp" alt="" width="81" height="72" />
      Economics
    </h1>
  </div>

  <div class="economics-landing">
    <ul class="economics-index">
      {cards.map((piece) => (
        <li class="economics-piece-card">
          {piece.dateLabel && (
            <p class="economics-piece-meta">
              <time datetime={piece.date}>{piece.dateLabel}</time>
            </p>
          )}
          <h2 class="economics-piece-title">
            <a href={piece.href}>{piece.title}</a>
          </h2>
          <p class="economics-piece-dek">{piece.dek}</p>
        </li>
      ))}
    </ul>
    <EconomicsRail rail={rail} />
  </div>
</Layout>
