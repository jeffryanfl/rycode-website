---
/**
 * Brief behind "The 30-year yield holds near 6%" row on /risk/. Backstory is
 * dated text. Where we stand and the levels in What we're watching are built
 * from the row's feeds at build time (src/lib/briefs.ts), so they move with
 * every feed push. The long essay that lived here is in docs/archive/pages/risk/.
 */
import Layout from '../../layouts/Layout.astro';
import RiskWatch from '../../components/RiskWatch.astro';
import { thirtyYearBriefNow } from '../../lib/briefs';
import '../../styles/risk.css';

const title = 'The 30-year yield holds near 6%';
const subhead = 'If the 30-year Treasury yield reaches 6% and stays there, new long-term government debt and mortgages cost more. The numbers below come from the /risk/ watch-list feed.';

const brief = thirtyYearBriefNow();

const watchItems = [
  ...brief.watch,
  'How well 10-year and 30-year Treasury auctions go.',
  'The gap between mortgage rates and Treasury yields.',
  "4 Nov 2026: the last day of Treasury's enlarged long-end buybacks.",
];

const sources = [
  { text: 'U.S. Government Accountability Office, Treasury refinancing of maturing securities in fiscal year 2026', href: 'https://www.gao.gov/products/gao-26-107529' },
  { text: 'U.S. Treasury, Daily Treasury Par Yield Curve Rates', href: 'https://home.treasury.gov/resource-center/data-chart-center/interest-rates/TextView?type=daily_treasury_yield_curve&field_tdr_date_value=2026' },
  { text: 'U.S. Treasury, press release on long-end liquidity support buybacks', href: 'https://home.treasury.gov/news/press-releases/sb0607' },
];
---

<Layout
  title={`${title} - Rycode`}
  description={subhead}
  variant="risk"
>
  <article class="risk-digest risk-brief">
    <header class="risk-digest-head">
      <h1 class="risk-digest-title">{title}</h1>
      <p class="risk-digest-subhead">{subhead}</p>
    </header>

    <div class="risk-digest-main">
      <section class="risk-digest-section" id="backstory">
        <h2>Backstory</h2>
        <p>The US government has to refinance about $9.7 trillion of maturing securities in fiscal year 2026, according to the Government Accountability Office. That means replacing old debt with new debt, not paying it down. Most of it is short-term bills that Treasury already rolls over every week.</p>
        <p>The 30-year Treasury yield is the interest rate the government pays to borrow for 30 years. In late August 2026 it was about 5.21% to 5.26%. That made for an expensive year, not a crash. The bad outcome this page tracks is the 30-year yield going to about 6% and staying there through at least one round of long-term borrowing. A single day at 6% that fades does not count. A 6% rate that lasts raises the cost of new long-term government debt and of mortgages.</p>
        <p>Related trouble can show up first. Demand at Treasury auctions can weaken while the 30-year is still between 5.3% and 5.6%, and the gap between mortgage rates and Treasury yields can widen so households feel 6% mortgage pain before the Treasury yield gets there. Treasury has also enlarged its buybacks, purchases of its own older bonds that help keep them easy to trade, to at least $4 billion per operation in the 10-to-20-year and 20-to-30-year ranges, from 9 Sep through 4 Nov 2026.</p>
      </section>

      <section class="risk-digest-section" id="where-we-stand">
        <h2>Where we stand</h2>
        <p class="risk-brief-asof">{brief.asOf}</p>
        <p>{brief.level}</p>
        <p>{brief.range}</p>
        <p>{brief.strain}</p>
      </section>

      <section class="risk-digest-section" id="watching">
        <h2>What we're watching</h2>
        <RiskWatch items={watchItems} />
      </section>

      <section class="risk-digest-section risk-digest-sources" id="sources">
        <h2>Sources</h2>
        <ol>
          {sources.map((source) => (
            <li>
              <a href={source.href}>{source.text}</a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </article>
</Layout>

<style>
  .risk-brief .risk-digest-main {
    max-width: 44rem;
  }

  .risk-brief .risk-brief-asof {
    margin-top: -0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--digest-faint, rgba(248, 250, 252, 0.4));
  }
</style>
