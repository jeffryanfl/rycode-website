---
import Layout from '../layouts/Layout.astro';
import AiBenchCharts from '../components/AiBenchCharts.astro';
import AiWeekTicker from '../components/AiWeekTicker.astro';
import { agentToolsForDoor } from '../lib/agent-tools';
import '../styles/ai.css';
import '../styles/hub.css';

const agentDoorRows = agentToolsForDoor();
---

<Layout
  title="A.I. - Rycode"
  description="How the models actually work. New pieces appear here as rows."
  variant="ai"
>
  <div slot="ai-identity" class="ai-identity-block">
    <h1 class="ai-identity">
      <img class="ai-glyph" src="/landing/hub-brain-overhead.webp" alt="" width="63" height="72" />
      A.I.
    </h1>
  </div>

  <nav class="hub-cluster" aria-label="A.I. sections">
    <ul class="hub-doors">
      <li>
        <a class="hub-door" href="#ai-labs">
          <svg class="hub-glyph" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 6h8M18 8v5l-7 14h18l-7-14V8" />
            <path d="M13 22h14" />
          </svg>
          <span>Labs</span>
        </a>
      </li>
      <li>
        <a class="hub-door" href="#ai-papers">
          <svg class="hub-glyph" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 6h9l7 7v21H13z" />
            <path d="M22 6v7h7M17 20h8M17 25h8M17 30h5" />
          </svg>
          <span>Papers</span>
        </a>
      </li>
      <li>
        <a class="hub-door" href="#ai-open-weight">
          <svg class="hub-glyph" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 16l12-6 12 6-12 6z" />
            <path d="M8 16v10l12 6V22M32 16v10l-12 6" />
          </svg>
          <span>Open weight</span>
        </a>
      </li>
      <li>
        <a class="hub-door" href="#ai-agent-tools">
          <svg class="hub-glyph" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="20" cy="14" r="4" />
            <path d="M12 32c0-4.4 3.6-8 8-8s8 3.6 8 8" />
            <path d="M29 9l.8 1.6 1.7.3-1.3 1.1.3 1.7-1.5-.9-1.5.9.3-1.7-1.3-1.1 1.7-.3z" />
          </svg>
          <span>Agents</span>
        </a>
      </li>
      <li>
        <a class="hub-door" href="/ai/hardware/">
          <svg class="hub-glyph" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="11" y="6" width="18" height="7" rx="1" />
            <rect x="11" y="16.5" width="18" height="7" rx="1" />
            <rect x="11" y="27" width="18" height="7" rx="1" />
            <path d="M15 9.5h4M15 20h4M15 30.5h4" />
          </svg>
          <span>Hardware</span>
        </a>
      </li>
      <li>
        <a class="hub-door" href="/ai/swarms/">
          <svg class="hub-glyph" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="20" cy="9" r="3" />
            <circle cx="9" cy="29" r="3" />
            <circle cx="31" cy="29" r="3" />
            <path d="M20 12 L11 26M20 12 L29 26M12 29h16" />
          </svg>
          <span>Swarms</span>
        </a>
      </li>
      <li>
        <a class="hub-door" href="/ai/glossary/">
          <svg class="hub-glyph" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c-4-2.2-8.2-2.6-12-1.2v20.2c3.8-1.4 8-.1 12 1.4" />
            <path d="M20 10c4-2.2 8.2-2.6 12-1.2v20.2c-3.8-1.4-8-.1-12 1.4" />
          </svg>
          <span>Glossary</span>
        </a>
      </li>
    </ul>
  </nav>

  <AiWeekTicker />

  <AiBenchCharts />

  <section class="ai-band ai-papers" aria-labelledby="ai-score-updates">
    <h2 class="ai-section-label" id="ai-score-updates">Score updates</h2>
    <p class="ai-lab-note">New model pages on <a href="https://artificialanalysis.ai/">Artificial Analysis</a>, an independent group that runs the same tests on every model.</p>
    <ul class="ai-papers-chips">
      <li>
        <a href="https://artificialanalysis.ai/models/deepseek-v4-1-flash-1017">
          <time class="ai-papers-chip-date" datetime="2026-10-18">18 Oct</time>
          <span class="ai-papers-chip-title">AA DeepSeek Flash 1017</span>
          <span class="ai-papers-chip-source">AA</span>
        </a>
      </li>
      <li>
        <a href="https://artificialanalysis.ai/articles/reflection-beam">
          <time class="ai-papers-chip-date" datetime="2026-10-16">16 Oct</time>
          <span class="ai-papers-chip-title">AA Beam 1.0</span>
          <span class="ai-papers-chip-source">AA</span>
        </a>
      </li>
      <li>
        <a href="https://artificialanalysis.ai/models/muse-spark-open">
          <time class="ai-papers-chip-date" datetime="2026-10-15">15 Oct</time>
          <span class="ai-papers-chip-title">AA Spark Open</span>
          <span class="ai-papers-chip-source">AA</span>
        </a>
      </li>
      <li>
        <a href="https://artificialanalysis.ai/models/muse-wonder">
          <time class="ai-papers-chip-date" datetime="2026-10-12">12 Oct</time>
          <span class="ai-papers-chip-title">AA Wonder</span>
          <span class="ai-papers-chip-source">AA</span>
        </a>
      </li>
      <li>
        <a href="https://artificialanalysis.ai/models/claude-haiku-5-5">
          <time class="ai-papers-chip-date" datetime="2026-10-07">7 Oct</time>
          <span class="ai-papers-chip-title">AA Haiku 5.5</span>
          <span class="ai-papers-chip-source">AA</span>
        </a>
      </li>
      <li>
        <a href="https://artificialanalysis.ai/models/claude-sonnet-5-5">
          <time class="ai-papers-chip-date" datetime="2026-10-05">5 Oct</time>
