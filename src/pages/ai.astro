  <section class="ai-band" aria-labelledby="ai-agent-tools">
    <h2 class="ai-section-label" id="ai-agent-tools">Agent tools</h2>
    <p class="ai-lab-note">Personal agents that work in the background on a cloud computer and through your apps.</p>
    <ul class="ai-agent-door-list">
      {agentDoorRows.map((tool) => (
        <li class="ai-agent-door-row">
          <a href={`/ai/agents/${tool.slug}/`}>{tool.name}</a>
          <span class="ai-agent-door-maker">{tool.maker}</span>
          <span class="ai-agent-door-line">{tool.doorLine}</span>
        </li>
      ))}
    </ul>
    <p class="ai-agent-door-all"><a href="/ai/agents/">All agent tools</a></p>
  </section>

  <section class="ai-band ai-papers" aria-labelledby="ai-products">
    <h2 class="ai-section-label" id="ai-products">Products and features</h2>
    <p class="ai-lab-note">Apps, agents and features built on top of models. They are not models themselves.</p>
    <ul class="ai-papers-chips">
      <li>
        <a href="/ai/models/openai/gpt-6-intelligent-ui/">
          <time class="ai-papers-chip-date" datetime="2026-10-08">8 Oct</time>
          <span class="ai-papers-chip-title">Intelligent UI card</span>
          <span class="ai-papers-chip-source">docs</span>
