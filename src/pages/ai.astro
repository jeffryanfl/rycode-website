---
import Layout from '../layouts/Layout.astro';
import '../styles/ai.css';
---

<Layout
  title="A.I. — Rycode"
  description="How the models actually work. New pieces appear here as rows."
  variant="ai"
>
  <div slot="ai-identity" class="ai-identity-block">
    <h1 class="ai-identity">
      <img class="ai-glyph" src="/landing/hub-brain-overhead.png" alt="" width="742" height="851" />
      A.I.
    </h1>
    <p class="ai-identity-dek">How the models actually work. New pieces appear here as rows.</p>
  </div>

  <div class="ai-split">
    <section aria-labelledby="ai-deep-dive">
      <h2 class="ai-kicker" id="ai-deep-dive">Deep dive</h2>
      <ol class="ai-dive">
        <li>
          <a href="/ai/next-token-engine/">
            <time class="ai-dive-date" datetime="2026-08-25">25 Aug 2026</time>
            <span class="ai-dive-title">A next-token engine with an RLVR post-train and a tool loop.</span>
            <span class="ai-dive-dek">How staged training and tools shape a next-token engine.</span>
          </a>
        </li>
      </ol>
    </section>

    <section aria-labelledby="ai-models">
      <h2 class="ai-kicker" id="ai-models">Models</h2>
      <div class="ai-lab-list">
        <a class="ai-lab-card" href="/ai/models/anthropic/">
          <span>
            <span class="ai-lab-card-title">Anthropic</span>
            <span class="ai-lab-card-dek">Claude frontier lineup</span>
          </span>
          <span class="ai-lab-card-chevron" aria-hidden="true">›</span>
        </a>
        <a class="ai-lab-card" href="/ai/models/openai/">
          <span>
            <span class="ai-lab-card-title">OpenAI</span>
            <span class="ai-lab-card-dek">GPT frontier lineup</span>
          </span>
          <span class="ai-lab-card-chevron" aria-hidden="true">›</span>
        </a>
      </div>
    </section>
  </div>
</Layout>
