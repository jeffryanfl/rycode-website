---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Governance, Risk & Compliance — Rycode Library">
  <div class="editorial-container">
    <div class="editorial-main" style="grid-column: span 2;">
      <section class="subpage-hero">
        <p class="subpage-eyebrow">Library · Governance Systems</p>
        <h1 class="subpage-title">Governance, Risk & Compliance (GRC)</h1>
        <p class="subpage-lead">
          A curated collection of enterprise risk aggregation frameworks, internal control effectiveness models, vendor concentration analytics, and quantitative risk tools.
        </p>
        
        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
          <a href="/" class="read-more-link" style="font-size: 1rem;">← Return to Editorial Home</a>
          <a href="/ai" class="read-more-link" style="font-size: 1rem;">Explore AI Governance →</a>
        </div>
      </section>

      <section aria-labelledby="grcHeading">
        <div class="article-grid-header">
          <h2 class="grid-section-title" id="grcHeading">Risk Management Tools & Frameworks</h2>
          <span class="meta-date">4 Systems</span>
        </div>

        <div class="article-grid">
          <!-- Tool 1 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Risk Calculator</span>
              <h3 class="card-headline">
                <a href="/dashboards/control-effectiveness/index.html">Control Effectiveness Matrix</a>
              </h3>
              <p class="card-snippet">
                An ERM risk reduction calculator applying defense-in-depth formulas to evaluate internal control design, operating effectiveness, and residual risk.
              </p>
            </div>
            <div class="card-bottom">
              <span>Interactive Dashboard</span>
              <a href="/dashboards/control-effectiveness/index.html" class="read-more-link">Open Calculator →</a>
            </div>
          </article>

          <!-- Tool 2 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Supply Chain Risk</span>
              <h3 class="card-headline">
                <a href="/dashboards/vendor-concentration/index.html">Vendor Concentration Dashboard</a>
              </h3>
              <p class="card-snippet">
                An interactive mapping tool designed to audit single-point-of-failure SaaS dependency risks and simulate operational blast radius across infrastructure.
              </p>
            </div>
            <div class="card-bottom">
              <span>Interactive Tool</span>
              <a href="/dashboards/vendor-concentration/index.html" class="read-more-link">Open Dashboard →</a>
            </div>
          </article>

          <!-- Tool 3 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Systems Architecture</span>
              <h3 class="card-headline">
                <a href="/projects/grc.html">Rycode GRC Suite Case Study</a>
              </h3>
              <p class="card-snippet">
                A complete governance, risk, and compliance platform featuring four interconnected registers (Entity, Risk, Control, Defect) and a dynamic 5×5 heat map.
              </p>
            </div>
            <div class="card-bottom">
              <span>Case Study</span>
              <a href="/projects/grc.html" class="read-more-link">View Case Study →</a>
            </div>
          </article>

          <!-- Tool 4 -->
          <article class="article-card">
            <div class="card-top">
              <span class="card-category-label">Financial Economics</span>
              <h3 class="card-headline">
                <a href="/dashboards/build-vs-buy/index.html">Build vs. Buy Economics Model</a>
              </h3>
              <p class="card-snippet">
                Interactive financial model calculating total cost of ownership, crossover timelines, and risk tradeoffs between internal builds and SaaS licenses.
              </p>
            </div>
            <div class="card-bottom">
              <span>Calculator</span>
              <a href="/dashboards/build-vs-buy/index.html" class="read-more-link">Open Model →</a>
            </div>
          </article>
        </div>
      </section>
    </div>
  </div>
</Layout>
