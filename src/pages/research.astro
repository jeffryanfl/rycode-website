---
import Layout from '../layouts/Layout.astro';
import '../styles/research.css';

const notes = [
  {
    href: '/research/ten-trillion-to-roll/',
    date: '2026-09-01',
    dateLabel: '1 Sep 2026',
    title: 'Ten trillion to roll, one trillion to buy',
    dek: 'Ten trillion to roll is the ordinary refinance. One trillion to buy is a checking account.',
  },
];

const saas = [
  {
    href: '/research/saas-barbell-2026/',
    date: '2026-08-25',
    dateLabel: '25 Aug 2026',
    title: 'The SaaSpocalypse was a multiple, not a market.',
    dek: 'SaaS is a pricing and durability problem, not a dying industry.',
  },
];
---

<Layout
  title="Research — Rycode"
  description="Essays and research notes. New topics appear here as rows."
  variant="research"
>
  <div slot="research-identity" class="research-identity-block">
    <h1 class="research-identity">
      <svg class="research-glyph" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="10.2" cy="10.2" r="6.2" stroke="currentColor" stroke-width="1" />
        <path d="M14.7 14.7 L20.2 20.2" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
      </svg>
      Research
    </h1>
    <p class="research-identity-dek">Essays and research notes. New topics appear here as rows.</p>
  </div>

  <ol class="research-index">
    {notes.map((piece) => (
      <li>
        <a href={piece.href}>
          <time class="research-index-date" datetime={piece.date}>{piece.dateLabel}</time>
          <span class="research-index-title">{piece.title}</span>
          <span class="research-index-dek">{piece.dek}</span>
        </a>
      </li>
    ))}
  </ol>

  <h2 class="research-index-kicker">SaaS</h2>
  <ol class="research-index">
    {saas.map((piece) => (
      <li>
        <a href={piece.href}>
          <time class="research-index-date" datetime={piece.date}>{piece.dateLabel}</time>
          <span class="research-index-title">{piece.title}</span>
          <span class="research-index-dek">{piece.dek}</span>
        </a>
      </li>
    ))}
  </ol>
</Layout>
