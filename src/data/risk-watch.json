    {
      "id": "debt-refi",
      "kind": "chain",
      "risk": "Debt refinancing",
      "brief": "/risk/when-the-spender-runs-the-printer/",
      "why": "Treasury has to sell more debt at auction. When buyers bid less, yields rise and the cost reaches mortgages.",
      "key": "Each dashed line is the recent average the latest reading is compared with.",
      "steps": [
        {
          "id": "borrow",
          "step": "1 Borrow",
          "title": "Treasury borrows more",
          "tracker": "Treasury net marketable borrowing, by quarter",
          "trackerHref": "https://home.treasury.gov/policy-issues/financing-the-government/quarterly-refunding/most-recent-quarterly-refunding-documents",
          "reading": {
            "feed": "public/debt-refi.json",
            "series": "borrowing",
            "key": "value",
            "format": "billions",
            "frequency": "quarterly"
          },
          "trend": {
            "all": true,
            "unit": "quarters"
          },
          "compare": {
            "type": "prior",
            "n": 4,
            "label": "4-quarter average",
            "short": "4-qtr avg"
          },
          "extra": {
            "label": "Latest actual",
            "where": {
              "key": "status",
              "equals": "actual"
            },
            "reading": {
              "feed": "public/debt-refi.json",
              "series": "borrowing",
              "key": "value",
              "format": "billions",
              "frequency": "quarterly"
            }
          },
          "list": true,
          "why": "This is new debt sold to private buyers. More of it means more to sell at each auction."
        },
        {
          "id": "auctions",
          "step": "2 Auctions",
          "title": "Buyers bid at auction",
          "tracker": "10-year note auctions, bid-to-cover",
          "trackerHref": "https://fiscaldata.treasury.gov/datasets/treasury-securities-auctions-data/auctions",
          "reading": {
            "feed": "public/debt-refi.json",
            "series": "auctions10y",
            "key": "bidToCover",
            "format": "ratio"
          },
          "trend": {
            "all": true,
            "unit": "auctions"
          },
          "compare": {
            "type": "prior",
            "n": 6,
            "label": "6-auction average",
            "short": "6-auction avg",
            "flagBelow": "weaker than recent"
          },
          "extra": {
            "label": "High yield at this auction",
            "reading": {
              "feed": "public/debt-refi.json",
              "series": "auctions10y",
              "key": "highYield",
              "format": "percent3"
            }
          },
          "why": "Bid-to-cover is the dollars bid for each dollar sold. Lower means weaker demand, and the sale clears at a higher yield."
        },
        {
          "id": "costs",
          "step": "3 Costs",
          "title": "Borrowing costs rise",
          "tracker": "Freddie Mac 30-year mortgage rate, weekly",
          "trackerHref": "https://fred.stlouisfed.org/series/MORTGAGE30US",
          "reading": {
            "feed": "public/debt-refi.json",
            "series": "mortgage30",
            "key": "rate",
            "format": "percent"
          },
          "trend": {
            "weeks": 52
          },
          "compare": {
            "type": "trailing",
            "n": 13,
            "label": "13-week average",
            "short": "13-wk avg"
          },
          "extra": {
            "label": "Prior week",
            "pick": "previous",
            "reading": {
              "feed": "public/debt-refi.json",
              "series": "mortgage30",
              "key": "rate",
              "format": "percent"
            }
          },
          "why": "Mortgage rates follow Treasury yields, so weak auctions reach household loans."
        }
      ]
