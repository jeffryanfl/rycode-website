---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a href="/" class:list={['masthead-home', className]} aria-label="Rycode home">
  <svg viewBox="0 0 56 56" fill="none" aria-hidden="true" width="56" height="56">
    <rect x="1" y="1" width="54" height="54" stroke="currentColor" stroke-width="1"></rect>
    <text x="9" y="19" fill="currentColor" font-family="Inter, sans-serif" font-size="11" font-weight="500">26</text>
    <text x="28" y="44" text-anchor="middle" fill="currentColor" font-family="Inter, sans-serif" font-size="20" font-weight="650">Ry</text>
  </svg>
  <span class="masthead-wordmark">Rycode</span>
</a>
