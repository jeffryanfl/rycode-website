---
import '../styles/economics-rail.css';
import Chart from './Chart.astro';
import { safeHref } from '../lib/safe-href';

interface RailLine {
  key: string;
  label: string;
  color: string;
}

interface RailPoint {
  date: string;
  [key: string]: string | number | null | undefined;
}

interface RailSeries {
  id: string;
  title: string;
  unit: string;
  tabs: string[];
  source?: string | null;
  sourceLabel?: string;
  lines: RailLine[];
  points: RailPoint[];
}

interface RailFile {
  series: RailSeries[];
}

interface Props {
  rail: RailFile;
}

const { rail } = Astro.props;
const series = Array.isArray(rail?.series) ? rail.series : [];

type Grain = 'daily' | 'weekly' | 'monthly' | 'yearly';

type Plot = {
  id: string;
  heading: string | null;
  unit: string;
  lines: RailLine[];
  points: RailPoint[];
  tabs: string[];
};

type Card = {
  id: string;
  title: string;
  source?: string | null;
  sourceLabel?: string;
  plots: Plot[];
};

function toCards(items: RailSeries[]): Card[] {
  return items.map((item) => {
    if (item.id === 'yields') {
      return {
        id: item.id,
        title: item.title,
        source: item.source,
        sourceLabel: item.sourceLabel,
        plots: item.lines.map((line) => ({
          id: `${item.id}-${line.key}`,
          heading: line.label,
          unit: item.unit,
          lines: [line],
          points: item.points,
          tabs: item.tabs,
        })),
      };
    }
    return {
      id: item.id,
      title: item.title,
      source: item.source,
      sourceLabel: item.sourceLabel,
      plots: [
        {
          id: item.id,
          heading: null,
          unit: item.unit,
          lines: item.lines,
          points: item.points,
          tabs: item.tabs,
        },
      ],
    };
  });
}

const cards = toCards(series);

function isoWeekKey(date: string): string {
  const d = new Date(`${date}T12:00:00Z`);
  const day = d.getUTCDay() || 7;
  d.setUTCDate(d.getUTCDate() + 4 - day);
  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
  const week = Math.ceil(((d.getTime() - yearStart.getTime()) / 86400000 + 1) / 7);
  return `${d.getUTCFullYear()}-W${String(week).padStart(2, '0')}`;
}

function bucket(points: RailPoint[], grain: Grain): RailPoint[] {
  if (grain === 'daily') return points;
  const last = new Map<string, RailPoint>();
  for (const point of points) {
    const key =
      grain === 'weekly'
        ? isoWeekKey(point.date)
        : grain === 'monthly'
          ? point.date.slice(0, 7)
          : point.date.slice(0, 4);
    last.set(key, point);
  }
  return [...last.values()];
}

// Tabs zoom the window. Resampling 1990–now at every grain draws the same
// long arc. Daily is the recent tape. Yearly is the full history.
const LOOKBACK_DAYS: Record<Grain, number | null> = {
  daily: 90,
  weekly: 365 * 2,
  monthly: 365 * 10,
  yearly: null,
};

function viewPoints(points: RailPoint[], grain: Grain): RailPoint[] {
  const sorted = [...points].filter((p) => typeof p.date === 'string').sort((a, b) => a.date.localeCompare(b.date));
  const days = LOOKBACK_DAYS[grain];
  let windowed = sorted;
  if (days != null && sorted.length > 0) {
    const end = sorted[sorted.length - 1].date;
    const cutoff = new Date(`${end}T12:00:00Z`);
    cutoff.setUTCDate(cutoff.getUTCDate() - days);
    const cut = cutoff.toISOString().slice(0, 10);
    windowed = sorted.filter((p) => p.date >= cut);
  }
  return bucket(windowed, grain);
}

function formatY(value: number, unit: string): string {
  const abs = Math.abs(value);
  const sign = value < 0 ? '−' : '';
  if (unit === 'percent') return `${sign}${abs.toFixed(1)}%`;
  if (abs >= 1e12) return `${sign}$${(abs / 1e12).toFixed(1)}T`;
  if (abs >= 1e9) {
    const billions = abs / 1e9;
    return `${sign}$${billions >= 100 ? billions.toFixed(0) : billions.toFixed(1)}B`;
  }
  if (abs >= 1e6) return `${sign}$${(abs / 1e6).toFixed(0)}M`;
  return `${sign}$${abs.toFixed(0)}`;
}

function formatX(date: string, first: string, last: string): string {
  const span = (Date.parse(`${last}T12:00:00Z`) - Date.parse(`${first}T12:00:00Z`)) / 86400000;
  if (!Number.isFinite(span) || span > 500) return date.slice(0, 4);
  if (span > 40) return date.slice(0, 7);
  return date.slice(5);
}

const YIELD_TOKEN: Record<string, `s${1 | 2 | 3}`> = { y2: 's1', y10: 's2', y30: 's3' };

function lineToken(line: RailLine, index: number, cardId: string): `s${1 | 2 | 3 | 4 | 5 | 6 | 7 | 8 | 9}` {
  if (cardId === 'yields' && YIELD_TOKEN[line.key]) return YIELD_TOKEN[line.key];
  const n = Math.min(index + 1, 9) as 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8 | 9;
  return `s${n}`;
}

function panelChart(points: RailPoint[], lines: RailLine[], unit: string, cardId: string) {
  if (points.length === 0) return null;
  const nums: number[] = [];
  for (const point of points) {
    for (const line of lines) {
      const value = point[line.key];
      if (typeof value === 'number' && Number.isFinite(value)) nums.push(value);
    }
  }
  if (!nums.length) return null;
  const lastPoint = points[points.length - 1];
  const latest = lines
    .map((line) => {
      const value = lastPoint[line.key];
      if (typeof value !== 'number' || !Number.isFinite(value)) return null;
      return { label: line.label, value: formatY(value, unit) };
    })
    .filter((row): row is { label: string; value: string } => row !== null);
  const dates = points.map((p) => p.date);
  const series = lines.map((line, index) => ({
    name: line.label,
    token: lineToken(line, index, cardId),
    main: index === 0,
    values: points.map((p) => {
      const v = p[line.key];
      return typeof v === 'number' && Number.isFinite(v) ? v : null;
    }),
  }));
  return { dates, series, latest, asOf: lastPoint.date };
}

const tabLabel: Record<string, string> = {
  daily: 'Daily',
  weekly: 'Weekly',
  monthly: 'Monthly',
  yearly: 'Yearly',
};
---

<aside class="econ-rail" aria-label="Economics series">
  {cards.map((card) => (
    <section class="econ-rail-card" aria-labelledby={`econ-rail-${card.id}-title`}>
      <h2 id={`econ-rail-${card.id}-title`}>{card.title}</h2>
      {card.plots.map((plot) => (
        <div class="econ-rail-plot">
          {plot.heading ? <h3>{plot.heading}</h3> : null}
          {plot.points.length === 0 ? (
            <p class="econ-rail-empty">No points yet.</p>
          ) : (
            <div class="econ-rail-tabs">
              {plot.tabs.map((tab, index) => {
                const drawn = panelChart(viewPoints(plot.points, tab as Grain), plot.lines, plot.unit, card.id);
                const inputId = `econ-rail-${plot.id}-${tab}`;
                const name = `econ-rail-${plot.id}`;
                return (
                  <>
                    <input
                      class="econ-rail-tab-input"
                      type="radio"
                      name={name}
                      id={inputId}
                      checked={index === 0}
                    />
                    <label class="econ-rail-tab" for={inputId}>{tabLabel[tab] || tab}</label>
                    <div class="econ-rail-panel">
                      {drawn ? (
                        <Chart
                          kind="line"
                          size="card"
                          title={`${card.title}${plot.heading ? ` · ${plot.heading}` : ''} · ${tabLabel[tab] || tab}`}
                          frame={true}
                          dates={drawn.dates}
                          series={drawn.series}
                          unit={plot.unit}
                          sourceHref={safeHref(card.source) ?? undefined}
                          sourceLabel={card.sourceLabel ?? card.title}
                          asOf={drawn.asOf}
                          numbers={drawn.latest.map((row) => ({ label: row.label, cells: [row.value] }))}
                          numberColumns={['Series', `As of ${drawn.asOf}`]}
                        />
                      ) : (
                        <p class="econ-rail-empty">No points yet.</p>
                      )}
                    </div>
                  </>
                );
              })}
            </div>
          )}
        </div>
      ))}
    </section>
  ))}
</aside>
