---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  {
    label: "AI",
    href: "/ai"
  },
  {
    label: "Build",
    href: "/build"
  },
  {
    label: "Technology",
    href: "/technology"
  },
  {
    label: "Systems",
    href: "/systems"
  },
  {
    label: "Economics",
    href: "/economics"
  },
  {
    label: "Engineering",
    href: "/engineering"
  },
  {
    label: "Tools",
    href: "/tools"
  }
];
---

<nav class="newspaper-banner-nav" aria-label="Sections">
  <div class="newspaper-banner-inner">
    <ul class="newspaper-nav-list" role="menubar">
      {navItems.map((item, idx) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <li class="newspaper-nav-item" role="none">
            <a
              href={item.href}
              class:list={[
                "newspaper-nav-link",
                { "is-active": isActive }
              ]}
              role="menuitem"
              aria-current={isActive ? "page" : undefined}
            >
              <span class="newspaper-link-text">{item.label}</span>
            </a>
            {idx < navItems.length - 1 && (
              <span class="newspaper-nav-separator" aria-hidden="true">/</span>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<style>
  /* ==================================================================
     NEWSPAPER BROADSHEET HEADLINE BANNER NAVIGATION
     Double hairline rules, tracked uppercase typography, stately print feel
     ================================================================== */

  .newspaper-banner-nav {
    width: 100%;
    margin-top: 1rem;
    border-top: 1px solid var(--text, #0F172A);
    border-bottom: 2px solid var(--text, #0F172A);
    position: relative;
    background: transparent;
  }

  .newspaper-banner-nav::after {
    content: '';
    display: block;
    width: 100%;
    height: 1px;
    background: var(--text, #0F172A);
    margin-top: 2px;
  }

  .newspaper-banner-inner {
    max-width: 100%;
    margin: 0 auto;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }

  .newspaper-banner-inner::-webkit-scrollbar {
    display: none; /* Chrome / Safari */
  }

  .newspaper-nav-list {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0.45rem 0.25rem;
    min-width: max-content;
  }

  .newspaper-nav-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .newspaper-nav-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.78125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-muted, #334155);
    text-decoration: none;
    padding: 0.25rem 0.4rem;
    position: relative;
    transition: color 150ms ease;
  }

  .newspaper-nav-link:hover {
    color: var(--text, #0F172A);
  }

  .newspaper-nav-link.is-active {
    color: var(--text, #0F172A);
    font-weight: 700;
  }

  .newspaper-nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0.4rem;
    right: 0.4rem;
    height: 2px;
    background-color: var(--text, #0F172A);
  }

  .newspaper-nav-separator {
    color: var(--border, #D1D8DF);
    font-size: 0.75rem;
    font-weight: 300;
    user-select: none;
    margin-right: 0.85rem;
  }

  @media (max-width: 768px) {
    .newspaper-nav-list {
      justify-content: flex-start;
      gap: 0.5rem;
      padding: 0.4rem 0.5rem;
    }

    .newspaper-nav-item {
      gap: 0.5rem;
    }

    .newspaper-nav-separator {
      margin-right: 0.5rem;
    }

    .newspaper-nav-link {
      font-size: 0.75rem;
      padding: 0.2rem 0.25rem;
    }
  }
</style>
