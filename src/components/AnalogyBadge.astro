---
interface Props {
  concept: string;
}
const { concept } = Astro.props;
---

<div class="analogy-pill">
  <span class="analogy-icon">🏷️</span>
  <span class="analogy-label">Plain-English Analogy ({concept}):</span>
  <span class="analogy-text"><slot /></span>
</div>

<style>
  .analogy-pill {
    background: rgba(37, 99, 235, 0.04);
    border: 1px solid rgba(37, 99, 235, 0.18);
    border-radius: 10px;
    padding: 0.65rem 0.95rem;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }
  @media (max-width: 650px) {
    .analogy-pill { flex-direction: column; align-items: flex-start; gap: 0.2rem; }
  }
  .analogy-icon { font-size: 1rem; }
  .analogy-label {
    font-family: var(--font-mono);
    font-weight: 700;
    color: #2563eb;
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .analogy-text {
    color: var(--text-muted);
    line-height: 1.4;
  }
</style>
