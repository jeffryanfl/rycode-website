---
import '../styles/living.css';

interface LivingBullet {
  id: string;
  text: string;
  source?: string;
}

interface LivingRevision {
  date: string;
  note: string;
}

interface LivingFacts {
  asOfLabel?: string;
  bullets?: LivingBullet[];
  revisions?: LivingRevision[];
}

interface Props {
  facts: LivingFacts;
  part: 'strip' | 'ticker' | 'log';
}

const { facts, part } = Astro.props;
const bullets = Array.isArray(facts.bullets) ? facts.bullets : [];
const revisions = Array.isArray(facts.revisions) ? facts.revisions : [];
const asOfLabel = typeof facts.asOfLabel === 'string' ? facts.asOfLabel.trim() : '';

/** Short label from the bullet id. "debt_stock" becomes "debt". Empty id means no tag. */
function tapeTag(id: string): string {
  const raw = typeof id === 'string' ? id.trim() : '';
  if (!raw) return '';
  return raw.split('_')[0] || raw;
}
---

{(part === 'strip' || part === 'ticker') && bullets.length > 0 && (
  <aside class="living-strip living-strip--ticker" aria-label={asOfLabel ? `Living facts, ${asOfLabel}` : 'Living facts'}>
    {asOfLabel && <p class="living-strip-asof">{asOfLabel}</p>}
    <div class="living-strip-viewport">
      <div class="living-strip-track">
        {bullets.map((bullet) => {
          const tag = tapeTag(bullet.id);
          return (
            <span class="living-strip-item">
              {tag && <span class="living-strip-tag">{tag}</span>}
              {tag ? ' · ' : ''}
              {bullet.source ? <a href={bullet.source}>{bullet.text}</a> : bullet.text}
            </span>
          );
        })}
        {bullets.map((bullet) => {
          const tag = tapeTag(bullet.id);
          return (
            <span class="living-strip-item" aria-hidden="true">
              {tag && <span class="living-strip-tag">{tag}</span>}
              {tag ? ' · ' : ''}
              {bullet.text}
            </span>
          );
        })}
      </div>
    </div>
  </aside>
)}

{part === 'log' && revisions.length > 0 && (
  <section class="living-log" id="revisions" aria-labelledby="living-log-heading">
    <h2 id="living-log-heading">Revision log</h2>
    <ol>
      {revisions.map((row) => (
        <li>
          <time datetime={row.date}>{row.date}</time>
          {' — '}
          {row.note}
        </li>
      ))}
    </ol>
  </section>
)}
