---
import { lastUpdatedLine, loadWeekNews } from '../lib/ai-week-news';

const { updated, rows } = loadWeekNews();
const staleLine = lastUpdatedLine(updated);
const isEmpty = rows.length === 0;
---

<section class="ai-band ai-week-news ai-week-news--lead" aria-labelledby="ai-week-news">
  <h2 class="ai-section-label" id="ai-week-news">This week in AI</h2>
  {staleLine && <p class="ai-week-news-stale">{staleLine}</p>}
  <p class="ai-week-news-key">
    Confirmed = primary source · Reported = press, no primary yet · Claim = company says, not checked.
  </p>
  {isEmpty ? (
    <p class="ai-week-news-empty">No AI news logged in the last 7 days.</p>
  ) : (
    <ul class="ai-week-news-list">
      {rows.map((row) => (
        <li class="ai-week-news-row">
          <div class="ai-week-news-meta">
            <time class="ai-week-news-date" datetime={row.dateYmd}>{row.dateLabel}</time>
            {row.statusText && (
              <span class:list={['ai-week-news-status', row.outlined && 'ai-week-news-status--outlined']}>
                {row.statusText}
              </span>
            )}
          </div>
          {row.href ? (
            <a
              class="ai-week-news-headline"
              href={row.href}
              {...(row.href.startsWith('http') ? { rel: 'noopener', target: '_blank' } : {})}
            >
              {row.headline}
            </a>
          ) : (
            <span class="ai-week-news-headline ai-week-news-headline--plain">{row.headline}</span>
          )}
          <span class="ai-week-news-source">{row.source}</span>
        </li>
      ))}
    </ul>
  )}
</section>
