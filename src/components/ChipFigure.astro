---
/** A chip photo on a hardware page: the self-hosted square crop, its alt text, and a one-line credit. */
interface Props {
  src: string;
  alt: string;
  credit: string;
  /** Optional words before the credit, such as the chip's name on the photo. */
  caption?: string;
  /** Hero sits under the dek. Section figures sit inside a generation's section. Rack figures are 4:3 rack or system images. */
  variant?: 'hero' | 'section' | 'rack';
}

const { src, alt, credit, caption, variant = 'hero' } = Astro.props;
const [width, height] = variant === 'rack' ? [1280, 960] : [760, 760];
---

<figure class:list={['ai-model-figure', { 'ai-model-figure--section': variant === 'section', 'ai-model-figure--rack': variant === 'rack' }]}>
  <img src={src} alt={alt} width={width} height={height} loading={variant === 'hero' ? 'eager' : 'lazy'} decoding="async" />
  <figcaption class="ai-model-credit">{caption ? `${caption} ` : ''}{credit}</figcaption>
</figure>
