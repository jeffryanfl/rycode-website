---
import { chipSpecRows, type HardwareCard } from '../lib/hardware';

interface Props {
  cards: HardwareCard[];
  listLabel: string;
  /** Shown when this theme has no plant page. No number and no link. */
  emptyTitle?: string;
}

const { cards, listLabel, emptyTitle } = Astro.props;
const chipGrid = cards.some((card) => card.spec);
---

<ul class:list={["hw-card-grid", { "hw-chip-grid": chipGrid }]} aria-label={listLabel}>
  {cards.length === 0 && emptyTitle ? (
    <li>
      <div class="hw-card hw-card--quiet">
        <h2 class="hw-card-title">{emptyTitle}</h2>
      </div>
    </li>
  ) : (
    cards.map((card) => (
      <li>
        {card.spec ? (
          <a class="hw-card hw-chip" href={card.href}>
            <div class="hw-chip-art">
              {card.image ? (
                <img src={card.image} alt={card.imageAlt ?? ''} width="760" height="760" loading="lazy" decoding="async" />
              ) : (
                <span class="hw-chip-art-empty" aria-hidden="true">{card.spec.maker}</span>
              )}
              {card.imageCaption ? <span class="hw-chip-art-caption">{card.imageCaption}</span> : null}
            </div>
            <div class="hw-chip-head">
              <h2 class="hw-card-title">{card.title}</h2>
              <span class="hw-chip-maker">{card.spec.maker}</span>
            </div>
            <div class="hw-chip-figures">
              <dl class="hw-chip-list">
                {chipSpecRows.map((row) => (
                  <div class="hw-chip-row">
                    <dt>{row.label}</dt>
                    <dd class:list={{ "hw-chip-none": !card.spec?.[row.key] }}>{card.spec?.[row.key] ?? 'not stated'}</dd>
                  </div>
                ))}
                {card.spec.price ? (
                  <div class="hw-chip-row">
                    <dt>Price</dt>
                    <dd>{card.spec.price}</dd>
                  </div>
                ) : null}
              </dl>
              {card.spec.note ? <p class="hw-chip-note">{card.spec.note}</p> : null}
            </div>
          </a>
        ) : (
          <a class="hw-card" href={card.href}>
            <h2 class="hw-card-title">{card.title}</h2>
            {card.kicker ? <p class="hw-card-label">{card.kicker}</p> : null}
            {card.value ? (
              <p class="hw-card-metric">
                <span class:list={["hw-card-value", { "hw-card-value--text": !/\d/.test(card.value) }]}>{card.value}</span>
                <span class="hw-card-label">{card.label}</span>
              </p>
            ) : null}
            <p class="hw-card-dek">{card.dek}</p>
          </a>
        )}
      </li>
    ))
  )}
</ul>
