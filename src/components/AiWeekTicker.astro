---
import { loadAiWeekTicker } from '../lib/ai-week-ticker';

const tape = loadAiWeekTicker();
const ariaLabel = tape.asOfLabel ? `Today in A.I., ${tape.asOfLabel}` : 'Today in A.I.';
---

{!tape.hidden && (
  <div class="ai-week-tape-wrap">
    <div
      class="hub-tape hub-tape--inline"
      id="aiWeekTicker"
      role="region"
      aria-label={ariaLabel}
      data-tape-pause-label="Pause A.I. news tape"
      data-tape-play-label="Play A.I. news tape"
    >
      <span class="hub-tape-asof">{tape.asOfLabel}</span>
      <button
        type="button"
        class="hub-tape-toggle"
        data-hub-tape-pause
        aria-pressed="false"
        aria-label="Pause A.I. news tape"
        hidden
      >
        <svg class="hub-tape-toggle-icon" data-hub-tape-toggle-icon width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
          <rect class="hub-tape-toggle-pause" x="2" y="1" width="2.5" height="10" fill="currentColor" />
          <rect class="hub-tape-toggle-pause" x="7.5" y="1" width="2.5" height="10" fill="currentColor" />
          <path class="hub-tape-toggle-play" d="M2.5 1.2 10.5 6 2.5 10.8z" fill="currentColor" hidden />
        </svg>
      </button>
      <span class="hub-tape-viewport" data-hub-ai-tape-viewport>
        <span class="hub-tape-track" data-hub-ai-tape-track>
          {tape.items.map((item) => (
            <a
              class="hub-tape-item"
              href={item.href}
              {...(item.href.startsWith('http') ? { rel: 'noopener', target: '_blank' } : {})}
            >
              {item.tag ? (
                <>
                  <span class="hub-tape-tag">{item.tag}</span>
                  {' · '}
                  {item.headline}
                </>
              ) : (
                item.headline
              )}
            </a>
          ))}
        </span>
      </span>
    </div>
  </div>
)}

<script is:inline src="/hub-tape-controls.js" defer></script>
<script is:inline src="/ai-week-ticker.js" defer></script>
