---
import ChipFigure from './ChipFigure.astro';
import DataCenterSourceRef from './DataCenterSourceRef.astro';
import {
  datacenterSite,
  displayAnchors,
  headlineChips,
  headlineHomes,
  headlinePower,
  headlineStatus,
  homesFor,
  homesSubLine,
  notStatedBy,
  sortedUpdates,
  sourcesForPage,
  statusLabel,
  type SourcedPart,
} from '../lib/datacenters';

interface Props {
  id: string;
}

type SpecRow = {
  label: string;
  parts: { text: string; source?: string }[];
  subLine?: boolean;
};

const { id } = Astro.props;
const site = datacenterSite(id);
const anchors = displayAnchors(site);
const sources = sourcesForPage(site);
const owner = site.ownerName;
const realTermsKey = 'eia-home';

function partsFromSourced(row: { text?: string; source?: string } | null | undefined): SpecRow['parts'] {
  if (!row?.text) return [{ text: notStatedBy(owner) }];
  return [{ text: row.text, source: row.source }];
}

function joinParts(parts: SourcedPart[], separator = ' '): SpecRow['parts'] {
  return parts.map((part, index) => ({
    text: index < parts.length - 1 ? `${part.text}${separator}` : part.text,
    source: part.source,
  }));
}

const statusParts: SpecRow['parts'] = site.statusSegments?.length
  ? [{ text: `${statusLabel(site.status.value)}. ` }, ...joinParts(site.statusSegments)]
  : [
      {
        text: `${statusLabel(site.status.value)}${site.status.note ? `. ${site.status.note}` : ''}`,
        source: site.status.source,
      },
    ];

const powerParts: SpecRow['parts'] = site.powerSegments?.length
  ? joinParts(site.powerSegments, ' ')
  : site.power
    ? partsFromSourced(site.power)
    : [{ text: notStatedBy(owner) }];

const powerHomesParts: SpecRow['parts'] = site.power?.mw
  ? [
      {
        text: `${homesFor(site.power.mw)} homes${site.power.homesQualifier ? `, ${site.power.homesQualifier}` : ''}`,
        source: realTermsKey,
      },
    ]
  : [{ text: notStatedBy(owner) }];

const chipParts: SpecRow['parts'] =
  site.chips.length === 0
    ? [{ text: notStatedBy(owner) }]
    : site.chips.map((chip, index) => {
        const count = chip.countText ?? (chip.count != null ? String(chip.count) : '');
        const text =
          index < site.chips.length - 1
            ? count
              ? `${count}: ${chip.type}; `
              : `${chip.type}; `
            : count
              ? `${count}: ${chip.type}`
              : chip.type;
        return { text, source: chip.source };
      });

const usedForParts: SpecRow['parts'] =
  site.usedFor.length === 0
    ? [{ text: notStatedBy(owner) }]
    : site.usedFor.map((row, index) => ({
        text:
          index < site.usedFor.length - 1
            ? `${row.who}: ${row.what}; `
            : `${row.who}: ${row.what}`,
        source: row.source,
      }));

const locationParts: SpecRow['parts'] = site.locationSegments?.length
  ? joinParts(site.locationSegments, '; ')
  : partsFromSourced(site.location);

const waterParts: SpecRow['parts'] = site.waterSegments?.length
  ? joinParts(site.waterSegments, '; ')
  : partsFromSourced(site.water);

const computeParts: SpecRow['parts'] = site.compute
  ? [
      {
        text: `${site.compute.text} (${site.compute.basis === 'stated' ? 'Company figure' : 'Rycode math'})`,
        source: site.compute.source,
      },
    ]
  : [{ text: notStatedBy(owner) }];

const extraParts: SpecRow['parts'] =
  site.extraRows.length === 0
    ? [{ text: notStatedBy(owner) }]
    : site.extraRows.length === 1
      ? [{ text: site.extraRows[0].text, source: site.extraRows[0].source }]
      : site.extraRows.map((row, index) => ({
          text:
            index < site.extraRows.length - 1
              ? `${row.label}: ${row.text}; `
              : `${row.label}: ${row.text}`,
          source: row.source,
        }));

const specRows: SpecRow[] = [
  { label: 'Location', parts: locationParts },
  { label: 'Owner', parts: partsFromSourced(site.owner) },
  {
    label: 'Operator',
    parts: site.operator?.text
      ? partsFromSourced(site.operator)
      : [{ text: notStatedBy(owner) }],
  },
  { label: 'Status', parts: statusParts },
  { label: 'Power', parts: powerParts },
  { label: 'Power in real terms', parts: powerHomesParts, subLine: Boolean(site.power?.mw) },
  { label: 'Chips', parts: chipParts },
  { label: 'Compute', parts: computeParts },
  { label: 'Used for', parts: usedForParts },
  { label: 'Cooling', parts: partsFromSourced(site.cooling) },
  { label: 'Water', parts: waterParts },
  { label: 'Network', parts: partsFromSourced(site.network) },
  { label: 'Cost', parts: partsFromSourced(site.cost) },
  { label: 'Site', parts: partsFromSourced(site.site) },
  {
    label: 'Other figures',
    parts: site.extraRows.length ? extraParts : [{ text: notStatedBy(owner) }],
  },
];

const tilePower = headlinePower(site) ?? 'Not stated';
const tileHomes = headlineHomes(site) ?? 'Not stated';
const tileChips = headlineChips(site) ?? 'Not stated';
const tileStatus = headlineStatus(site);

const updates = sortedUpdates(site);
const notes = site.notes.slice(0, 4);

const plannedHomes = site.powerPlanned?.mw
  ? `${homesFor(site.powerPlanned.mw)} homes${site.powerPlanned.homesQualifier ? `, ${site.powerPlanned.homesQualifier}` : ''}`
  : undefined;

const supplementHomes = site.powerSupplement?.mw
  ? `${homesFor(site.powerSupplement.mw)} homes, ${site.powerSupplement.homesQualifier}`
  : undefined;
---

<article class="ai-model">
  <p class="ai-model-kicker">
    Hardware · <a href="/ai/hardware/data-centers/">Data center</a> · {site.owner.text}
  </p>
  <h1 class="ai-model-title">{site.name}</h1>
  <p class="ai-model-dek">{site.dek}</p>
  <p class="ai-model-checked">Last checked <time datetime={site.asOf}>{site.asOf}</time></p>
  <hr class="ai-model-rule" />

  {site.image.kind !== 'pending' && (
    <ChipFigure
      variant="site"
      src={site.image.src}
      alt={site.image.alt}
      credit={site.image.credit}
      creditUrl={site.image.creditUrl}
      imageKind={site.image.kind}
    />
  )}

  <dl class="ai-model-facts" aria-label="Headline figures">
    <div>
      <dt>Power</dt>
      <dd class:list={{ 'ai-dc-muted': tilePower === 'Not stated' }}>{tilePower}</dd>
    </div>
    <div>
      <dt>Homes equivalent</dt>
      <dd class:list={{ 'ai-dc-muted': tileHomes === 'Not stated' }}>
        {tileHomes}
        {site.power?.mw ? <span class="ai-model-facts-sub">{homesSubLine()}</span> : null}
      </dd>
    </div>
    <div>
      <dt>Chips</dt>
      <dd class:list={{ 'ai-dc-muted': tileChips === 'Not stated' }}>{tileChips}</dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd>{tileStatus}</dd>
    </div>
  </dl>

  <h2 class="visually-hidden">Spec sheet</h2>
  <div class="ai-agent-tool-spec-wrap">
    <table class="ai-agent-tool-spec ai-dc-spec">
      <caption class="visually-hidden">Spec sheet for {site.name}</caption>
      <tbody>
        {specRows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td>
              {row.parts.map((part) => (
                <>
                  {part.text}
                  {part.source && part.text !== notStatedBy(owner) ? (
                    <DataCenterSourceRef sourceKey={part.source} anchors={anchors} />
                  ) : null}
                </>
              ))}
              {row.subLine ? <span class="ai-model-facts-sub">{homesSubLine()}</span> : null}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {site.power?.mw ? (
    <section class="ai-dc-real-terms" aria-labelledby={`dc-real-${id}`}>
      <h2 class="ai-model-section" id={`dc-real-${id}`}>Power in real terms</h2>
      <p>
        {homesFor(site.power.mw)} US homes worth of electricity per year, if the site ran at full rated power all year
        {site.power.homesQualifier ? ` (${site.power.homesQualifier})` : ''}.
        <DataCenterSourceRef sourceKey={realTermsKey} anchors={anchors} />
      </p>
      {supplementHomes ? (
        <p>
          {supplementHomes}.
          <DataCenterSourceRef sourceKey={site.powerSupplement?.source} anchors={anchors} />
        </p>
      ) : null}
      {plannedHomes ? (
        <p>
          At full planned power: {plannedHomes}.
          <DataCenterSourceRef sourceKey={site.powerPlanned?.source} anchors={anchors} />
        </p>
      ) : null}
      {site.onSiteGeneration?.text ? (
        <p>
          {site.onSiteGeneration.text}
          <DataCenterSourceRef sourceKey={site.onSiteGeneration.source} anchors={anchors} />
        </p>
      ) : null}
      {site.gridNotes?.text ? (
        <p>
          {site.gridNotes.text}
          <DataCenterSourceRef sourceKey={site.gridNotes.source} anchors={anchors} />
        </p>
      ) : null}
      <p class="ai-model-facts-sub">{homesSubLine()}</p>
    </section>
  ) : null}

  {notes.length > 0 ? (
    <section class="ai-dc-notes" aria-labelledby={`dc-notes-${id}`}>
      <h2 class="ai-model-section" id={`dc-notes-${id}`}>Notes</h2>
      <ul class="ai-model-sources">
        {notes.map((note) => (
          <li>
            {note.claim ? <span class="ai-dc-claim">Claim · </span> : null}
            {note.text}
            <DataCenterSourceRef sourceKey={note.source} anchors={anchors} />
          </li>
        ))}
      </ul>
    </section>
  ) : null}

  {updates.length > 0 ? (
    <section class="ai-dc-updates" aria-labelledby={`dc-updates-${id}`}>
      <h2 class="ai-model-section" id={`dc-updates-${id}`}>Updates</h2>
      <ul class="ai-dc-update-list">
        {updates.map((line) => (
          <li>
            <time datetime={line.date}>{line.date}</time>
            {' · '}
            {line.text}
            <DataCenterSourceRef sourceKey={line.source} anchors={anchors} />
          </li>
        ))}
      </ul>
    </section>
  ) : null}

  <section class="ai-dc-sources" aria-labelledby={`dc-sources-${id}`}>
    <h2 class="ai-dc-sources-title" id={`dc-sources-${id}`}>Sources</h2>
    <ol class="ai-dc-sources-list">
      {sources.map((source, index) => (
        <li id={`source-${index + 1}`}>
          <span class="ai-dc-sources-n" aria-hidden="true">[{index + 1}]</span>
          <a href={source.url} rel="noopener noreferrer" target="_blank">{source.label}</a>
        </li>
      ))}
    </ol>
  </section>
</article>
