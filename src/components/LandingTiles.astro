---
interface Item {
  label: string;
  href?: string;
  description?: string;
}

interface Props {
  items?: Item[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <div class="landing-rail">
    <ul>
      {items.map((item) => {
        const isCard = Boolean(item.description);
        const className = [
          "landing-rail-link",
          isCard ? "landing-rail-link--card" : "",
        ].filter(Boolean).join(" ");
        const ariaLabel = item.description
          ? `${item.label}. ${item.description}`
          : item.label;

        return (
          <li>
            {item.href ? (
              <a href={item.href} class={className} aria-label={ariaLabel}>
                <span class="landing-rail-label">{item.label}</span>
                {item.description && (
                  <span class="landing-rail-desc">{item.description}</span>
                )}
              </a>
            ) : (
              <span class={className}>
                <span class="landing-rail-label">{item.label}</span>
                {item.description && (
                  <span class="landing-rail-desc">{item.description}</span>
                )}
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </div>
)}
