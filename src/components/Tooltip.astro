---
interface Props {
  term: string;
  def: string;
  analogy?: string;
}
const { term, def, analogy } = Astro.props;
---

<span class="tooltip-trigger">
  {term}
  <span class="tooltip-popup">
    <strong class="tooltip-title">{term}</strong>: {def}
    {analogy && <span class="tooltip-analogy">💡 <em>Analogy: {analogy}</em></span>}
  </span>
</span>

<style>
  .tooltip-trigger {
    position: relative;
    border-bottom: 1.5px dotted #2563eb;
    color: var(--text);
    cursor: help;
    font-weight: 600;
    display: inline-block;
  }
  .tooltip-popup {
    visibility: hidden;
    opacity: 0;
    width: 280px;
    background: #0f172a;
    color: #f8fafc;
    font-size: 0.82rem;
    line-height: 1.45;
    padding: 0.85rem;
    border-radius: 10px;
    position: absolute;
    bottom: 130%;
    left: 50%;
    transform: translateX(-50%);
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    z-index: 1000;
    transition: opacity 0.2s var(--ease), visibility 0.2s var(--ease);
    pointer-events: none;
    font-weight: 400;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .tooltip-title {
    color: #3b82f6;
    font-family: var(--font-mono);
  }
  .tooltip-trigger:hover .tooltip-popup {
    visibility: visible;
    opacity: 1;
  }
  .tooltip-analogy {
    display: block;
    margin-top: 0.4rem;
    color: #93c5fd;
    font-size: 0.78rem;
  }
</style>
