---
import { LAB_MARKS, type LabMarkId } from '../lib/lab-marks';

/**
 * Reusable inline-SVG chart, drawn at build time. No client script.
 * kind="bar":  one horizontal bar per item (label, bar, value, optional note).
 * kind="line": categories on the x axis, one line per series, and a legend.
 *              A series may carry a lab mark (disc + logo). Without a mark,
 *              markers fall back to circle / square / diamond / triangle.
 *              A null value leaves a gap (no point drawn).
 * kind="spark": a small trend line (points, oldest first) with a dot on the
 *              latest point. No axes, legend, or caption; pass title as the label.
 *              Optional: highLabel / lowLabel ring and label the high and low
 *              (ties go to the latest point); refValue / refLabel draw a dashed
 *              reference line, and the scale stretches to include it.
 *              refs: several dashed reference lines ({ value, label }[]).
 *              sparkWidth / sparkHeight set the viewBox so labels keep their size
 *              when the spark is drawn wider than its default 160 x 56.
 *              refLabelSide puts reference labels at the left or right end.
 */
interface BarItem {
  label: string;
  value: number;
  display?: string;
  note?: string;
}
interface LineSeries {
  name: string;
  values: (number | null)[];
  color?: string;
  mark?: LabMarkId;
  disc?: string;
  glyph?: string;
  ring?: string;
}
interface AxisLabel {
  label: string;
  href?: string;
  name?: string;
}
interface Props {
  title: string;
  sub?: string;
  kind?: 'bar' | 'line' | 'spark';
  items?: BarItem[];
  points?: number[];
  highLabel?: string;
  lowLabel?: string;
  refValue?: number;
  refLabel?: string;
  refs?: { value: number; label?: string }[];
  sparkWidth?: number;
  sparkHeight?: number;
  refLabelSide?: 'start' | 'end';
  categories?: Array<string | AxisLabel>;
  series?: LineSeries[];
  min?: number;
  max?: number;
  step?: number;
  caption?: boolean;
  frame?: boolean;
  href?: string;
}

const {
  title,
  sub,
  kind = 'bar',
  items = [],
  categories = [],
  series = [],
  points = [],
  highLabel,
  lowLabel,
  refValue,
  refLabel,
  refs = [],
  sparkWidth = 160,
  sparkHeight = 56,
  refLabelSide = 'end',
  caption = true,
  frame = true,
  href,
} = Astro.props;

const values =
  kind === 'bar'
    ? items.map((item) => item.value)
    : series.flatMap((s) => s.values.filter((v): v is number => typeof v === 'number'));
const dataMax = values.length ? Math.max(...values) : 1;
const dataMin = values.length ? Math.min(...values) : 0;

function niceStep(range: number): number {
  const steps = [0.5, 1, 2, 2.5, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000];
  return steps.find((s) => range / s <= 5) ?? 1000;
}

let lo = Astro.props.min ?? (kind === 'bar' ? 0 : dataMin);
const step = Astro.props.step ?? niceStep(Math.max(dataMax - lo, 1));
if (Astro.props.min === undefined && kind === 'line') lo = Math.floor(dataMin / step) * step;
let hi = Astro.props.max ?? Math.ceil(dataMax / step) * step;
if (hi <= lo) hi = lo + step;

const ticks: number[] = [];
for (let t = lo; t <= hi + step / 1000; t += step) ticks.push(Math.round(t * 1000) / 1000);

const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
const pct = (v: number) => ((v - lo) / (hi - lo)) * 100;

/* Line geometry (viewBox units). The 0-100 scale sits outside the plot,
   so a phone can scroll the benches and keep the scale in view.
   Wide enough that spelled-out bench names stay apart. */
const W = 960;
const H = 300;
const PAD = { l: 12, r: 20, t: 26, b: 54 };
/* Logo discs are this wide. Close scores step sideways by `gap` so the marks clear. */
const MARK_R = 11;
const plotW = W - PAD.l - PAD.r;
const plotH = H - PAD.t - PAD.b;
const axis: AxisLabel[] = categories.map((item) =>
  typeof item === 'string' ? { label: item, name: item } : item
);
const xAt = (i: number) => PAD.l + ((i + 0.5) / Math.max(axis.length, 1)) * plotW;
const yAt = (v: number) => PAD.t + plotH - ((v - lo) / (hi - lo)) * plotH;

const SHAPES = ['circle', 'square', 'diamond', 'triangle'] as const;
const INKS = ['#f8fafc', 'rgba(248, 250, 252, 0.74)', 'rgba(248, 250, 252, 0.56)', 'rgba(248, 250, 252, 0.4)'];
const DASHES = ['', '6 4', '2 3', '9 3 2 3'];
const ink = (series: LineSeries, index: number) => series.color || INKS[index % INKS.length];
const dash = (series: LineSeries, index: number) => (series.color ? undefined : DASHES[index % DASHES.length] || undefined);
/* Gemini's line and sparkle use Google's four colors. One gradient per SVG document. */
const strokeOf = (series: LineSeries, index: number) =>
  series.mark === 'gemini' ? 'url(#bc-gemini)' : ink(series, index);

function badge(markId: LabMarkId | undefined, cx: number, cy: number, r: number) {
  if (!markId) return null;
  const mark = LAB_MARKS[markId];
  const box = r * 2 * mark.fit;
  const scale = box / Math.max(mark.w, mark.h);
  const w = mark.w * scale;
  const h = mark.h * scale;
  return {
    d: mark.d,
    transform: `translate(${(cx - w / 2).toFixed(2)} ${(cy - h / 2).toFixed(2)}) scale(${scale.toFixed(5)})`,
  };
}

/* A long bench name wraps on the space nearest the middle. Short names stay one line. */
function axisLines(label: string): string[] {
  if (label.length <= 16 || !label.includes(' ')) return [label];
  const mid = label.length / 2;
  let at = label.indexOf(' ');
  for (let i = 0; i < label.length; i++) {
    if (label[i] === ' ' && Math.abs(i - mid) < Math.abs(at - mid)) at = i;
  }
  return [label.slice(0, at), label.slice(at + 1)];
}

function segments(vals: (number | null)[], dx: number[]): string[] {
  const out: string[] = [];
  let current: string[] = [];
  vals.forEach((v, i) => {
    if (typeof v === 'number') {
      current.push(`${(xAt(i) + (dx[i] || 0)).toFixed(1)},${yAt(v).toFixed(1)}`);
    } else {
      if (current.length > 1) out.push(current.join(' '));
      current = [];
    }
  });
  if (current.length > 1) out.push(current.join(' '));
  return out;
}

/* Scores that land on the same spot shift sideways so both marks show.
   Height stays the real score. `near` is about a disc diameter in viewBox units. */
function xOffsets(list: LineSeries[]): number[][] {
  const near = 26;
  const gap = 28;
  const offsets = list.map((s) => s.values.map(() => 0));
  for (let j = 0; j < axis.length; j++) {
    const stack: { i: number; y: number }[] = [];
    list.forEach((s, i) => {
      const v = s.values[j];
      if (typeof v === 'number') stack.push({ i, y: yAt(v) });
    });
    stack.sort((a, b) => a.y - b.y);
    let cluster: { i: number; y: number }[] = [];
    const flush = () => {
      if (cluster.length > 1) {
        const mid = (cluster.length - 1) / 2;
        cluster.forEach((item, k) => {
          offsets[item.i][j] = (k - mid) * gap;
        });
      }
      cluster = [];
    };
    for (const item of stack) {
      if (cluster.length && item.y - cluster[cluster.length - 1].y > near) flush();
      cluster.push(item);
    }
    flush();
  }
  return offsets;
}

const offsets = kind === 'line' ? xOffsets(series) : [];

function markerPath(shape: (typeof SHAPES)[number], x: number, y: number, r = 4.2): string {
  if (shape === 'square') return `M${x - r},${y - r}h${2 * r}v${2 * r}h${-2 * r}z`;
  if (shape === 'diamond') return `M${x},${y - r * 1.3}L${x + r * 1.3},${y}L${x},${y + r * 1.3}L${x - r * 1.3},${y}z`;
  if (shape === 'triangle') return `M${x},${y - r * 1.3}L${x + r * 1.2},${y + r}L${x - r * 1.2},${y + r}z`;
  return `M${x - r},${y}a${r},${r} 0 1,0 ${2 * r},0a${r},${r} 0 1,0 ${-2 * r},0`;
}

/* Spark geometry (viewBox units). Scaled to its own min and max, plus the reference line. */
const SW = sparkWidth;
const SH = sparkHeight;
const SPX = 4;
const SPT = 13;
const SPB = 13;
const refLines = [
  ...(typeof refValue === 'number' ? [{ value: refValue, label: refLabel }] : []),
  ...refs.filter((r) => typeof r?.value === 'number'),
];
const sparkVals = [...points, ...refLines.map((r) => r.value)];
/* A reference label sits above its line unless another line is close above it. */
const refLabelBelow = refLines.map((r, i) =>
  refLines.some((o, j) => j !== i && o.value > r.value && Math.abs(o.value - r.value) / ((Math.max(...sparkVals) - Math.min(...sparkVals)) || 1) < 0.25),
);
const sparkLo = sparkVals.length ? Math.min(...sparkVals) : 0;
const sparkHi = sparkVals.length ? Math.max(...sparkVals) : 1;
const sparkSpan = sparkHi - sparkLo || 1;
const sx = (i: number) => SPX + (i / Math.max(points.length - 1, 1)) * (SW - 2 * SPX);
const sy = (v: number) => SPT + (1 - (v - sparkLo) / sparkSpan) * (SH - SPT - SPB);
const sparkXY = points.map((v, i) => [sx(i), sy(v)]);
const sparkLast = sparkXY[sparkXY.length - 1];
const hiIdx = points.length ? points.lastIndexOf(Math.max(...points)) : -1;
const loIdx = points.length ? points.lastIndexOf(Math.min(...points)) : -1;
const anchorAt = (x: number) => (x < 40 ? 'start' : x > SW - 40 ? 'end' : 'middle');

---

{kind === 'spark' ? (
  <svg class="bc-spark" viewBox={`0 0 ${SW} ${SH}`} role="img" aria-label={title}>
    <polyline
      points={sparkXY.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ')}
      fill="none"
      stroke="rgba(248, 250, 252, 0.72)"
      stroke-width="1.4"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
    />
    {refLines.map((r, i) => (
      <g>
        <line class="bc-spark-ref" x1={SPX} x2={SW - SPX} y1={sy(r.value)} y2={sy(r.value)} stroke-dasharray="3 3" />
        {r.label && (
          <text
            class="bc-spark-text bc-spark-ref-text"
            x={refLabelSide === 'start' ? SPX : SW - SPX}
            y={refLabelBelow[i] ? sy(r.value) + 9 : sy(r.value) - 3}
            text-anchor={refLabelSide}
          >
            {r.label}
          </text>
        )}
      </g>
    ))}
    {highLabel && hiIdx >= 0 && (
      <g>
        <circle class="bc-spark-ring" cx={sparkXY[hiIdx][0]} cy={sparkXY[hiIdx][1]} r="2.6" />
        <text class="bc-spark-text" x={sparkXY[hiIdx][0]} y={sparkXY[hiIdx][1] - 5} text-anchor={anchorAt(sparkXY[hiIdx][0])}>{highLabel}</text>
      </g>
    )}
    {lowLabel && loIdx >= 0 && (
      <g>
        <circle class="bc-spark-ring" cx={sparkXY[loIdx][0]} cy={sparkXY[loIdx][1]} r="2.6" />
        <text class="bc-spark-text" x={sparkXY[loIdx][0]} y={sparkXY[loIdx][1] + 11} text-anchor={anchorAt(sparkXY[loIdx][0])}>{lowLabel}</text>
      </g>
    )}
    {sparkLast && <circle cx={sparkLast[0]} cy={sparkLast[1]} r="2.2" fill="#f8fafc" />}
  </svg>
) : (
<figure class:list={['bc', { 'bc-open': !frame }]}>
  {caption && (
    <figcaption class="bc-cap">
      {href ? (
        <a class="bc-title bc-title-link" href={href} target="_blank" rel="noopener noreferrer">{title}</a>
      ) : (
        <span class="bc-title">{title}</span>
      )}
      {sub && <span class="bc-sub">{sub}</span>}
    </figcaption>
  )}

  {kind === 'bar' && (
    <div class="bc-bars" role="list">
      {items.map((item) => (
        <div class="bc-row" role="listitem">
          <span class="bc-label">{item.label}</span>
          <svg class="bc-track" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
            {ticks.map((t) => (
              <line class="bc-grid" x1={pct(t)} x2={pct(t)} y1="0" y2="12" vector-effect="non-scaling-stroke" />
            ))}
            <rect class="bc-bar" x="0" y="2.5" width={pct(item.value)} height="7" />
          </svg>
          <span class="bc-value">
            {item.display ?? fmt(item.value)}
            {item.note && <span class="bc-note">{item.note}</span>}
          </span>
        </div>
      ))}
      <div class="bc-row bc-axis" aria-hidden="true">
        <span></span>
        <span class="bc-ticks">
          {ticks.map((t) => <span style={`left: ${pct(t)}%`}>{fmt(t)}</span>)}
        </span>
        <span></span>
      </div>
    </div>
  )}

  {kind === 'line' && (
    <>
      <ul class="bc-legend">
        {series.map((s, i) => {
          const swatch = strokeOf(s, i);
          const logo = badge(s.mark, 34, 11, 8);
          return (
            <li>
              <svg viewBox="0 0 46 22" width="46" height="22" aria-hidden="true">
                {s.mark === 'gemini' && (
                  <defs>
                    <linearGradient id="bc-gemini" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#4285F4" />
                      <stop offset="34%" stop-color="#EA4335" />
                      <stop offset="67%" stop-color="#FBBC05" />
                      <stop offset="100%" stop-color="#34A853" />
                    </linearGradient>
                  </defs>
                )}
                <line x1="1" x2="20" y1="11" y2="11" stroke={swatch} stroke-width="5.5" stroke-linecap="round" stroke-opacity="0.28" />
                <line x1="1" x2="20" y1="11" y2="11" stroke={swatch} stroke-width="2.4" stroke-linecap="round" stroke-dasharray={dash(s, i)} />
                {logo ? (
                  <g>
                    <circle cx="34" cy="11" r="8" fill={s.disc || swatch} stroke={s.ring || '#080a10'} stroke-width="1.2" />
                    <path d={logo.d} fill={s.glyph || '#ffffff'} transform={logo.transform} />
                  </g>
                ) : (
                  <path d={markerPath(SHAPES[i % 4], 34, 11, 4)} fill={swatch} />
                )}
              </svg>
              {s.name}
            </li>
          );
        })}
      </ul>
      <div class="bc-plot">
        <div class="bc-y" aria-hidden="true">
          {ticks.map((t) => (
            <span style={`top: ${(yAt(t) / H) * 100}%`}>{fmt(t)}</span>
          ))}
        </div>
        <div class="bc-scroll">
          <svg class="bc-svg" viewBox={`0 0 ${W} ${H}`} role="group" aria-label={title}>
            <defs>
              <linearGradient id="bc-gemini" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#4285F4" />
                <stop offset="34%" stop-color="#EA4335" />
                <stop offset="67%" stop-color="#FBBC05" />
                <stop offset="100%" stop-color="#34A853" />
              </linearGradient>
            </defs>
            {ticks.map((t) => (
              <line class:list={['bc-grid', { 'bc-grid-base': t === lo }]} x1={PAD.l} x2={W - PAD.r} y1={yAt(t)} y2={yAt(t)} />
            ))}
            {axis.map((_, i) => (
              <line class="bc-grid bc-grid-x" x1={xAt(i)} x2={xAt(i)} y1={PAD.t} y2={PAD.t + plotH} />
            ))}
            {axis.map((c, i) => {
              const slot = plotW / Math.max(axis.length, 1);
              const lines = axisLines(c.label);
              const label = (
                <>
                  <rect x={xAt(i) - slot / 2} y={H - 50} width={slot} height={48} fill="transparent" />
                  <text class="bc-axis-text" x={xAt(i)} y={lines.length > 1 ? H - 32 : H - 18} text-anchor="middle">
                    {lines.map((line, k) => (
                      <tspan x={xAt(i)} dy={k === 0 ? 0 : 15}>{line}</tspan>
                    ))}
                  </text>
                </>
              );
              return c.href ? (
                <a class="bc-axis-link" href={c.href} target="_blank" rel="noopener noreferrer" aria-label={c.name || c.label}>
                  <title>{c.name || c.label}</title>
                  {label}
                </a>
              ) : (
                <g>{label}</g>
              );
            })}
            {series.map((s, i) => {
              const swatch = strokeOf(s, i);
              return (
                <g>
                  {segments(s.values, offsets[i] || []).map((pts) => (
                    <g>
                      <polyline points={pts} fill="none" stroke={swatch} stroke-width="7" stroke-linejoin="round" stroke-linecap="round" stroke-opacity="0.28" />
                      <polyline points={pts} fill="none" stroke={swatch} stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray={dash(s, i)} />
                    </g>
                  ))}
                  {s.values.map((v, j) => {
                    if (typeof v !== 'number') return null;
                    const x = xAt(j) + (offsets[i]?.[j] || 0);
                    const y = yAt(v);
                    const logo = badge(s.mark, x, y, MARK_R);
                    const tip = `${s.name}, ${axis[j]?.label ?? ''}: ${fmt(v)}`;
                    return logo ? (
                      <g>
                        <title>{tip}</title>
                        <circle cx={x} cy={y} r={MARK_R} fill={s.disc || swatch} stroke={s.ring || '#080a10'} stroke-width="1.5" />
                        <path d={logo.d} fill={s.glyph || '#ffffff'} transform={logo.transform} />
                      </g>
                    ) : (
                      <path d={markerPath(SHAPES[i % 4], x, y)} fill={swatch} stroke="#080a10" stroke-width="1">
                        <title>{tip}</title>
                      </path>
                    );
                  })}
                </g>
              );
            })}
          </svg>
        </div>
      </div>
    </>
  )}
</figure>
)}

<style>
  .bc {
    margin: 0;
    min-width: 0;
    border: 1px solid rgba(248, 250, 252, 0.16);
    border-radius: var(--radius-card, 14px);
    padding: 0.85rem 0.95rem 0.7rem;
    background: rgba(248, 250, 252, 0.02);
  }

  .bc-open {
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
  }

  .bc-cap {
    margin-bottom: 0.65rem;
  }

  .bc-title {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ai-ink, #f8fafc);
  }

  .bc-title-link {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: rgba(248, 250, 252, 0.45);
  }

  .bc-title-link:hover,
  .bc-title-link:focus-visible {
    text-decoration-color: var(--ai-ink, #f8fafc);
  }

  .bc-sub {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.02em;
    color: var(--ai-dim, #8b919a);
  }

  .bc-row {
    display: grid;
    grid-template-columns: minmax(6rem, 8.5rem) minmax(0, 1fr) 3.6rem;
    gap: 0.6rem;
    align-items: center;
    padding: 0.26rem 0;
  }

  .bc-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ai-ink, #f8fafc);
    line-height: 1.2;
  }

  .bc-track {
    display: block;
    width: 100%;
    height: 14px;
  }

  .bc-grid {
    stroke: rgba(248, 250, 252, 0.12);
    stroke-width: 1;
  }

  .bc-bar {
    fill: rgba(248, 250, 252, 0.74);
  }

  .bc-value {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-align: right;
    color: var(--ai-ink, #f8fafc);
    line-height: 1.15;
  }

  .bc-note {
    display: block;
    font-size: 0.58rem;
    color: var(--ai-dim, #8b919a);
  }

  .bc-axis {
    padding-top: 0;
  }

  .bc-ticks {
    position: relative;
    height: 0.9rem;
  }

  .bc-ticks span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--ai-dim, #8b919a);
  }

  .bc-legend {
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    color: var(--ai-ink, #f8fafc);
  }

  .bc-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .bc-legend svg {
    flex: 0 0 auto;
  }

  .bc-plot {
    display: flex;
    align-items: stretch;
    min-width: 0;
  }

  .bc-y {
    position: relative;
    flex: 0 0 2.35rem;
  }

  .bc-y span {
    position: absolute;
    right: 0.4rem;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: var(--ai-dim, #8b919a);
  }

  .bc-scroll {
    overflow-x: auto;
    flex: 1 1 auto;
    min-width: 0;
  }

  .bc-svg {
    display: block;
    /* The site rule `svg { max-width: 100% }` would shrink this plot to the
       phone width and make the spelled-out names unreadably small. Hold a
       wide plot so the names and marks stay legible, and let the row scroll. */
    width: max(100%, 62rem);
    max-width: none;
    height: auto;
  }

  .bc-svg .bc-grid {
    stroke: rgba(248, 250, 252, 0.16);
  }

  .bc-svg .bc-grid-x {
    stroke: rgba(248, 250, 252, 0.07);
  }

  .bc-svg .bc-grid-base {
    stroke: rgba(248, 250, 252, 0.28);
  }

  .bc-axis-text {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--ai-dim, #8b919a);
  }

  .bc-axis-link {
    cursor: pointer;
  }

  .bc-axis-link .bc-axis-text {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .bc-axis-link:hover .bc-axis-text,
  .bc-axis-link:focus-visible .bc-axis-text {
    fill: var(--ai-ink, #f8fafc);
  }

  .bc-axis-link:focus-visible {
    outline: none;
  }

  .bc-axis-link:focus-visible .bc-axis-text {
    stroke: rgba(248, 250, 252, 0.85);
    stroke-width: 0.4;
  }

  .bc-spark {
    display: block;
    width: 100%;
