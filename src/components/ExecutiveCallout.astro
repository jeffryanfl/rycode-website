---
interface Props {
  title?: string;
}
const { title = "EXECUTIVE BRIEFING" } = Astro.props;
---

<div class="exec-callout-box">
  <div class="exec-callout-header">
    <span class="exec-badge">💡 {title}</span>
  </div>
  <div class="exec-callout-content">
    <slot />
  </div>
</div>

<style>
  .exec-callout-box {
    background: rgba(217, 119, 6, 0.05);
    border: 1px solid rgba(217, 119, 6, 0.25);
    border-left: 4px solid #d97706;
    border-radius: 12px;
    padding: 1.15rem 1.35rem;
    margin: 1.25rem 0;
    backdrop-filter: blur(12px);
  }
  .exec-callout-header {
    margin-bottom: 0.35rem;
  }
  .exec-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: #d97706;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .exec-callout-content {
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.6;
  }
</style>
